textures/** filter=lfs diff=lfs merge=lfs -text
# Except the note saying where they came from, which is text and belongs in the
# repository rather than behind an LFS pointer nobody can read on the web.
textures/*.md !filter !diff !merge text

# Batch files are consumed by cmd.exe, whose parser mishandles LF-only
# parenthesized blocks. Everything else in this repo is LF.
vm/windows/scripts/*.cmd text eol=crlf

# The baked icon rasters are bytes a tool wrote, not text. Git would guess the
# same, but a raw RGBA buffer that happens to start with transparent pixels is
# the sort of file a guess gets wrong, and a line-ending conversion inside one
# is silent until an icon renders as noise.
assets/icon/baked/** binary

# The baked star catalog and its test fixture are records a tool wrote, not
# text. Git's own sniffing gets it right (there is a NUL inside the header),
# but the convention above is what says so, and a line-ending conversion inside
# a packed float would be silent until the sky came out wrong.
crates/sunlit-core/src/assets/stars/*.bin binary
crates/sunlit-core/tests/fixtures/*.bin binary

# The license corpus the third-party notice is baked from. Every one of these
# texts goes into the committed document byte for byte, and a test compares
# them, so a checkout that turned one into CRLF would fail the bake on a
# machine nobody else can reproduce.
assets/licenses/*.txt text eol=lf
