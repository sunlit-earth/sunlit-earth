textures/** filter=lfs diff=lfs merge=lfs -text

# Batch files are consumed by cmd.exe, whose parser mishandles LF-only
# parenthesized blocks. Everything else in this repo is LF.
vm/windows/scripts/*.cmd text eol=crlf

# The baked icon rasters are bytes a tool wrote, not text. Git would guess the
# same, but a raw RGBA buffer that happens to start with transparent pixels is
# the sort of file a guess gets wrong, and a line-ending conversion inside one
# is silent until an icon renders as noise.
assets/icon/baked/** binary
