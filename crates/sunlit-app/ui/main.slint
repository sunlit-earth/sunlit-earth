import { Slider, ComboBox, CheckBox, Button, GroupBox, Palette, ScrollView, TabWidget } from "std-widgets.slint";

// One monitor's place in the layout diagram.
//
// The rectangle is already normalized to the bounding box of every monitor, so
// the diagram multiplies by the board's size and does nothing else; the
// arithmetic that decides it is in `displays.rs`, where it is tested.
export struct MonitorTile {
    label: string,
    x: float,
    y: float,
    width: float,
    height: float,
    anchor: bool,
}

// One block of the attributions document, cut out of the markdown by
// `about::parse_blocks`.
//
// `kind` is 0 for a paragraph, 1 for a heading and 2 for a list item; `depth`
// is a heading's level or a list item's nesting. A heading renders as a plain
// `Text`, since `StyledText` has no font weight or size of its own, and so it
// carries its text in `heading`; every other kind carries inline markdown in
// `body`.
export struct AboutBlock {
    kind: int,
    depth: int,
    heading: string,
    body: styled-text,
}

component Splitter inherits Rectangle {
    callback moved(length);

    width: 4px;
    background: touch.has-hover || touch.pressed ? Palette.accent-background : transparent;

    touch := TouchArea {
        width: 10px;
        x: -3px;
        mouse-cursor: ew-resize;

        moved => {
            root.moved(self.mouse-x - self.pressed-x);
        }
    }
}

// The hover text's own popup.
//
// `Tooltip { text: ... }` would be one line, but the built-in content does not
// wrap and a sentence is wider than any screen, so this is the custom-content
// form. The compiler still wraps it in the built-in `ToolTipImpl`, which is
// where the background and the border come from, and which sizes the popup
// from its children's preferred width. A `Text` reports the width it would
// take unwrapped however narrow the element around it is, so the width here is
// declared as a constraint and not only as a size; the height then follows
// from the wrap at that width.
component Hint inherits Rectangle {
    in property <string> text;

    min-width: 300px;
    max-width: 300px;
    preferred-width: 300px;
    height: body.preferred-height;

    body := VerticalLayout {
        padding-left: 9px;
        padding-right: 9px;
        padding-bottom: 6px;

        Text {
            text: root.text;
            color: Palette.foreground;
            wrap: word-wrap;
        }
    }
}

// One row of the settings panel: a label, a control, and the value it reads.
//
// The root is a Rectangle rather than the layout itself because the hover text
// covers the whole row: a `Tooltip` lowers to a full-size child area, which
// inside a layout would claim a cell of its own.
component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <string> value-text;
    // A sub-row shifts its label right and gives up the same width, so the
    // sliders of a group stay in one column whatever the nesting is.
    in property <length> indent: 0px;
    in property <length> label-width: 88px;
    in property <length> value-width: 45px;
    in property <float> minimum;
    in property <float> maximum;
    in-out property <float> value;
    callback changed();

    min-height: row.min-height;
    preferred-height: row.preferred-height;

    row := HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 4px;
        padding-left: root.indent;

        Text {
            text: root.label;
            vertical-alignment: center;
            min-width: root.label-width - root.indent;
        }
        Slider {
            minimum: root.minimum;
            maximum: root.maximum;
            value <=> root.value;
            changed => { root.changed(); }
        }
        Text {
            text: root.value-text;
            vertical-alignment: center;
            min-width: root.value-width;
        }
    }

    Tooltip {
        Hint { text: root.hint; }
    }
}

// A checkbox row. The checkbox carries its own wording, so there is no label
// column to align it against.
//
// A CheckBox reports the width of that wording as its minimum, which would
// make one long label the floor of the whole sidebar, so it is pinned here.
component SettingCheck inherits Rectangle {
    in property <string> text;
    in property <string> hint;
    in property <length> indent: 0px;
    in-out property <bool> checked;
    callback toggled();

    min-height: row.min-height;
    preferred-height: row.preferred-height;

    row := HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: root.indent;

        CheckBox {
            text: root.text;
            min-width: 0;
            checked <=> root.checked;
            toggled => { root.toggled(); }
        }
    }

    Tooltip {
        Hint { text: root.hint; }
    }
}

// A combo box row, on the same label column as SettingRow.
component SettingCombo inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <length> indent: 0px;
    in property <length> label-width: 88px;
    in property <[string]> model;
    in-out property <int> current-index;
    callback selected();

    min-height: row.min-height;
    preferred-height: row.preferred-height;

    row := HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 4px;
        padding-left: root.indent;

        Text {
            text: root.label;
            vertical-alignment: center;
            min-width: root.label-width - root.indent;
        }
        ComboBox {
            // The fluent ComboBox asks for 160px flat, which would set the
            // sidebar's floor. 140 fits the longest value the fixed models
            // carry, at 93px of text inside 42px of padding, spacing and
            // chevron, with slack for another platform's font. A screen label
            // is longer than that and elides, as it did at 160.
            min-width: 140px;
            model: root.model;
            current-index <=> root.current-index;
            max-height: 24px;
            selected => { root.selected(); }
        }
    }

    Tooltip {
        Hint { text: root.hint; }
    }
}

// The heading above a run of related rows inside a GroupBox.
component SettingHeading inherits Text {
    font-weight: 700;
}

export component MainWindow inherits Window {
    title: "Sunlit Earth " + root.version;
    // The SVG master rather than a baked raster: Slint asks for the icon at 64
    // logical pixels times the scale factor, so a vector source lands exactly
    // on whatever that comes to, and 64 and up is the master's own range.
    icon: @image-url("../../../assets/icon/sunlit-earth.svg");
    preferred-width: 1000px;
    preferred-height: 600px;
    // The panel's floor of 262px, the splitter, and `min-image-width` below it,
    // rounded up. A binding from `panel.min-width` would keep itself honest but
    // runs through the window's own layout; the test guards the arithmetic
    // instead.
    min-width: 520px;

    in property <string> version;
    in property <image> rendered-image;
    in property <string> renderer-info: "Initializing...";
    in property <[string]> aa-options: ["None", "MSAA 4\u{d7}"];
    in-out property <int> aa-index: 1;
    in property <[string]> texture-options: ["Grid", "Day", "Night", "Day/Night Blend"];
    in-out property <int> texture-index: 3;
    in property <[string]> texture-resolution-options: ["8192", "4096", "2048"];
    in-out property <int> texture-resolution-index: 1;
    in property <string> loading-text;

    in-out property <float> camera-longitude: 0;
    in-out property <float> camera-latitude: 30;
    in-out property <float> camera-zoom: 0.421;
    in-out property <float> camera-offset-x: 0;
    in-out property <float> camera-offset-y: 0;
    in-out property <float> camera-tilt: 0;
    in-out property <float> camera-yaw: 0;
    in-out property <float> camera-pitch: 0;
    in-out property <float> camera-fov: 20;
    out property <length> viewport-width: image-container.width;
    out property <length> viewport-height: image-container.height;
    in-out property <float> terminator-width: 0.1;
    in-out property <bool> diffuse-shading: true;
    in-out property <float> diffuse-floor: 0.70;
    in-out property <float> diffuse-ramp: 0.20;
    in-out property <float> spec-shininess: 100;
    in-out property <float> spec-intensity: 0.17;
    in-out property <float> fresnel-mix: 0.75;
    in-out property <float> fresnel-exp: 4.0;
    in-out property <float> day-gamma: 0.5;
    in-out property <float> day-saturation: 1.0;
    in-out property <float> night-gamma: 0.5;
    in-out property <float> night-saturation: 0.85;
    in-out property <float> cloud-opacity: 0.85;
    in-out property <float> cloud-opacity-night: 0.55;
    in-out property <float> cloud-floor: 0.25;
    in-out property <float> cloud-gamma: 0.65;
    in-out property <float> cloud-night: 0.20;
    in-out property <bool> atmo-enabled: true;
    in-out property <float> rayleigh-intensity: 0.5;
    in-out property <float> rayleigh-sharpness: 50.0;
    in-out property <float> rayleigh-haze: 0.55;
    in-out property <float> nightglow-intensity: 0.25;
    in-out property <float> nightglow-balance: 0.37;
    in-out property <float> nightglow-falloff: 15.0;
    in-out property <float> atmo-sunrise-glow: 1.0;
    in-out property <float> atmo-sunrise-width: 20.0;
    in-out property <float> sky-fov: 140.0;
    in-out property <float> star-intensity: 2.0;
    in-out property <float> star-size: 1.0;
    in-out property <float> star-glow-strength: 0.5;
    in-out property <float> star-glow-radius: 8.0;
    in-out property <float> star-contrast: 0.3;
    in-out property <float> star-mag-limit: 6.5;
    in-out property <float> sun-glow: 1.2;
    in-out property <float> sun-rays: 0.75;
    in-out property <float> sun-flare: 0.15;
    in-out property <float> sun-size: 1.0;
    in-out property <float> sun-halo-radius: 3.0;
    in-out property <float> sun-horizon-boost: 3.0;
    in-out property <float> sun-horizon-reach: 4.0;
    in-out property <float> sun-horizon-depth: 1.0;
    in-out property <float> sun-reddening: 1.0;
    in-out property <float> sun-refraction: 1.0;
    in-out property <float> moon-brightness: 1.0;
    in-out property <float> moon-size: 2.5;
    in-out property <float> moon-earthshine: 0.15;
    in-out property <float> milky-way-intensity: 0.2;

    in property <float> zoom-display-distance: 8.0;
    callback sliders-changed();
    callback msaa-changed();
    callback texture-changed();
    callback texture-resolution-changed();
    callback set-wallpaper();
    in-out property <bool> use-custom-datetime: false;
    in-out property <float> custom-hour: 12.0;
    in-out property <float> custom-day-of-year: 1.0;
    in-out property <int> custom-year-index: 10;
    in property <[string]> year-options;
    in property <string> hour-label: "12:00";
    in property <string> day-label: "Jan 1";
    in property <int> max-day-of-year: 365;

    callback mouse-drag-globe(float, float);
    callback mouse-drag-globe-begin();
    callback mouse-drag-frame(float, float);
    callback mouse-drag-orient(float, float);
    callback mouse-drag-tilt(float, float);
    callback mouse-scroll(float);
    callback apply-preset(int);
    callback load-defaults();
    callback reset();
    callback datetime-override-toggled();
    callback show-about();

    in-out property <bool> auto-refresh-enabled: false;
    in-out property <float> auto-refresh-interval: 5.0;
    // The settled change: the schedule is updated and the config is written.
    callback auto-refresh-changed();
    // The interval while the handle is still moving: the schedule follows, the
    // config waits for the release.
    callback auto-refresh-interval-moved();

    // The Displays group. Every model here is filled in from Rust, and an empty
    // `display-tiles` is a session whose monitors could not be enumerated at
    // all, which is macOS and any Windows session where the query failed.
    in property <[string]> display-mode-options;
    in-out property <int> display-mode-index: 1;
    in property <[string]> display-screen-options;
    // Parallel to `display-screen-options`, holding the id each row addresses.
    // The first row is the automatic anchor and its id is empty.
    in property <[string]> display-screen-ids;
    in-out property <int> display-anchor-index: 0;
    in property <[MonitorTile]> display-tiles;
    // Width over height of the whole layout, so the diagram can keep its shape.
    in property <float> display-aspect: 1.0;
    callback display-plan-changed();

    in-out property <bool> advanced-open: false;

    // The widest the panel's content insists on being, and where that content
    // actually starts. The sidebar derives its width from the first of these;
    // both are exposed so a test can hold them to it.
    out property <length> panel-min-width: panel.min-width;
    out property <length> panel-x: panel.x;

    // What the splitter drag stores, and what the window opens at. The
    // sidebar's real width is this held between the panel's own floor and
    // whatever leaves the image its minimum, so no drag and no window size can
    // cut the panel's content off. At 360 the preset grid's widest label gets
    // 107px of button against the 93px it asks for, which leaves room for a
    // platform whose font is wider. The floor is far below that, so a drag can
    // still take the sidebar narrow enough to elide.
    property <length> panel-width: 360px;
    property <length> min-image-width: 240px;
    // The fluent ScrollView draws this on top of the flickable rather than
    // beside it, so the panel reserves it whether or not the bar is showing.
    property <length> scrollbar-width: 14px;

    // Controls panel on the left
    sidebar := Rectangle {
        x: 0;
        y: 0;
        width: max(panel.min-width, min(root.panel-width, root.width - root.min-image-width));
        height: root.height;
        background: Palette.background.darker(0.2);

        VerticalLayout {
            width: 100%;
            height: 100%;

            ScrollView {
                horizontal-scrollbar-policy: as-needed;
                vertical-stretch: 1;

                panel := VerticalLayout {
                    width: 100%;
                    padding: 8px;
                    padding-right: 8px + root.scrollbar-width;
                    spacing: 4px;
                    alignment: start;

                    // --- Top-level actions ---

                    Button {
                        text: "Set as Wallpaper";
                        min-width: 0;
                        clicked => { root.set-wallpaper(); }
                        Tooltip {
                            Hint { text: "Render one frame at the desktop's own resolution and put it on the desktop."; }
                        }
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        Button {
                            text: "Load Defaults";
                            min-width: 0;
                            preferred-width: 0;
                            clicked => { root.load-defaults(); }
                            Tooltip {
                                Hint { text: "Put every setting back to the value the app ships with."; }
                            }
                        }
                        Button {
                            text: "Reset";
                            min-width: 0;
                            preferred-width: 0;
                            clicked => { root.reset(); }
                            Tooltip {
                                Hint { text: "Throw away the changes made since the last save and reload the stored settings."; }
                            }
                        }
                    }

                    // --- Auto-refresh ---

                    SettingCheck {
                        text: "Auto-refresh wallpaper";
                        hint: "Set the wallpaper again on a timer, so the sunlit half of the globe keeps up with the real one.";
                        checked <=> root.auto-refresh-enabled;
                        toggled => { root.auto-refresh-changed(); }
                    }

                    if root.auto-refresh-enabled : HorizontalLayout {
                        spacing: 4px;
                        padding-left: 24px;
                        Slider {
                            minimum: 1;
                            maximum: 30;
                            value <=> root.auto-refresh-interval;
                            changed(value) => { root.auto-refresh-interval-moved(); }
                            released(value) => { root.auto-refresh-changed(); }
                            Tooltip {
                                Hint { text: "How long between one wallpaper render and the next."; }
                            }
                        }
                        Text {
                            text: "every " + round(root.auto-refresh-interval) + " min";
                            vertical-alignment: center;
                        }
                    }

                    // --- 3x3 preset grid ---

                    Rectangle { height: 8px; }

                    Text {
                        text: "Presets";
                        font-weight: 700;
                        horizontal-alignment: center;
                    }

                    GridLayout {
                        spacing: 4px;
                        Row {
                            Button {
                                text: "Africa";
                                min-width: 0;
                                preferred-width: 0;
                                clicked => { root.apply-preset(3); }
                            }
                            Button {
                                text: "N. America";
                                min-width: 0;
                                preferred-width: 0;
                                clicked => { root.apply-preset(1); }
                            }
                            Button {
                                text: "S. America";
                                min-width: 0;
                                preferred-width: 0;
                                clicked => { root.apply-preset(2); }
                            }
                        }
                        Row {
                            Button {
                                text: "Asia";
                                min-width: 0;
                                preferred-width: 0;
                                clicked => { root.apply-preset(4); }
                            }
                            Button {
                                text: "Europe";
                                min-width: 0;
                                preferred-width: 0;
                                clicked => { root.apply-preset(0); }
                            }
                            Button {
                                text: "Oceania";
                                min-width: 0;
                                preferred-width: 0;
                                clicked => { root.apply-preset(5); }
                            }
                        }
                        Row {
                            Button {
                                text: "Pacific";
                                min-width: 0;
                                preferred-width: 0;
                                clicked => { root.apply-preset(6); }
                            }
                            Button {
                                text: "Blue Marble";
                                min-width: 0;
                                preferred-width: 0;
                                clicked => { root.apply-preset(7); }
                            }
                            Button {
                                text: "Earthrise";
                                min-width: 0;
                                preferred-width: 0;
                                clicked => { root.apply-preset(8); }
                            }
                        }
                    }

                    // --- Displays ---
                    //
                    // Hidden on a session with one screen, where three modes all
                    // mean the same thing. The setting still persists, so unplugging
                    // a second screen and plugging it back in does not lose it.

                    if root.display-tiles.length > 1 : VerticalLayout {
                        spacing: 4px;

                        Rectangle { height: 8px; }

                        Text {
                            text: "Displays";
                            font-weight: 700;
                            horizontal-alignment: center;
                        }

                        display-mode-combo := SettingCombo {
                            label: "Mode";
                            hint: "How the screens relate. One screen: only the screen below gets a wallpaper and the rest keep theirs. Mirror: every screen gets the same view, rendered at its own size and shape. Extend: one continuous view is spread across all of them.";
                            label-width: 52px;
                            model: root.display-mode-options;
                            current-index <=> root.display-mode-index;
                            selected => { root.display-plan-changed(); }
                        }

                        display-screen-combo := SettingCombo {
                            label: "Screen";
                            hint: "Which screen gets the picture in one-screen mode, and which screen the view is centered on in the other two.";
                            label-width: 52px;
                            model: root.display-screen-options;
                            current-index <=> root.display-anchor-index;
                            selected => { root.display-plan-changed(); }
                        }

                        Rectangle {
                            height: 88px;
                            background: Palette.background.darker(0.15);
                            border-radius: 4px;

                            board := Rectangle {
                                width: min(parent.width - 12px, (parent.height - 12px) * root.display-aspect);
                                height: self.width / root.display-aspect;

                                for tile in root.display-tiles : Rectangle {
                                    x: board.width * tile.x;
                                    y: board.height * tile.y;
                                    width: board.width * tile.width;
                                    height: board.height * tile.height;
                                    background: tile.anchor ? Palette.accent-background : Palette.background;
                                    border-width: 1px;
                                    border-color: Palette.background.darker(0.4);
                                    border-radius: 2px;

                                    Text {
                                        text: tile.label;
                                        font-size: 10px;
                                        color: tile.anchor ? Palette.accent-foreground : Palette.foreground;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }
                                }
                            }
                        }
                    }

                    // --- Advanced toggle ---

                    Rectangle { height: 8px; }

                    TouchArea {
                        height: 24px;
                        clicked => { root.advanced-open = !root.advanced-open; }

                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: root.advanced-open ? "\u{25bc}" : "\u{25b6}";
                                vertical-alignment: center;
                                font-size: 11px;
                            }
                            Text {
                                text: "Advanced";
                                vertical-alignment: center;
                                font-weight: 700;
                            }
                        }
                    }

                    // --- Collapsible advanced section ---

                    if root.advanced-open :
                    VerticalLayout {
                        spacing: 4px;

                        GroupBox {
                            title: "Rendering";
                            VerticalLayout {
                                spacing: 4px;

                                SettingCombo {
                                    label: "Texture";
                                    hint: "Which map the globe is drawn from: the procedural grid, one of the two surface maps alone, or the day/night blend.";
                                    model: texture-options;
                                    current-index <=> root.texture-index;
                                    selected => { root.texture-changed(); }
                                }

                                SettingCombo {
                                    label: "Resolution";
                                    hint: "Width the surface maps are loaded at. Lower costs less memory and takes effect without a restart.";
                                    model: texture-resolution-options;
                                    current-index <=> root.texture-resolution-index;
                                    selected => { root.texture-resolution-changed(); }
                                }

                                SettingCombo {
                                    label: "Anti-aliasing";
                                    hint: "How many samples each pixel is rendered from, which is what smooths the globe's edge and the star sprites.";
                                    model: aa-options;
                                    current-index <=> root.aa-index;
                                    selected => { root.msaa-changed(); }
                                }

                                // One line, whatever the adapter calls itself,
                                // with the whole name on hover. Wrapping this
                                // would read better, but a wrapped Text inside
                                // an `if` reports the height of one line
                                // however many it takes, and a scroll area
                                // sized from that cuts the rest off.
                                adapter-line := Text {
                                    text: renderer-info;
                                    color: #888888;
                                    font-size: 11px;
                                    overflow: elide;
                                    min-width: 0;

                                    Tooltip {
                                        Hint { text: root.renderer-info; }
                                    }
                                }
                            }
                        }

                        GroupBox {
                            title: "Camera Position";
                            VerticalLayout {
                                spacing: 4px;

                                longitude-slider := SettingRow {
                                    label: "Longitude";
                                    hint: "The meridian the camera hangs above, which is what turns the globe left and right.";
                                    minimum: -180;
                                    maximum: 180;
                                    value <=> root.camera-longitude;
                                    value-text: round(root.camera-longitude) + "°";
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }

                                latitude-slider := SettingRow {
                                    label: "Latitude";
                                    hint: "How far north or south of the equator the camera hangs, from one pole to the other.";
                                    minimum: -89;
                                    maximum: 89;
                                    value <=> root.camera-latitude;
                                    value-text: round(root.camera-latitude) + "°";
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }

                                zoom-slider := SettingRow {
                                    label: "Zoom";
                                    hint: "Distance from the Earth's centre in Earth radii, mapped exponentially so both ends of the slider stay useful.";
                                    minimum: 0.0;
                                    maximum: 1.0;
                                    value <=> root.camera-zoom;
                                    value-text: round(root.zoom-display-distance * 10) / 10;
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }
                            }
                        }

                        GroupBox {
                            title: "Camera Orientation";
                            VerticalLayout {
                                spacing: 4px;

                                tilt-slider := SettingRow {
                                    label: "Tilt";
                                    hint: "Rolls the whole frame around the view axis, tipping the poles away from vertical.";
                                    minimum: -180;
                                    maximum: 180;
                                    value <=> root.camera-tilt;
                                    value-text: round(root.camera-tilt) + "°";
                                    value-width: 35px;
                                    changed => {
                                        if root.camera-tilt > -5 && root.camera-tilt < 5 {
                                            root.camera-tilt = 0;
                                        }
                                        root.sliders-changed();
                                    }
                                }

                                yaw-slider := SettingRow {
                                    label: "Yaw";
                                    hint: "Swings the aim point sideways across the globe, so the camera looks off-centre rather than at the middle.";
                                    minimum: -90;
                                    maximum: 90;
                                    value <=> root.camera-yaw;
                                    value-text: round(root.camera-yaw) + "°";
                                    value-width: 35px;
                                    changed => {
                                        if root.camera-yaw > -3 && root.camera-yaw < 3 {
                                            root.camera-yaw = 0;
                                        }
                                        root.sliders-changed();
                                    }
                                }

                                pitch-slider := SettingRow {
                                    label: "Pitch";
                                    hint: "Swings the aim point up or down across the globe, which is what puts the horizon low in the frame.";
                                    minimum: -90;
                                    maximum: 90;
                                    value <=> root.camera-pitch;
                                    value-text: round(root.camera-pitch) + "°";
                                    value-width: 35px;
                                    changed => {
                                        if root.camera-pitch > -3 && root.camera-pitch < 3 {
                                            root.camera-pitch = 0;
                                        }
                                        root.sliders-changed();
                                    }
                                }
                            }
                        }

                        GroupBox {
                            title: "Framing";
                            VerticalLayout {
                                spacing: 4px;

                                camera-fov-slider := SettingRow {
                                    label: "Field of view";
                                    hint: "How wide the Earth lens is: narrow flattens the globe the way a long lens does, wide exaggerates its curvature. The sky behind it has a lens of its own.";
                                    minimum: 10.0;
                                    maximum: 170.0;
                                    value <=> root.camera-fov;
                                    value-text: round(root.camera-fov) + "°";
                                    changed => { root.sliders-changed(); }
                                }

                                offset-x-slider := SettingRow {
                                    label: "Offset X";
                                    hint: "Slides the finished frame left or right without moving the camera.";
                                    minimum: -3.0;
                                    maximum: 3.0;
                                    value <=> root.camera-offset-x;
                                    value-text: round(root.camera-offset-x * 100) / 100;
                                    value-width: 35px;
                                    changed => {
                                        if root.camera-offset-x > -0.05 && root.camera-offset-x < 0.05 {
                                            root.camera-offset-x = 0;
                                        }
                                        root.sliders-changed();
                                    }
                                }

                                offset-y-slider := SettingRow {
                                    label: "Offset Y";
                                    hint: "Slides the finished frame up or down without moving the camera.";
                                    minimum: -3.0;
                                    maximum: 3.0;
                                    value <=> root.camera-offset-y;
                                    value-text: round(root.camera-offset-y * 100) / 100;
                                    value-width: 35px;
                                    changed => {
                                        if root.camera-offset-y > -0.05 && root.camera-offset-y < 0.05 {
                                            root.camera-offset-y = 0;
                                        }
                                        root.sliders-changed();
                                    }
                                }
                            }
                        }

                        GroupBox {
                            title: "Date / Time";
                            VerticalLayout {
                                spacing: 4px;

                                SettingCheck {
                                    text: "Override date/time";
                                    hint: "Render a chosen instant instead of the passing one, which freezes the Sun, the Moon and the stars where they were.";
                                    checked <=> root.use-custom-datetime;
                                    toggled => { root.datetime-override-toggled(); }
                                }

                                if root.use-custom-datetime :
                                VerticalLayout {
                                    spacing: 4px;

                                    custom-hour-slider := SettingRow {
                                        label: "Hour";
                                        hint: "Time of day in UTC, which is what decides the longitude the Sun stands over.";
                                        indent: 8px;
                                        minimum: 0.0;
                                        maximum: 23.99;
                                        value <=> root.custom-hour;
                                        value-text: root.hour-label;
                                        changed => { root.sliders-changed(); }
                                    }

                                    custom-day-slider := SettingRow {
                                        label: "Day";
                                        hint: "Day of the year, which is what decides the Sun's declination and so the season the terminator shows.";
                                        indent: 8px;
                                        minimum: 1.0;
                                        maximum: root.max-day-of-year;
                                        value <=> root.custom-day-of-year;
                                        value-text: root.day-label;
                                        changed => { root.sliders-changed(); }
                                    }

                                    SettingCombo {
                                        label: "Year";
                                        hint: "Which year that day belongs to. The Sun barely notices; the Moon and the planets do.";
                                        indent: 8px;
                                        model: root.year-options;
                                        current-index <=> root.custom-year-index;
                                        selected => { root.sliders-changed(); }
                                    }
                                }
                            }
                        }

                        GroupBox {
                            title: "Clouds";
                            VerticalLayout {
                                spacing: 4px;

                                cloud-opacity-slider := SettingRow {
                                    label: "Day opacity";
                                    hint: "How strongly the cloud layer covers the sunlit surface underneath it.";
                                    minimum: 0.0;
                                    maximum: 1.0;
                                    value <=> root.cloud-opacity;
                                    value-text: round(root.cloud-opacity * 100) + "%";
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }

                                cloud-opacity-night-slider := SettingRow {
                                    label: "Night opacity";
                                    hint: "How strongly the cloud layer covers the night surface, where the city lights under it are far brighter than the cloud itself. At the top of the range nothing shines through.";
                                    minimum: 0.0;
                                    maximum: 1.0;
                                    value <=> root.cloud-opacity-night;
                                    value-text: round(root.cloud-opacity-night * 100) + "%";
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }

                                cloud-floor-slider := SettingRow {
                                    label: "Floor";
                                    hint: "Brightness below which a cloud pixel counts as clear sky, which is what trims the haze out of the source image.";
                                    minimum: 0.0;
                                    maximum: 0.5;
                                    value <=> root.cloud-floor;
                                    value-text: round(root.cloud-floor * 100) + "%";
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }

                                cloud-gamma-slider := SettingRow {
                                    label: "Gamma";
                                    hint: "Contrast curve of the cloud layer: below one lifts the thin cloud, above one keeps only the dense tops.";
                                    minimum: 0.1;
                                    maximum: 2.0;
                                    value <=> root.cloud-gamma;
                                    value-text: round(root.cloud-gamma * 100) / 100;
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }

                                cloud-night-slider := SettingRow {
                                    label: "Night brightness";
                                    hint: "How bright a cloud is on the night hemisphere, where the real light is far too faint to draw at this exposure.";
                                    minimum: 0.0;
                                    maximum: 0.6;
                                    value <=> root.cloud-night;
                                    value-text: round(root.cloud-night * 100) + "%";
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }

                            }
                        }

                        GroupBox {
                            title: "Celestial";
                            VerticalLayout {
                                spacing: 4px;

                                SettingHeading { text: "Sky"; }

                                sky-fov-slider := SettingRow {
                                    label: "Field of view";
                                    hint: "How much sky the background lens covers, which is what sets the scale of the constellations and the Milky Way.";
                                    indent: 8px;
                                    minimum: 60.0;
                                    maximum: 180.0;
                                    value <=> root.sky-fov;
                                    value-text: round(root.sky-fov) + "°";
                                    changed => { root.sliders-changed(); }
                                }

                                milky-way-intensity-slider := SettingRow {
                                    label: "Milky Way";
                                    hint: "Brightness of the diffuse galactic band behind the stars. Zero leaves it out of the frame.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 2.0;
                                    value <=> root.milky-way-intensity;
                                    value-text: round(root.milky-way-intensity * 100) / 100 + "×";
                                    changed => { root.sliders-changed(); }
                                }

                                SettingHeading { text: "Sun"; }

                                sun-glow-slider := SettingRow {
                                    label: "Glare";
                                    hint: "Master strength of the Sun's glare, and the switch for the Sun itself: at zero neither the disk nor the glare is drawn.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 3.0;
                                    value <=> root.sun-glow;
                                    value-text: round(root.sun-glow * 100) / 100 + "×";
                                    changed => { root.sliders-changed(); }
                                }

                                sun-rays-slider := SettingRow {
                                    label: "Rays";
                                    hint: "Strength of the fine radial needles the eye itself adds around a bright source.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 2.0;
                                    value <=> root.sun-rays;
                                    value-text: round(root.sun-rays * 100) + "%";
                                    changed => { root.sliders-changed(); }
                                }

                                sun-size-slider := SettingRow {
                                    label: "Size";
                                    hint: "Multiplies the Sun's radius above its true half degree, the way the Moon's does. The glare's inner lobe grows with it and the rest of it does not.";
                                    indent: 8px;
                                    minimum: 1.0;
                                    maximum: 8.0;
                                    value <=> root.sun-size;
                                    value-text: round(root.sun-size * 10) / 10 + "×";
                                    changed => { root.sliders-changed(); }
                                }

                                sun-halo-radius-slider := SettingRow {
                                    label: "Halo radius";
                                    hint: "Angular radius of the faint colored ring around the glare.";
                                    indent: 8px;
                                    minimum: 1.5;
                                    maximum: 8.0;
                                    value <=> root.sun-halo-radius;
                                    value-text: round(root.sun-halo-radius * 10) / 10 + "°";
                                    changed => { root.sliders-changed(); }
                                }

                                sun-flare-slider := SettingRow {
                                    label: "Lens flare";
                                    hint: "Aperture spikes and lens ghosts, which belong to a camera rather than to an eye.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 1.0;
                                    value <=> root.sun-flare;
                                    value-text: round(root.sun-flare * 100) + "%";
                                    changed => { root.sliders-changed(); }
                                }

                                sun-horizon-boost-slider := SettingRow {
                                    label: "Sunrise glare";
                                    hint: "How much brighter the glare peaks as the disk clears the horizon, before the eye adjusts. One is the physical answer.";
                                    indent: 8px;
                                    minimum: 1.0;
                                    maximum: 8.0;
                                    value <=> root.sun-horizon-boost;
                                    value-text: round(root.sun-horizon-boost * 10) / 10 + "×";
                                    changed => { root.sliders-changed(); }
                                }

                                sun-horizon-reach-slider := SettingRow {
                                    label: "Adaptation";
                                    hint: "How far above the horizon, in horizon depths, the eye takes to settle back to normal.";
                                    indent: 8px;
                                    minimum: 0.5;
                                    maximum: 10.0;
                                    value <=> root.sun-horizon-reach;
                                    value-text: round(root.sun-horizon-reach * 10) / 10;
                                    changed => { root.sliders-changed(); }
                                }

                                sun-horizon-depth-slider := SettingRow {
                                    label: "Horizon depth";
                                    hint: "Thickness of the horizon zone in Sun diameters. Zero uses the painted atmosphere alone.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 4.0;
                                    value <=> root.sun-horizon-depth;
                                    value-text: round(root.sun-horizon-depth * 10) / 10;
                                    changed => { root.sliders-changed(); }
                                }

                                sun-reddening-slider := SettingRow {
                                    label: "Reddening";
                                    hint: "How much the low atmosphere colors the disk and the glare. One is the measured atmosphere. The warm band it spreads along the limb is the Atmosphere group's Sunrise band.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 2.0;
                                    value <=> root.sun-reddening;
                                    value-text: round(root.sun-reddening * 100) + "%";
                                    changed => { root.sliders-changed(); }
                                }

                                sun-refraction-slider := SettingRow {
                                    label: "Refraction";
                                    hint: "Lifts and flattens the disk at the horizon the way the atmosphere bends its light.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 2.0;
                                    value <=> root.sun-refraction;
                                    value-text: round(root.sun-refraction * 100) + "%";
                                    changed => { root.sliders-changed(); }
                                }

                                SettingHeading { text: "Moon"; }

                                moon-brightness-slider := SettingRow {
                                    label: "Brightness";
                                    hint: "Brightness of the Moon's sunlit face, and the switch for the Moon itself: zero draws nothing.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 3.0;
                                    value <=> root.moon-brightness;
                                    value-text: round(root.moon-brightness * 100) / 100 + "×";
                                    changed => { root.sliders-changed(); }
                                }

                                moon-size-slider := SettingRow {
                                    label: "Size";
                                    hint: "Multiplies the Moon's radius above its true half degree. A narrower sky field of view magnifies it honestly instead.";
                                    indent: 8px;
                                    minimum: 1.0;
                                    maximum: 8.0;
                                    value <=> root.moon-size;
                                    value-text: round(root.moon-size * 10) / 10 + "×";
                                    changed => { root.sliders-changed(); }
                                }

                                moon-earthshine-slider := SettingRow {
                                    label: "Earthshine";
                                    hint: "Floor under the Moon's unlit face, so a new moon does not disappear altogether.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 0.5;
                                    value <=> root.moon-earthshine;
                                    value-text: round(root.moon-earthshine * 100) + "%";
                                    changed => { root.sliders-changed(); }
                                }

                                SettingHeading { text: "Stars"; }

                                star-intensity-slider := SettingRow {
                                    label: "Brightness";
                                    hint: "Display gain for the stars and the naked-eye planets, and the switch for both: zero leaves the sky empty.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 5.0;
                                    value <=> root.star-intensity;
                                    value-text: round(root.star-intensity * 100) / 100 + "×";
                                    changed => { root.sliders-changed(); }
                                }

                                star-size-slider := SettingRow {
                                    label: "Size";
                                    hint: "Multiplies the compact core of each star, leaving its halo to the two glow sliders.";
                                    indent: 8px;
                                    minimum: 0.5;
                                    maximum: 3.0;
                                    value <=> root.star-size;
                                    value-text: round(root.star-size * 100) / 100 + "×";
                                    changed => { root.sliders-changed(); }
                                }

                                star-glow-strength-slider := SettingRow {
                                    label: "Glow strength";
                                    hint: "How pronounced the soft halo around the brighter stars is.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 3.0;
                                    value <=> root.star-glow-strength;
                                    value-text: round(root.star-glow-strength * 100) + "%";
                                    changed => { root.sliders-changed(); }
                                }

                                star-glow-radius-slider := SettingRow {
                                    label: "Glow radius";
                                    hint: "How far that halo reaches, in pixels at 1080p; a larger frame scales it up on its own.";
                                    indent: 8px;
                                    minimum: 1.0;
                                    maximum: 30.0;
                                    value <=> root.star-glow-radius;
                                    value-text: round(root.star-glow-radius * 10) / 10 + " px";
                                    changed => { root.sliders-changed(); }
                                }

                                star-contrast-slider := SettingRow {
                                    label: "Contrast";
                                    hint: "Separation between bright and faint stars; below zero they even out, above zero the bright ones pull away.";
                                    indent: 8px;
                                    minimum: -1.0;
                                    maximum: 1.0;
                                    value <=> root.star-contrast;
                                    value-text: round(root.star-contrast * 100) + "%";
                                    changed => { root.sliders-changed(); }
                                }

                                star-mag-limit-slider := SettingRow {
                                    label: "Faintest";
                                    hint: "Dimmest apparent magnitude still drawn. The naked eye reaches about 6 under a dark sky, and the catalog stops at 7.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 7.0;
                                    value <=> root.star-mag-limit;
                                    value-text: round(root.star-mag-limit * 10) / 10;
                                    changed => { root.sliders-changed(); }
                                }
                            }
                        }

                        GroupBox {
                            title: "Atmosphere";
                            VerticalLayout {
                                spacing: 4px;

                                SettingCheck {
                                    text: "Atmosphere glow";
                                    hint: "Master switch for the three glowing shells around the globe.";
                                    checked <=> root.atmo-enabled;
                                    toggled => { root.sliders-changed(); }
                                }

                                if root.atmo-enabled :
                                VerticalLayout {
                                    spacing: 4px;

                                    SettingHeading { text: "Rayleigh"; }

                                    rayleigh-intensity-slider := SettingRow {
                                        label: "Intensity";
                                        hint: "Strength of the blue scattering halo that rings the daylit limb.";
                                        indent: 8px;
                                        minimum: 0.0;
                                        maximum: 1.0;
                                        value <=> root.rayleigh-intensity;
                                        value-text: round(root.rayleigh-intensity * 100) + "%";
                                        value-width: 35px;
                                        changed => { root.sliders-changed(); }
                                    }

                                    rayleigh-sharpness-slider := SettingRow {
                                        label: "Sharpness";
                                        hint: "How tightly that halo hugs the limb; higher leaves a thinner, harder band.";
                                        indent: 8px;
                                        minimum: 10.0;
                                        maximum: 100.0;
                                        value <=> root.rayleigh-sharpness;
                                        value-text: round(root.rayleigh-sharpness * 10) / 10;
                                        value-width: 35px;
                                        changed => { root.sliders-changed(); }
                                    }

                                    rayleigh-haze-slider := SettingRow {
                                        label: "Haze";
                                        hint: "How far the scattering bleeds inward over the disc itself rather than sitting on its edge.";
                                        indent: 8px;
                                        minimum: 0.0;
                                        maximum: 1.0;
                                        value <=> root.rayleigh-haze;
                                        value-text: round(root.rayleigh-haze * 100) + "%";
                                        value-width: 35px;
                                        changed => { root.sliders-changed(); }
                                    }

                                    SettingHeading { text: "Sunrise band"; }

                                    atmo-sunrise-glow-slider := SettingRow {
                                        label: "Brightness";
                                        hint: "Brightness of the warm band the atmosphere takes around a rising or setting Sun.";
                                        indent: 8px;
                                        minimum: 0.0;
                                        maximum: 3.0;
                                        value <=> root.atmo-sunrise-glow;
                                        value-text: round(root.atmo-sunrise-glow * 100) / 100 + "×";
                                        value-width: 35px;
                                        changed => { root.sliders-changed(); }
                                    }

                                    atmo-sunrise-width-slider := SettingRow {
                                        label: "Band width";
                                        hint: "How far along the horizon that band reaches from the Sun.";
                                        indent: 8px;
                                        minimum: 10.0;
                                        maximum: 90.0;
                                        value <=> root.atmo-sunrise-width;
                                        value-text: round(root.atmo-sunrise-width) + "°";
                                        value-width: 35px;
                                        changed => { root.sliders-changed(); }
                                    }

                                    SettingHeading { text: "Nightglow"; }

                                    nightglow-intensity-slider := SettingRow {
                                        label: "Intensity";
                                        hint: "Strength of the faint airglow that traces the night limb.";
                                        indent: 8px;
                                        minimum: 0.0;
                                        maximum: 1.0;
                                        value <=> root.nightglow-intensity;
                                        value-text: round(root.nightglow-intensity * 100) + "%";
                                        value-width: 35px;
                                        changed => { root.sliders-changed(); }
                                    }

                                    nightglow-balance-slider := SettingRow {
                                        label: "Balance";
                                        hint: "Mix between the orange sodium band and the green oxygen band of that airglow.";
                                        indent: 8px;
                                        minimum: 0.0;
                                        maximum: 1.0;
                                        value <=> root.nightglow-balance;
                                        value-text: root.nightglow-balance <= 0.01 ? "orange" :
                                                    root.nightglow-balance >= 0.99 ? "green" :
                                                    round(root.nightglow-balance * 100) / 100;
                                        value-width: 35px;
                                        changed => { root.sliders-changed(); }
                                    }

                                    nightglow-falloff-slider := SettingRow {
                                        label: "Falloff";
                                        hint: "How quickly the airglow fades with distance from the limb.";
                                        indent: 8px;
                                        minimum: 2.0;
                                        maximum: 50.0;
                                        value <=> root.nightglow-falloff;
                                        value-text: round(root.nightglow-falloff * 10) / 10;
                                        value-width: 35px;
                                        changed => { root.sliders-changed(); }
                                    }
                                }
                            }
                        }

                        GroupBox {
                            title: "Lighting";
                            VerticalLayout {
                                spacing: 4px;

                                terminator-slider := SettingRow {
                                    label: "Terminator";
                                    hint: "Width of the blend between the day and night maps across the day/night boundary.";
                                    minimum: 0.01;
                                    maximum: 0.3;
                                    value <=> root.terminator-width;
                                    value-text: round(root.terminator-width * 1000) / 1000;
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }

                                SettingCheck {
                                    text: "Dayside shading";
                                    hint: "Shade the daylit half by the Sun's angle instead of laying the map on flat.";
                                    checked <=> root.diffuse-shading;
                                    toggled => { root.sliders-changed(); }
                                }

                                diffuse-floor-slider := SettingRow {
                                    label: "Floor";
                                    hint: "How bright the dimmest shaded daylight still is, so the approach to the terminator does not go black.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 1.0;
                                    value <=> root.diffuse-floor;
                                    value-text: round(root.diffuse-floor * 100) / 100;
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }

                                diffuse-ramp-slider := SettingRow {
                                    label: "Ramp";
                                    hint: "How quickly that shading falls off as the surface turns away from the Sun.";
                                    indent: 8px;
                                    minimum: 0.1;
                                    maximum: 1.0;
                                    value <=> root.diffuse-ramp;
                                    value-text: round(root.diffuse-ramp * 100) / 100;
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }

                                spec-shininess-slider := SettingRow {
                                    label: "Shininess";
                                    hint: "Tightness of the specular highlight the Sun leaves on the oceans; higher makes a smaller, harder glint.";
                                    minimum: 10;
                                    maximum: 500;
                                    value <=> root.spec-shininess;
                                    value-text: round(root.spec-shininess);
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }

                                spec-intensity-slider := SettingRow {
                                    label: "Glint";
                                    hint: "Strength of that specular highlight.";
                                    minimum: 0.0;
                                    maximum: 1.0;
                                    value <=> root.spec-intensity;
                                    value-text: round(root.spec-intensity * 100) / 100;
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }

                                fresnel-mix-slider := SettingRow {
                                    label: "Fresnel mix";
                                    hint: "How much the ocean brightens where it turns away from the camera, the way water does at a glancing angle.";
                                    minimum: 0.0;
                                    maximum: 1.0;
                                    value <=> root.fresnel-mix;
                                    value-text: round(root.fresnel-mix * 100) / 100;
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }

                                fresnel-exp-slider := SettingRow {
                                    label: "Fresnel extent";
                                    hint: "How far in from the limb that glancing-angle brightening reaches.";
                                    minimum: 1.0;
                                    maximum: 8.0;
                                    value <=> root.fresnel-exp;
                                    value-text: round(root.fresnel-exp * 10) / 10;
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }
                            }
                        }

                        GroupBox {
                            title: "Color Correction";
                            VerticalLayout {
                                spacing: 4px;

                                SettingHeading { text: "Day Texture"; }

                                day-gamma-slider := SettingRow {
                                    label: "Gamma";
                                    hint: "Brightness curve of the daylit surface map; below one lifts the shadows, above one deepens them.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 1.0;
                                    value <=> root.day-gamma;
                                    value-text: round((root.day-gamma <= 0.5 ? 0.2 + 1.6 * root.day-gamma : 1.0 + 4.0 * (root.day-gamma - 0.5)) * 100) / 100;
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }

                                day-saturation-slider := SettingRow {
                                    label: "Saturation";
                                    hint: "Colour intensity of the daylit surface map; zero is greyscale.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 2.0;
                                    value <=> root.day-saturation;
                                    value-text: round(root.day-saturation * 100) / 100;
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }

                                SettingHeading { text: "Night Texture"; }

                                night-gamma-slider := SettingRow {
                                    label: "Gamma";
                                    hint: "Brightness curve of the city-lights map; below one brings out the sparse lights, above one keeps only the cities.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 1.0;
                                    value <=> root.night-gamma;
                                    value-text: round((root.night-gamma <= 0.5 ? 0.2 + 1.6 * root.night-gamma : 1.0 + 4.0 * (root.night-gamma - 0.5)) * 100) / 100;
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }

                                night-saturation-slider := SettingRow {
                                    label: "Saturation";
                                    hint: "Colour intensity of the city-lights map; zero is greyscale.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 2.0;
                                    value <=> root.night-saturation;
                                    value-text: round(root.night-saturation * 100) / 100;
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }
                            }
                        }

                    }
                }
            }

            HorizontalLayout {
                padding: 8px;
                vertical-stretch: 0;

                about-button := Button {
                    text: "About";
                    min-width: 0;
                    clicked => { root.show-about(); }
                    Tooltip {
                        Hint { text: "The version this is, and who the maps, the star catalog and the astronomy come from."; }
                    }
                }
            }
        }
    }

    splitter := Splitter {
        x: sidebar.width;
        height: 100%;

        moved(delta) => {
            root.panel-width = max(panel.min-width, min(root.panel-width + delta, root.width - root.min-image-width));
        }
    }

    // Image fills the area right of the splitter
    image-container := Rectangle {
        x: splitter.x + splitter.width;
        y: 0;
        width: root.width - self.x;
        height: root.height;
        background: black;

        Image {
            source: rendered-image;
            width: parent.width;
            height: parent.height;
            image-fit: contain;
        }

        property <length> last-mouse-x;
        property <length> last-mouse-y;
        property <bool> left-held: false;
        property <bool> right-held: false;
        property <bool> middle-held: false;

        viewport-touch := TouchArea {
            width: parent.width;
            height: parent.height;

            pointer-event(event) => {
                if event.button == PointerEventButton.left {
                    image-container.left-held = event.kind == PointerEventKind.down;
                    if event.kind == PointerEventKind.down {
                        root.mouse-drag-globe-begin();
                    }
                }
                if event.button == PointerEventButton.right {
                    image-container.right-held = event.kind == PointerEventKind.down;
                }
                if event.button == PointerEventButton.middle {
                    image-container.middle-held = event.kind == PointerEventKind.down;
                }
                if event.kind == PointerEventKind.down || event.kind == PointerEventKind.up {
                    image-container.last-mouse-x = self.mouse-x;
                    image-container.last-mouse-y = self.mouse-y;
                }
            }

            moved => {
                if image-container.left-held && image-container.right-held {
                    root.mouse-drag-tilt(
                        (self.mouse-x - image-container.last-mouse-x) / 1px,
                        (self.mouse-y - image-container.last-mouse-y) / 1px
                    );
                } else if image-container.left-held {
                    root.mouse-drag-globe(
                        (self.mouse-x - image-container.last-mouse-x) / 1px,
                        (self.mouse-y - image-container.last-mouse-y) / 1px
                    );
                } else if image-container.right-held {
                    root.mouse-drag-frame(
                        (self.mouse-x - image-container.last-mouse-x) / 1px,
                        (self.mouse-y - image-container.last-mouse-y) / 1px
                    );
                } else if image-container.middle-held {
                    root.mouse-drag-orient(
                        (self.mouse-x - image-container.last-mouse-x) / 1px,
                        (self.mouse-y - image-container.last-mouse-y) / 1px
                    );
                }
                image-container.last-mouse-x = self.mouse-x;
                image-container.last-mouse-y = self.mouse-y;
            }

            scroll-event(event) => {
                root.mouse-scroll(event.delta-y / 1px);
                return accept;
            }
        }

        if loading-text != "" : Rectangle {
            x: parent.width - loading-label.width - 16px;
            y: parent.height - loading-label.height - 12px;
            width: loading-label.width + 16px;
            height: loading-label.height + 8px;
            border-radius: 4px;
            background: #000000aa;

            loading-label := Text {
                x: 8px;
                y: 4px;
                text: loading-text;
                color: #cccccc;
                font-size: 12px;
            }
        }
    }
}

export component AboutWindow inherits Window {
    title: "About Sunlit Earth";
    // The same SVG master the settings window takes, for the same reason:
    // Slint rasterizes at whatever size the surface asks for, and here the
    // header mark is one of those surfaces.
    icon: @image-url("../../../assets/icon/sunlit-earth.svg");
    preferred-width: 580px;
    preferred-height: 520px;
    min-width: 360px;
    min-height: 300px;

    in property <string> version;
    // A model rather than one `styled-text`: the tab lays the document
    // out block by block. `about::document_model` builds it.
    in property <[AboutBlock]> attributions;
    in property <[AboutBlock]> third-party;
    // Plain text rather than markdown: the GPLv3 is hard-wrapped at 76
    // columns with indentation that carries meaning, and every markdown path
    // through Slint reflows it.
    in property <string> license-text;
    // Fed from Rust, because `font-family` takes one real family name and
    // Slint resolves no generic: "monospace" lands on the proportional
    // default with no error. `about::MONO_FAMILY` picks the platform's.
    in property <string> mono-family;

    // Opened through the platform's own handler in `about.rs`. Every tab and
    // the header link go through this one callback.
    callback open-url(url: string);

    out property <length> version-y: version-line.absolute-position.y;

    property <string> repository: "https://github.com/klamann/sunlit-earth";
    // The fluent ScrollView draws its bar over the flickable rather than
    // beside it, so a tab reserves the width whether the bar is showing.
    property <length> scrollbar-width: 14px;
    // The attributions tab's two indents: what one level of nesting moves a
    // list item by, and the column its bullet hangs in.
    property <length> nesting-step: 14px;
    property <length> bullet-column: 11px;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Fixed: the version, the copyright and the repository stay on screen
        // at any window size, and only the tab below scrolls.
        HorizontalLayout {
            spacing: 16px;
            vertical-stretch: 0;

            Image {
                source: @image-url("../../../assets/icon/sunlit-earth.svg");
                width: 72px;
                height: 72px;
                vertical-alignment: center;
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;

                Text {
                    text: "Sunlit Earth";
                    font-size: 22px;
                    font-weight: 700;
                }

                version-line := Text {
                    text: "Version " + root.version;
                }

                Text {
                    text: "© 2026 Sebastian Straub";
                }

                Text {
                    text: root.repository;
                    color: Palette.accent-background;

                    repository-link := TouchArea {
                        mouse-cursor: pointer;

                        clicked => {
                            root.open-url(root.repository);
                        }
                    }
                }
            }
        }

        TabWidget {
            vertical-stretch: 1;

            Tab {
                title: "Attributions";

                // One element per block rather than one `StyledText` for the
                // document, because `StyledText` cannot lay a document out:
                // it stacks paragraphs with no gap between them, it has no
                // font size to give a heading, and its list bullet is literal
                // text glued to the paragraph, so a wrapped line gets no
                // hanging indent. `about::parse_blocks` cuts the document into
                // blocks and each block's inline markdown is parsed on its
                // own, which is also why no block can hold a construct Slint's
                // subset rejects.
                ScrollView {
                    VerticalLayout {
                        width: 100%;
                        padding: 12px;
                        padding-right: 12px + root.scrollbar-width;
                        alignment: start;
                        spacing: 8px;

                        for block in root.attributions : VerticalLayout {
                            // A section break reads heavier than the gap
                            // between two lines of the same section.
                            padding-top: block.kind == 1 ? 8px : 0px;
                            // The item's text keeps the whole column, so every
                            // wrapped line of it starts under the first.
                            padding-left: block.kind == 2
                                ? block.depth * root.nesting-step + root.bullet-column
                                : 0px;

                            if block.kind == 1 : attributions-heading := Text {
                                text: block.heading;
                                font-weight: 700;
                                font-size: block.depth == 1 ? 18px : 16px;
                            }

                            if block.kind == 0 : attributions-paragraph := StyledText {
                                text: block.body;

                                link-clicked(link) => {
                                    root.open-url(link);
                                }
                            }

                            if block.kind == 2 : attributions-item := StyledText {
                                text: block.body;

                                link-clicked(link) => {
                                    root.open-url(link);
                                }

                                // Drawn into the margin the padding leaves
                                // rather than laid out beside the text: a
                                // `StyledText` reports the height of one line
                                // unless it is a layout's own child, so a
                                // bullet in a `HorizontalLayout` next to it
                                // would leave every wrapped item one line tall
                                // and spilling over the block below.
                                attributions-bullet := Text {
                                    x: -root.bullet-column;
                                    // Beside the first line: a child of a
                                    // non-layout element is centered in it
                                    // otherwise, which for a wrapped item is
                                    // the middle of the paragraph.
                                    y: 0px;
                                    text: "\u{2022}";
                                }
                            }
                        }
                    }
                }
            }

            Tab {
                title: "License";

                ScrollView {
                    horizontal-scrollbar-policy: as-needed;

                    // No `width: 100%`: the viewport takes the layout's own
                    // preferred width, which is the longest unwrapped line,
                    // and that is what gives the tab something to scroll.
                    VerticalLayout {
                        padding: 12px;
                        alignment: start;

                        license-body := Text {
                            text: root.license-text;
                            wrap: no-wrap;
                            font-family: root.mono-family;
                            font-size: 12px;
                        }
                    }
                }
            }

            Tab {
                title: "Third-party";

                // The same block layout the attributions get, spelled out
                // again rather than shared: element ids are static, so one
                // component used by both tabs would leave a test unable to
                // say which tab's rows it found.
                ScrollView {
                    VerticalLayout {
                        width: 100%;
                        padding: 12px;
                        padding-right: 12px + root.scrollbar-width;
                        alignment: start;
                        spacing: 8px;

                        for block in root.third-party : VerticalLayout {
                            padding-top: block.kind == 1 ? 8px : 0px;
                            padding-left: block.kind == 2
                                ? block.depth * root.nesting-step + root.bullet-column
                                : 0px;

                            if block.kind == 1 : third-party-heading := Text {
                                text: block.heading;
                                font-weight: 700;
                                font-size: block.depth == 1 ? 18px : 16px;
                            }

                            if block.kind == 0 : third-party-paragraph := StyledText {
                                text: block.body;

                                link-clicked(link) => {
                                    root.open-url(link);
                                }
                            }

                            if block.kind == 2 : third-party-body := StyledText {
                                text: block.body;

                                link-clicked(link) => {
                                    root.open-url(link);
                                }

                                third-party-bullet := Text {
                                    x: -root.bullet-column;
                                    y: 0px;
                                    text: "\u{2022}";
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// System tray entry. A SystemTrayIcon is a top-level component with no window
// of its own, so it is instantiated alongside MainWindow rather than inside it.
// The `icon` is fed from Rust because it is generated procedurally rather than
// shipped as an asset.
export component TrayIcon inherits SystemTrayIcon {
    tooltip: "Sunlit Earth";
    title: "Sunlit Earth";
    // Only properties declared here are exposed to Rust, so the inherited
    // `icon` is fed through one of our own.
    icon: root.tray-image;

    in property <image> tray-image;
    in-out property <bool> auto-refresh-enabled: false;

    callback open-window();
    callback toggle-window();
    callback refresh-now();
    callback auto-refresh-toggled(bool);
    callback show-about();
    callback exit-app();

    // Left-click on the icon toggles the settings window (Windows and Linux;
    // on macOS the attached menu takes precedence, which is why "Open" also
    // exists as a menu entry).
    clicked => { root.toggle-window(); }

    Menu {
        MenuItem {
            title: "Open";
            activated => { root.open-window(); }
        }
        MenuSeparator {}
        MenuItem {
            title: "Refresh Now";
            activated => { root.refresh-now(); }
        }
        MenuItem {
            title: "Auto-refresh";
            checkable: true;
            checked <=> root.auto-refresh-enabled;
            // `checked` is toggled by Slint before this fires, so it already
            // holds the new state.
            activated => { root.auto-refresh-toggled(root.auto-refresh-enabled); }
        }
        MenuSeparator {}
        MenuItem {
            title: "About";
            activated => { root.show-about(); }
        }
        MenuItem {
            title: "Exit";
            activated => { root.exit-app(); }
        }
    }
}
