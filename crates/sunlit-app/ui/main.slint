import { Slider, ComboBox, CheckBox, Button, GroupBox, Palette, ScrollView } from "std-widgets.slint";

component Splitter inherits Rectangle {
    callback moved(length);

    width: 4px;
    background: touch.has-hover || touch.pressed ? Palette.accent-background : transparent;

    touch := TouchArea {
        width: 10px;
        x: -3px;
        mouse-cursor: ew-resize;

        moved => {
            root.moved(self.mouse-x - self.pressed-x);
        }
    }
}

export component MainWindow inherits Window {
    title: "Sunlit Earth — MVP";
    // The SVG master rather than a baked raster: Slint asks for the icon at 64
    // logical pixels times the scale factor, so a vector source lands exactly
    // on whatever that comes to, and 64 and up is the master's own range.
    icon: @image-url("../../../assets/icon/sunlit-earth.svg");
    preferred-width: 1000px;
    preferred-height: 600px;

    in property <image> rendered-image;
    in property <string> renderer-info: "Initializing...";
    in property <[string]> aa-options: ["None", "MSAA 4\u{d7}"];
    in-out property <int> aa-index: 1;
    in property <[string]> texture-options: ["Grid", "Day", "Night", "Day/Night Blend"];
    in-out property <int> texture-index: 3;
    in property <[string]> texture-resolution-options: ["8192", "4096", "2048"];
    in-out property <int> texture-resolution-index: 1;
    in property <string> loading-text;

    in-out property <float> camera-longitude: 0;
    in-out property <float> camera-latitude: 30;
    in-out property <float> camera-zoom: 0.421;
    in-out property <float> camera-offset-x: 0;
    in-out property <float> camera-offset-y: 0;
    in-out property <float> camera-tilt: 0;
    in-out property <float> camera-yaw: 0;
    in-out property <float> camera-pitch: 0;
    out property <length> viewport-width: image-container.width;
    out property <length> viewport-height: image-container.height;
    in-out property <float> terminator-width: 0.1;
    in-out property <bool> diffuse-shading: true;
    in-out property <float> diffuse-floor: 0.70;
    in-out property <float> diffuse-ramp: 0.20;
    in-out property <float> spec-shininess: 100;
    in-out property <float> spec-intensity: 0.17;
    in-out property <float> fresnel-mix: 0.75;
    in-out property <float> fresnel-exp: 4.0;
    in-out property <float> day-gamma: 0.5;
    in-out property <float> day-saturation: 1.0;
    in-out property <float> night-gamma: 0.5;
    in-out property <float> night-saturation: 1.0;
    in-out property <float> cloud-opacity: 0.85;
    in-out property <float> cloud-floor: 0.25;
    in-out property <float> cloud-gamma: 0.65;
    in-out property <bool> atmo-enabled: true;
    in-out property <float> rayleigh-intensity: 0.5;
    in-out property <float> rayleigh-sharpness: 50.0;
    in-out property <float> rayleigh-haze: 0.55;
    in-out property <float> nightglow-intensity: 0.25;
    in-out property <float> nightglow-balance: 0.37;
    in-out property <float> nightglow-falloff: 15.0;
    in-out property <float> star-intensity: 0.45;
    in-out property <float> star-mag-limit: 6.5;

    in property <float> zoom-display-distance: 8.0;
    callback sliders-changed();
    callback msaa-changed();
    callback texture-changed();
    callback texture-resolution-changed();
    callback set-wallpaper();
    in-out property <bool> use-custom-datetime: false;
    in-out property <float> custom-hour: 12.0;
    in-out property <float> custom-day-of-year: 1.0;
    in-out property <int> custom-year-index: 10;
    in property <[string]> year-options;
    in property <string> hour-label: "12:00";
    in property <string> day-label: "Jan 1";
    in property <int> max-day-of-year: 365;

    callback mouse-drag-globe(float, float);
    callback mouse-drag-frame(float, float);
    callback mouse-drag-orient(float, float);
    callback mouse-drag-tilt(float, float);
    callback mouse-scroll(float);
    callback apply-preset(int);
    callback load-defaults();
    callback reset();
    callback datetime-override-toggled();
    callback show-about();

    in-out property <bool> auto-refresh-enabled: false;
    in-out property <float> auto-refresh-interval: 5.0;
    callback auto-refresh-changed();

    in-out property <bool> advanced-open: false;

    // Controls panel on the left
    Rectangle {
        x: 0;
        y: 0;
        width: splitter.x;
        height: root.height;
        background: Palette.background.darker(0.2);

        ScrollView {
            horizontal-scrollbar-policy: always-off;
            width: parent.width;
            height: parent.height;

            VerticalLayout {
                width: parent.visible-width;
                padding: 8px;
                spacing: 4px;
                alignment: start;

                // --- Top-level actions ---

                Button {
                    text: "Set as Wallpaper";
                    clicked => { root.set-wallpaper(); }
                }

                HorizontalLayout {
                    spacing: 4px;
                    Button {
                        text: "Load Defaults";
                        min-width: 0;
                        preferred-width: 0;
                        clicked => { root.load-defaults(); }
                    }
                    Button {
                        text: "Reset";
                        min-width: 0;
                        preferred-width: 0;
                        clicked => { root.reset(); }
                    }
                }

                // --- Auto-refresh ---

                CheckBox {
                    text: "Auto-refresh wallpaper";
                    checked <=> root.auto-refresh-enabled;
                    toggled => { root.auto-refresh-changed(); }
                }

                if root.auto-refresh-enabled : HorizontalLayout {
                    spacing: 4px;
                    padding-left: 24px;
                    Slider {
                        minimum: 1;
                        maximum: 30;
                        value <=> root.auto-refresh-interval;
                        changed(value) => { root.auto-refresh-changed(); }
                    }
                    Text {
                        text: "every " + round(root.auto-refresh-interval) + " min";
                        vertical-alignment: center;
                    }
                }

                // --- 3x3 preset grid ---

                Rectangle { height: 8px; }

                Text {
                    text: "Presets";
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                GridLayout {
                    spacing: 4px;
                    Row {
                        Button {
                            text: "Europe";
                            min-width: 0;
                            preferred-width: 0;
                            clicked => { root.apply-preset(0); }
                        }
                        Button {
                            text: "N. America";
                            min-width: 0;
                            preferred-width: 0;
                            clicked => { root.apply-preset(1); }
                        }
                        Button {
                            text: "S. America";
                            min-width: 0;
                            preferred-width: 0;
                            clicked => { root.apply-preset(2); }
                        }
                    }
                    Row {
                        Button {
                            text: "Africa";
                            min-width: 0;
                            preferred-width: 0;
                            clicked => { root.apply-preset(3); }
                        }
                        Button {
                            text: "Asia";
                            min-width: 0;
                            preferred-width: 0;
                            clicked => { root.apply-preset(4); }
                        }
                        Button {
                            text: "Oceania";
                            min-width: 0;
                            preferred-width: 0;
                            clicked => { root.apply-preset(5); }
                        }
                    }
                    Row {
                        Button {
                            text: "Pacific";
                            min-width: 0;
                            preferred-width: 0;
                            clicked => { root.apply-preset(6); }
                        }
                        Button {
                            text: "Blue Marble";
                            min-width: 0;
                            preferred-width: 0;
                            clicked => { root.apply-preset(7); }
                        }
                        Button {
                            text: "Earthrise";
                            min-width: 0;
                            preferred-width: 0;
                            clicked => { root.apply-preset(8); }
                        }
                    }
                }

                // --- Advanced toggle ---

                Rectangle { height: 8px; }

                TouchArea {
                    height: 24px;
                    clicked => { root.advanced-open = !root.advanced-open; }

                    HorizontalLayout {
                        spacing: 4px;
                        Text {
                            text: root.advanced-open ? "\u{25bc}" : "\u{25b6}";
                            vertical-alignment: center;
                            font-size: 11px;
                        }
                        Text {
                            text: "Advanced";
                            vertical-alignment: center;
                            font-weight: 700;
                        }
                    }
                }

                // --- Collapsible advanced section ---

                if root.advanced-open :
                VerticalLayout {
                    spacing: 4px;

                    GroupBox {
                        title: "Camera Position";
                        VerticalLayout {
                            spacing: 4px;

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Longitude";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                longitude-slider := Slider {
                                    minimum: -180;
                                    maximum: 180;
                                    value <=> root.camera-longitude;
                                    changed => { root.sliders-changed(); }
                                }
                                Text {
                                    text: round(root.camera-longitude) + "\u{b0}";
                                    vertical-alignment: center;
                                    min-width: 35px;
                                }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Latitude";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                latitude-slider := Slider {
                                    minimum: -89;
                                    maximum: 89;
                                    value <=> root.camera-latitude;
                                    changed => { root.sliders-changed(); }
                                }
                                Text {
                                    text: round(root.camera-latitude) + "\u{b0}";
                                    vertical-alignment: center;
                                    min-width: 35px;
                                }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Zoom";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                zoom-slider := Slider {
                                    minimum: 0.0;
                                    maximum: 1.0;
                                    value <=> root.camera-zoom;
                                    changed => { root.sliders-changed(); }
                                }
                                Text {
                                    text: round(root.zoom-display-distance * 10) / 10;
                                    vertical-alignment: center;
                                    min-width: 35px;
                                }
                            }
                        }
                    }

                    GroupBox {
                        title: "Camera Orientation";
                        VerticalLayout {
                            spacing: 4px;

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Tilt";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                tilt-slider := Slider {
                                    minimum: -180;
                                    maximum: 180;
                                    value <=> root.camera-tilt;
                                    changed => {
                                        if root.camera-tilt > -5 && root.camera-tilt < 5 {
                                            root.camera-tilt = 0;
                                        }
                                        root.sliders-changed();
                                    }
                                }
                                Text {
                                    text: round(root.camera-tilt) + "\u{b0}";
                                    vertical-alignment: center;
                                    min-width: 35px;
                                }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Yaw";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                yaw-slider := Slider {
                                    minimum: -90;
                                    maximum: 90;
                                    value <=> root.camera-yaw;
                                    changed => {
                                        if root.camera-yaw > -3 && root.camera-yaw < 3 {
                                            root.camera-yaw = 0;
                                        }
                                        root.sliders-changed();
                                    }
                                }
                                Text {
                                    text: round(root.camera-yaw) + "\u{b0}";
                                    vertical-alignment: center;
                                    min-width: 35px;
                                }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Pitch";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                pitch-slider := Slider {
                                    minimum: -90;
                                    maximum: 90;
                                    value <=> root.camera-pitch;
                                    changed => {
                                        if root.camera-pitch > -3 && root.camera-pitch < 3 {
                                            root.camera-pitch = 0;
                                        }
                                        root.sliders-changed();
                                    }
                                }
                                Text {
                                    text: round(root.camera-pitch) + "\u{b0}";
                                    vertical-alignment: center;
                                    min-width: 35px;
                                }
                            }
                        }
                    }

                    GroupBox {
                        title: "Framing";
                        VerticalLayout {
                            spacing: 4px;

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Offset X";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                offset-x-slider := Slider {
                                    minimum: -3.0;
                                    maximum: 3.0;
                                    value <=> root.camera-offset-x;
                                    changed => {
                                        if root.camera-offset-x > -0.05 && root.camera-offset-x < 0.05 {
                                            root.camera-offset-x = 0;
                                        }
                                        root.sliders-changed();
                                    }
                                }
                                Text {
                                    text: round(root.camera-offset-x * 100) / 100;
                                    vertical-alignment: center;
                                    min-width: 35px;
                                }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Offset Y";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                offset-y-slider := Slider {
                                    minimum: -3.0;
                                    maximum: 3.0;
                                    value <=> root.camera-offset-y;
                                    changed => {
                                        if root.camera-offset-y > -0.05 && root.camera-offset-y < 0.05 {
                                            root.camera-offset-y = 0;
                                        }
                                        root.sliders-changed();
                                    }
                                }
                                Text {
                                    text: round(root.camera-offset-y * 100) / 100;
                                    vertical-alignment: center;
                                    min-width: 35px;
                                }
                            }
                        }
                    }

                    GroupBox {
                        title: "Date / Time";
                        VerticalLayout {
                            spacing: 4px;

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Custom";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                CheckBox {
                                    text: "Override date/time";
                                    checked <=> root.use-custom-datetime;
                                    toggled => {
                                        root.datetime-override-toggled();
                                    }
                                }
                            }

                            if root.use-custom-datetime :
                            VerticalLayout {
                                spacing: 4px;

                                HorizontalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: "Hour";
                                        vertical-alignment: center;
                                        min-width: 70px;
                                    }
                                    Slider {
                                        minimum: 0.0;
                                        maximum: 23.99;
                                        value <=> root.custom-hour;
                                        changed => { root.sliders-changed(); }
                                    }
                                    Text {
                                        text: root.hour-label;
                                        vertical-alignment: center;
                                        min-width: 45px;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: "Day";
                                        vertical-alignment: center;
                                        min-width: 70px;
                                    }
                                    Slider {
                                        minimum: 1.0;
                                        maximum: root.max-day-of-year;
                                        value <=> root.custom-day-of-year;
                                        changed => { root.sliders-changed(); }
                                    }
                                    Text {
                                        text: root.day-label;
                                        vertical-alignment: center;
                                        min-width: 45px;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: "Year";
                                        vertical-alignment: center;
                                        min-width: 70px;
                                    }
                                    ComboBox {
                                        model: root.year-options;
                                        current-index <=> root.custom-year-index;
                                        max-height: 24px;
                                        selected => { root.sliders-changed(); }
                                    }
                                }
                            }
                        }
                    }

                    GroupBox {
                        title: "Clouds";
                        VerticalLayout {
                            spacing: 4px;

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Opacity";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                cloud-opacity-slider := Slider {
                                    minimum: 0.0;
                                    maximum: 1.0;
                                    value <=> root.cloud-opacity;
                                    changed => { root.sliders-changed(); }
                                }
                                Text {
                                    text: round(root.cloud-opacity * 100) + "%";
                                    vertical-alignment: center;
                                    min-width: 35px;
                                }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Floor";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                cloud-floor-slider := Slider {
                                    minimum: 0.0;
                                    maximum: 0.5;
                                    value <=> root.cloud-floor;
                                    changed => { root.sliders-changed(); }
                                }
                                Text {
                                    text: round(root.cloud-floor * 100) + "%";
                                    vertical-alignment: center;
                                    min-width: 35px;
                                }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Gamma";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                cloud-gamma-slider := Slider {
                                    minimum: 0.1;
                                    maximum: 2.0;
                                    value <=> root.cloud-gamma;
                                    changed => { root.sliders-changed(); }
                                }
                                Text {
                                    text: round(cloud-gamma-slider.value * 100) / 100;
                                    vertical-alignment: center;
                                    min-width: 35px;
                                }
                            }
                        }
                    }

                    GroupBox {
                        title: "Celestial";
                        VerticalLayout {
                            spacing: 4px;

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Stars";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                star-intensity-slider := Slider {
                                    minimum: 0.0;
                                    maximum: 2.0;
                                    value <=> root.star-intensity;
                                    changed => { root.sliders-changed(); }
                                }
                                Text {
                                    text: round(root.star-intensity * 100) + "%";
                                    vertical-alignment: center;
                                    min-width: 35px;
                                }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Magnitude";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                star-mag-limit-slider := Slider {
                                    minimum: 0.0;
                                    maximum: 7.0;
                                    value <=> root.star-mag-limit;
                                    changed => { root.sliders-changed(); }
                                }
                                Text {
                                    text: round(root.star-mag-limit * 10) / 10;
                                    vertical-alignment: center;
                                    min-width: 35px;
                                }
                            }
                        }
                    }

                    GroupBox {
                        title: "Atmosphere";
                        VerticalLayout {
                            spacing: 4px;

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Enable";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                CheckBox {
                                    text: "Atmosphere glow";
                                    checked <=> root.atmo-enabled;
                                    toggled => { root.sliders-changed(); }
                                }
                            }

                            if root.atmo-enabled :
                            VerticalLayout {
                                spacing: 4px;

                                Text {
                                    text: "Rayleigh";
                                    font-weight: 700;
                                }

                                HorizontalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: "  Intensity";
                                        vertical-alignment: center;
                                        min-width: 70px;
                                    }
                                    rayleigh-intensity-slider := Slider {
                                        minimum: 0.0;
                                        maximum: 1.0;
                                        value <=> root.rayleigh-intensity;
                                        changed => { root.sliders-changed(); }
                                    }
                                    Text {
                                        text: round(root.rayleigh-intensity * 100) + "%";
                                        vertical-alignment: center;
                                        min-width: 35px;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: "  Sharpness";
                                        vertical-alignment: center;
                                        min-width: 70px;
                                    }
                                    rayleigh-sharpness-slider := Slider {
                                        minimum: 10.0;
                                        maximum: 100.0;
                                        value <=> root.rayleigh-sharpness;
                                        changed => { root.sliders-changed(); }
                                    }
                                    Text {
                                        text: round(rayleigh-sharpness-slider.value * 10) / 10;
                                        vertical-alignment: center;
                                        min-width: 35px;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: "  Haze";
                                        vertical-alignment: center;
                                        min-width: 70px;
                                    }
                                    rayleigh-haze-slider := Slider {
                                        minimum: 0.0;
                                        maximum: 1.0;
                                        value <=> root.rayleigh-haze;
                                        changed => { root.sliders-changed(); }
                                    }
                                    Text {
                                        text: round(rayleigh-haze-slider.value * 100) + "%";
                                        vertical-alignment: center;
                                        min-width: 35px;
                                    }
                                }

                                Text {
                                    text: "Nightglow";
                                    font-weight: 700;
                                }

                                HorizontalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: "  Intensity";
                                        vertical-alignment: center;
                                        min-width: 70px;
                                    }
                                    nightglow-intensity-slider := Slider {
                                        minimum: 0.0;
                                        maximum: 1.0;
                                        value <=> root.nightglow-intensity;
                                        changed => { root.sliders-changed(); }
                                    }
                                    Text {
                                        text: round(root.nightglow-intensity * 100) + "%";
                                        vertical-alignment: center;
                                        min-width: 35px;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: "  Balance";
                                        vertical-alignment: center;
                                        min-width: 70px;
                                    }
                                    nightglow-balance-slider := Slider {
                                        minimum: 0.0;
                                        maximum: 1.0;
                                        value <=> root.nightglow-balance;
                                        changed => { root.sliders-changed(); }
                                    }
                                    Text {
                                        text: root.nightglow-balance <= 0.01 ? "orange" :
                                              root.nightglow-balance >= 0.99 ? "green" :
                                              round(root.nightglow-balance * 100) / 100;
                                        vertical-alignment: center;
                                        min-width: 35px;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: "  Falloff";
                                        vertical-alignment: center;
                                        min-width: 70px;
                                    }
                                    nightglow-falloff-slider := Slider {
                                        minimum: 2.0;
                                        maximum: 50.0;
                                        value <=> root.nightglow-falloff;
                                        changed => { root.sliders-changed(); }
                                    }
                                    Text {
                                        text: round(nightglow-falloff-slider.value * 10) / 10;
                                        vertical-alignment: center;
                                        min-width: 35px;
                                    }
                                }
                            }
                        }
                    }

                    GroupBox {
                        title: "Lighting";
                        VerticalLayout {
                            spacing: 4px;

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Terminator";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                terminator-slider := Slider {
                                    minimum: 0.01;
                                    maximum: 0.3;
                                    value <=> root.terminator-width;
                                    changed => { root.sliders-changed(); }
                                }
                                Text {
                                    text: round(terminator-slider.value * 1000) / 1000;
                                    vertical-alignment: center;
                                    min-width: 35px;
                                }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Diffuse";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                diffuse-check := CheckBox {
                                    text: "Dayside shading";
                                    checked <=> root.diffuse-shading;
                                    toggled => { root.sliders-changed(); }
                                }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "  Floor";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                diffuse-floor-slider := Slider {
                                    minimum: 0.0;
                                    maximum: 1.0;
                                    value <=> root.diffuse-floor;
                                    changed => { root.sliders-changed(); }
                                }
                                Text {
                                    text: round(diffuse-floor-slider.value * 100) / 100;
                                    vertical-alignment: center;
                                    min-width: 35px;
                                }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "  Ramp";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                diffuse-ramp-slider := Slider {
                                    minimum: 0.1;
                                    maximum: 1.0;
                                    value <=> root.diffuse-ramp;
                                    changed => { root.sliders-changed(); }
                                }
                                Text {
                                    text: round(diffuse-ramp-slider.value * 100) / 100;
                                    vertical-alignment: center;
                                    min-width: 35px;
                                }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Shininess";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                spec-shininess-slider := Slider {
                                    minimum: 10;
                                    maximum: 500;
                                    value <=> root.spec-shininess;
                                    changed => { root.sliders-changed(); }
                                }
                                Text {
                                    text: round(spec-shininess-slider.value);
                                    vertical-alignment: center;
                                    min-width: 35px;
                                }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Glint";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                spec-intensity-slider := Slider {
                                    minimum: 0.0;
                                    maximum: 1.0;
                                    value <=> root.spec-intensity;
                                    changed => { root.sliders-changed(); }
                                }
                                Text {
                                    text: round(spec-intensity-slider.value * 100) / 100;
                                    vertical-alignment: center;
                                    min-width: 35px;
                                }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Fresnel Mix";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                fresnel-mix-slider := Slider {
                                    minimum: 0.0;
                                    maximum: 1.0;
                                    value <=> root.fresnel-mix;
                                    changed => { root.sliders-changed(); }
                                }
                                Text {
                                    text: round(fresnel-mix-slider.value * 100) / 100;
                                    vertical-alignment: center;
                                    min-width: 35px;
                                }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Fresnel Extent";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                fresnel-exp-slider := Slider {
                                    minimum: 1.0;
                                    maximum: 8.0;
                                    value <=> root.fresnel-exp;
                                    changed => { root.sliders-changed(); }
                                }
                                Text {
                                    text: round(fresnel-exp-slider.value * 10) / 10;
                                    vertical-alignment: center;
                                    min-width: 35px;
                                }
                            }
                        }
                    }

                    GroupBox {
                        title: "Color Correction";
                        VerticalLayout {
                            spacing: 4px;

                            Text {
                                text: "Day Texture";
                                font-weight: 700;
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "  Gamma";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                day-gamma-slider := Slider {
                                    minimum: 0.0;
                                    maximum: 1.0;
                                    value <=> root.day-gamma;
                                    changed => { root.sliders-changed(); }
                                }
                                Text {
                                    text: round((day-gamma-slider.value <= 0.5 ? 0.2 + 1.6 * day-gamma-slider.value : 1.0 + 4.0 * (day-gamma-slider.value - 0.5)) * 100) / 100;
                                    vertical-alignment: center;
                                    min-width: 35px;
                                }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "  Saturation";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                day-saturation-slider := Slider {
                                    minimum: 0.0;
                                    maximum: 2.0;
                                    value <=> root.day-saturation;
                                    changed => { root.sliders-changed(); }
                                }
                                Text {
                                    text: round(day-saturation-slider.value * 100) / 100;
                                    vertical-alignment: center;
                                    min-width: 35px;
                                }
                            }

                            Text {
                                text: "Night Texture";
                                font-weight: 700;
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "  Gamma";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                night-gamma-slider := Slider {
                                    minimum: 0.0;
                                    maximum: 1.0;
                                    value <=> root.night-gamma;
                                    changed => { root.sliders-changed(); }
                                }
                                Text {
                                    text: round((night-gamma-slider.value <= 0.5 ? 0.2 + 1.6 * night-gamma-slider.value : 1.0 + 4.0 * (night-gamma-slider.value - 0.5)) * 100) / 100;
                                    vertical-alignment: center;
                                    min-width: 35px;
                                }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "  Saturation";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                night-saturation-slider := Slider {
                                    minimum: 0.0;
                                    maximum: 2.0;
                                    value <=> root.night-saturation;
                                    changed => { root.sliders-changed(); }
                                }
                                Text {
                                    text: round(night-saturation-slider.value * 100) / 100;
                                    vertical-alignment: center;
                                    min-width: 35px;
                                }
                            }
                        }
                    }

                    GroupBox {
                        title: "Rendering";
                        VerticalLayout {
                            spacing: 4px;

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Texture";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                texture-combo := ComboBox {
                                    model: texture-options;
                                    current-index <=> root.texture-index;
                                    max-height: 24px;
                                    selected => { root.texture-changed(); }
                                }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Resolution";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                texture-resolution-combo := ComboBox {
                                    model: texture-resolution-options;
                                    current-index <=> root.texture-resolution-index;
                                    max-height: 24px;
                                    selected => { root.texture-resolution-changed(); }
                                }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Anti-Aliasing";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                aa-combo := ComboBox {
                                    model: aa-options;
                                    current-index <=> root.aa-index;
                                    max-height: 24px;
                                    selected => { root.msaa-changed(); }
                                }
                            }
                        }
                    }

                    Text {
                        text: renderer-info;
                        color: #888888;
                        font-size: 11px;
                    }

                    Button {
                        text: "About";
                        clicked => { root.show-about(); }
                    }
                }
            }
        }
    }

    splitter := Splitter {
        x: 300px;
        height: 100%;

        moved(delta) => {
            self.x = clamp(self.x + delta, 230px, root.width - 240px);
        }
    }

    // Image fills the area right of the splitter
    image-container := Rectangle {
        x: splitter.x + splitter.width;
        y: 0;
        width: root.width - self.x;
        height: root.height;
        background: black;

        Image {
            source: rendered-image;
            width: parent.width;
            height: parent.height;
            image-fit: contain;
        }

        property <length> last-mouse-x;
        property <length> last-mouse-y;
        property <bool> left-held: false;
        property <bool> right-held: false;
        property <bool> middle-held: false;

        viewport-touch := TouchArea {
            width: parent.width;
            height: parent.height;

            pointer-event(event) => {
                if event.button == PointerEventButton.left {
                    image-container.left-held = event.kind == PointerEventKind.down;
                }
                if event.button == PointerEventButton.right {
                    image-container.right-held = event.kind == PointerEventKind.down;
                }
                if event.button == PointerEventButton.middle {
                    image-container.middle-held = event.kind == PointerEventKind.down;
                }
                if event.kind == PointerEventKind.down || event.kind == PointerEventKind.up {
                    image-container.last-mouse-x = self.mouse-x;
                    image-container.last-mouse-y = self.mouse-y;
                }
            }

            moved => {
                if image-container.left-held && image-container.right-held {
                    root.mouse-drag-tilt(
                        (self.mouse-x - image-container.last-mouse-x) / 1px,
                        (self.mouse-y - image-container.last-mouse-y) / 1px
                    );
                } else if image-container.left-held {
                    root.mouse-drag-globe(
                        (self.mouse-x - image-container.last-mouse-x) / 1px,
                        (self.mouse-y - image-container.last-mouse-y) / 1px
                    );
                } else if image-container.right-held {
                    root.mouse-drag-frame(
                        (self.mouse-x - image-container.last-mouse-x) / 1px,
                        (self.mouse-y - image-container.last-mouse-y) / 1px
                    );
                } else if image-container.middle-held {
                    root.mouse-drag-orient(
                        (self.mouse-x - image-container.last-mouse-x) / 1px,
                        (self.mouse-y - image-container.last-mouse-y) / 1px
                    );
                }
                image-container.last-mouse-x = self.mouse-x;
                image-container.last-mouse-y = self.mouse-y;
            }

            scroll-event(event) => {
                root.mouse-scroll(event.delta-y / 1px);
                return accept;
            }
        }

        if loading-text != "" : Rectangle {
            x: parent.width - loading-label.width - 16px;
            y: parent.height - loading-label.height - 12px;
            width: loading-label.width + 16px;
            height: loading-label.height + 8px;
            border-radius: 4px;
            background: #000000aa;

            loading-label := Text {
                x: 8px;
                y: 4px;
                text: loading-text;
                color: #cccccc;
                font-size: 12px;
            }
        }
    }
}

export component AboutWindow inherits Window {
    title: "About Sunlit Earth";
    preferred-width: 520px;
    preferred-height: 420px;

    in property <string> version;
    in property <[string]> attributions;

    ScrollView {
        width: parent.width;
        height: parent.height;
        VerticalLayout {
            width: parent.visible-width;
            padding: 20px;
            spacing: 12px;
            Text {
                text: "Sunlit Earth";
                font-size: 24px;
                font-weight: 700;
            }
            Text { text: "Version " + root.version; }
            Text {
                text: "Attributions";
                font-size: 18px;
                font-weight: 700;
            }
            for attribution in root.attributions : Text {
                text: attribution;
                wrap: word-wrap;
            }
        }
    }
}

// System tray entry. A SystemTrayIcon is a top-level component with no window
// of its own, so it is instantiated alongside MainWindow rather than inside it.
// The `icon` is fed from Rust because it is generated procedurally rather than
// shipped as an asset.
export component TrayIcon inherits SystemTrayIcon {
    tooltip: "Sunlit Earth";
    title: "Sunlit Earth";
    // Only properties declared here are exposed to Rust, so the inherited
    // `icon` is fed through one of our own.
    icon: root.tray-image;

    in property <image> tray-image;
    in-out property <bool> auto-refresh-enabled: false;

    callback open-window();
    callback toggle-window();
    callback refresh-now();
    callback auto-refresh-toggled(bool);
    callback show-about();
    callback exit-app();

    // Left-click on the icon toggles the settings window (Windows and Linux;
    // on macOS the attached menu takes precedence, which is why "Open" also
    // exists as a menu entry).
    clicked => { root.toggle-window(); }

    Menu {
        MenuItem {
            title: "Open";
            activated => { root.open-window(); }
        }
        MenuSeparator {}
        MenuItem {
            title: "Refresh Now";
            activated => { root.refresh-now(); }
        }
        MenuItem {
            title: "Auto-refresh";
            checkable: true;
            checked <=> root.auto-refresh-enabled;
            // `checked` is toggled by Slint before this fires, so it already
            // holds the new state.
            activated => { root.auto-refresh-toggled(root.auto-refresh-enabled); }
        }
        MenuSeparator {}
        MenuItem {
            title: "About";
            activated => { root.show-about(); }
        }
        MenuItem {
            title: "Exit";
            activated => { root.exit-app(); }
        }
    }
}
