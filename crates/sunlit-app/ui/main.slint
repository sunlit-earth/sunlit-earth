import { Slider, Button, Palette, ScrollView } from "std-widgets.slint";
import { MonitorTile, Splitter, Hint, SettingRow, SettingColor, SettingCheck, SettingCombo, SettingHeading, SettingGroup } from "widgets.slint";
import { OverlayHint, OverlayHints, GestureTip } from "overlays/common.slint";
import { CameraPanel, CameraStick, CameraReset } from "overlays/camera-panel.slint";

export { MonitorTile, AboutBlock, ColorText, ParsedColor } from "widgets.slint";
export { AboutWindow } from "about.slint";
export { TrayIcon } from "tray.slint";
export { CameraStick, CameraReset } from "overlays/camera-panel.slint";

// The settings behind the Advanced section, one struct per group, nested the
// way the panel nests its subsections. The nesting is the one statement of
// which setting belongs where: a subsection's heading and a group's header
// compare and reset the struct they stand for, so a field added to a struct
// is covered by both with no further edit.
export struct CameraPositionSettings {
    longitude: float,
    latitude: float,
    zoom: float,
    sun-fixed: bool,
    solar-time: float,
}

export struct CameraOrientationSettings {
    tilt: float,
    yaw: float,
    pitch: float,
}

export struct FramingSettings {
    fov: float,
    offset-x: float,
    offset-y: float,
}

export struct DateTimeSettings {
    use-custom: bool,
    hour: float,
    day-of-year: float,
    year-index: int,
}

export struct HazeSettings {
    equator: float,
    pole: float,
    latitude: float,
    band: float,
}

export struct CloudCoverSettings {
    floor: float,
    gamma: float,
}

export struct CloudSettings {
    enabled: bool,
    opacity: float,
    opacity-night: float,
    night-brightness: float,
    haze: HazeSettings,
    land: CloudCoverSettings,
    ocean: CloudCoverSettings,
}

export struct SkySettings {
    fov: float,
    milky-way: float,
}

export struct SunSettings {
    glow: float,
    rays: float,
    size: float,
    halo-radius: float,
    flare: float,
    horizon-boost: float,
    horizon-reach: float,
    horizon-depth: float,
    reddening: float,
    refraction: float,
}

export struct MoonSettings {
    brightness: float,
    size: float,
    earthshine: float,
}

export struct StarSettings {
    intensity: float,
    size: float,
    glow-strength: float,
    glow-radius: float,
    contrast: float,
    mag-limit: float,
}

export struct CelestialSettings {
    sky: SkySettings,
    sun: SunSettings,
    moon: MoonSettings,
    stars: StarSettings,
}

export struct RayleighSettings {
    intensity: float,
    sharpness: float,
    haze: float,
}

export struct SunriseBandSettings {
    glow: float,
    width: float,
}

export struct NightglowSettings {
    intensity: float,
    balance: float,
    falloff: float,
}

export struct AtmosphereSettings {
    enabled: bool,
    rayleigh: RayleighSettings,
    sunrise: SunriseBandSettings,
    nightglow: NightglowSettings,
}

export struct LightingSettings {
    terminator-width: float,
    diffuse-shading: bool,
    diffuse-floor: float,
    diffuse-ramp: float,
    spec-shininess: float,
    spec-intensity: float,
    fresnel-mix: float,
    fresnel-exp: float,
}

// `gamma` is the slider's position on the curve rather than the gamma itself,
// which `day-gamma-value` and `night-gamma-value` carry. `ocean` is the color
// open water takes before the gamma and the saturation act on it.
export struct TextureColorSettings {
    ocean: color,
    gamma: float,
    saturation: float,
}

export struct ColorCorrectionSettings {
    day: TextureColorSettings,
    night: TextureColorSettings,
}

// Every group at once, which is the shape of `defaults`.
export struct SceneSettings {
    camera-position: CameraPositionSettings,
    camera-orientation: CameraOrientationSettings,
    framing: FramingSettings,
    datetime: DateTimeSettings,
    clouds: CloudSettings,
    celestial: CelestialSettings,
    atmosphere: AtmosphereSettings,
    lighting: LightingSettings,
    color-correction: ColorCorrectionSettings,
}

export component MainWindow inherits Window {
    title: "Sunlit Earth " + root.version;
    // The SVG master rather than a baked raster: Slint asks for the icon at 64
    // logical pixels times the scale factor, so a vector source lands exactly
    // on whatever that comes to, and 64 and up is the master's own range.
    icon: @image-url("../../../assets/icon/sunlit-earth.svg");
    preferred-width: 1000px;
    preferred-height: 600px;
    // The panel's floor of 262px, the splitter, and `min-image-width` below it,
    // rounded up. A binding from `panel.min-width` would keep itself honest but
    // runs through the window's own layout; the test guards the arithmetic
    // instead.
    min-width: 520px;

    in property <string> version;
    in property <image> rendered-image;
    in property <string> renderer-info: "Initializing...";
    in property <[string]> aa-options: ["None", "MSAA 4\u{d7}"];
    in-out property <int> aa-index;
    in property <[string]> texture-options: ["Grid", "Day", "Night", "Day/Night Blend"];
    in-out property <int> texture-index;
    in property <[string]> texture-resolution-options: ["8192", "4096", "2048"];
    in-out property <int> texture-resolution-index;
    in property <string> loading-text;

    // One property per group rather than one for the whole scene: a write to
    // a struct property dirties every binding that reads any part of it, so a
    // slider tick re-evaluates its own group and nothing else. None of them
    // has an initial value here. Rust writes them, and `defaults` with them,
    // from the config before the window is shown, so `AppConfig::default()`
    // is the one place a default is written.
    in-out property <CameraPositionSettings> camera-position;
    in-out property <CameraOrientationSettings> camera-orientation;
    in-out property <FramingSettings> framing;
    in-out property <DateTimeSettings> datetime;
    in-out property <CloudSettings> clouds;
    in-out property <CelestialSettings> celestial;
    in-out property <AtmosphereSettings> atmosphere;
    in-out property <LightingSettings> lighting;
    in-out property <ColorCorrectionSettings> color-correction;
    // What every reset in the Advanced section goes back to.
    in property <SceneSettings> defaults;

    out property <length> viewport-width: image-container.width;
    out property <length> viewport-height: image-container.height;
    // The sky slider's own range. A hemisphere is as much sky as one screen
    // can mean, and the shader's clamp is wider, so the two numbers live here
    // rather than in the row and a test can read what the row is built from.
    out property <float> sky-fov-minimum: 60.0;
    out property <float> sky-fov-maximum: 180.0;

    // What a slider's number means, derived in Rust and written here rather
    // than worked out again in this file: the camera's distance behind the
    // zoom slider, and the gamma each gamma slider stands for. The curves are
    // in `params.rs`, so a label cannot drift from the value the renderer gets.
    in property <float> zoom-display-distance;
    in property <float> day-gamma-value;
    in property <float> night-gamma-value;
    callback sliders-changed();
    callback msaa-changed();
    callback texture-changed();
    callback texture-resolution-changed();
    callback set-wallpaper();
    in property <[string]> year-options;
    in property <string> hour-label;
    in property <string> day-label;
    // The Time of day row's reading, formatted in Rust as the hour label is.
    in property <string> solar-time-label;
    in property <int> max-day-of-year;

    callback mouse-drag-globe(float, float);
    callback mouse-drag-globe-begin();
    callback mouse-drag-frame(float, float);
    callback mouse-drag-orient(float, float);
    callback mouse-drag-tilt(float, float);
    callback mouse-scroll(float);
    callback apply-preset(int);

    // The camera panel over the preview. A stick reports its deflection,
    // right and up positive, and the seconds since its previous report; the
    // steps, the resets and the zoom buttons ease toward their target, and
    // Rust keeps `camera-easing` set while one is on its way so the ease
    // timer reports the seconds that pass.
    callback camera-stick(CameraStick, float, float, float);
    callback camera-orbit-step(int, int);
    callback camera-roll(float);
    callback camera-reset(CameraReset);
    callback camera-zoom-step(int);
    callback camera-zoom-rate(int, float);
    callback camera-ease-tick(float);
    in property <bool> camera-easing;

    callback load-defaults();
    callback reset();
    callback datetime-override-toggled();
    // The Sun-fixed check, after it changed: the value the other mode reads is
    // converted at the current instant, so the view does not jump.
    callback camera-frame-toggled();
    callback show-about();

    in-out property <bool> auto-refresh-enabled;
    in-out property <float> auto-refresh-interval;
    // The settled change: the schedule is updated and the config is written.
    callback auto-refresh-changed();
    // The interval while the handle is still moving: the schedule follows, the
    // config waits for the release.
    callback auto-refresh-interval-moved();

    // The Displays group. Every model here is filled in from Rust, and an empty
    // `display-tiles` is a session whose monitors could not be enumerated at
    // all, which is macOS and any Windows session where the query failed.
    in property <[string]> display-mode-options;
    in-out property <int> display-mode-index;
    in property <[string]> display-screen-options;
    // Parallel to `display-screen-options`, holding the id each row addresses.
    // The first row is the automatic anchor and its id is empty.
    in property <[string]> display-screen-ids;
    in-out property <int> display-anchor-index;
    in property <[MonitorTile]> display-tiles;
    // Width over height of the whole layout, so the diagram can keep its shape.
    in property <float> display-aspect: 1.0;
    callback display-plan-changed();

    in-out property <bool> advanced-open: false;

    // The widest the panel's content insists on being, where that content
    // actually starts, and the window's own floor. The sidebar derives its
    // width from the first of these; all three are exposed so a test can hold
    // them to it without restating a number this file already carries.
    out property <length> panel-min-width: panel.min-width;
    out property <length> panel-x: panel.x;
    out property <length> window-min-width: root.min-width;

    // What the splitter drag stores, and what the window opens at. The
    // sidebar's real width is this held between the panel's own floor and
    // whatever leaves the image its minimum, so no drag and no window size can
    // cut the panel's content off. At 360 the preset grid's widest label gets
    // 107px of button against the 93px it asks for, which leaves room for a
    // platform whose font is wider. The floor is far below that, so a drag can
    // still take the sidebar narrow enough to elide.
    property <length> panel-width: 360px;
    property <length> min-image-width: 240px;
    // The fluent ScrollView draws this on top of the flickable rather than
    // beside it, so the panel reserves it whether or not the bar is showing.
    property <length> scrollbar-width: 14px;

    // Controls panel on the left
    sidebar := Rectangle {
        x: 0;
        y: 0;
        width: max(panel.min-width, min(root.panel-width, root.width - root.min-image-width));
        height: root.height;
        background: Palette.background.darker(0.2);

        VerticalLayout {
            width: 100%;
            height: 100%;

            ScrollView {
                horizontal-scrollbar-policy: as-needed;
                vertical-stretch: 1;

                panel := VerticalLayout {
                    width: 100%;
                    padding: 8px;
                    padding-right: 8px + root.scrollbar-width;
                    spacing: 4px;
                    alignment: start;

                    // --- Top-level actions ---

                    Button {
                        text: "Set as Wallpaper";
                        min-width: 0;
                        clicked => { root.set-wallpaper(); }
                        Tooltip {
                            Hint { text: "Render one frame at the desktop's own resolution and put it on the desktop."; }
                        }
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        Button {
                            text: "Load Defaults";
                            min-width: 0;
                            preferred-width: 0;
                            clicked => { root.load-defaults(); }
                            Tooltip {
                                Hint { text: "Put every setting back to the value the app ships with."; }
                            }
                        }
                        Button {
                            text: "Reset";
                            min-width: 0;
                            preferred-width: 0;
                            clicked => { root.reset(); }
                            Tooltip {
                                Hint { text: "Throw away the changes made since the last save and reload the stored settings."; }
                            }
                        }
                    }

                    // --- Auto-refresh ---

                    SettingCheck {
                        text: "Auto-refresh wallpaper";
                        hint: "Set the wallpaper again on a timer, so the sunlit half of the globe keeps up with the real one.";
                        checked <=> root.auto-refresh-enabled;
                        toggled => { root.auto-refresh-changed(); }
                    }

                    if root.auto-refresh-enabled : HorizontalLayout {
                        spacing: 4px;
                        padding-left: 24px;
                        Slider {
                            minimum: 1;
                            maximum: 30;
                            value <=> root.auto-refresh-interval;
                            changed(value) => { root.auto-refresh-interval-moved(); }
                            released(value) => { root.auto-refresh-changed(); }
                            Tooltip {
                                Hint { text: "How long between one wallpaper render and the next."; }
                            }
                        }
                        Text {
                            text: "every " + round(root.auto-refresh-interval) + " min";
                            vertical-alignment: center;
                        }
                    }

                    // --- 3x3 preset grid ---

                    Rectangle { height: 8px; }

                    Text {
                        text: "Presets";
                        font-weight: 700;
                        horizontal-alignment: center;
                    }

                    GridLayout {
                        spacing: 4px;
                        Row {
                            Button {
                                text: "Africa";
                                min-width: 0;
                                preferred-width: 0;
                                clicked => { root.apply-preset(3); }
                            }
                            Button {
                                text: "N. America";
                                min-width: 0;
                                preferred-width: 0;
                                clicked => { root.apply-preset(1); }
                            }
                            Button {
                                text: "S. America";
                                min-width: 0;
                                preferred-width: 0;
                                clicked => { root.apply-preset(2); }
                            }
                        }
                        Row {
                            Button {
                                text: "Asia";
                                min-width: 0;
                                preferred-width: 0;
                                clicked => { root.apply-preset(4); }
                            }
                            Button {
                                text: "Europe";
                                min-width: 0;
                                preferred-width: 0;
                                clicked => { root.apply-preset(0); }
                            }
                            Button {
                                text: "Oceania";
                                min-width: 0;
                                preferred-width: 0;
                                clicked => { root.apply-preset(5); }
                            }
                        }
                        Row {
                            Button {
                                text: "Pacific";
                                min-width: 0;
                                preferred-width: 0;
                                clicked => { root.apply-preset(6); }
                            }
                            Button {
                                text: "Blue Marble";
                                min-width: 0;
                                preferred-width: 0;
                                clicked => { root.apply-preset(7); }
                            }
                            Button {
                                text: "Earthrise";
                                min-width: 0;
                                preferred-width: 0;
                                clicked => { root.apply-preset(8); }
                            }
                        }
                    }

                    // --- Displays ---
                    //
                    // Hidden on a session with one screen, where three modes all
                    // mean the same thing. The setting still persists, so unplugging
                    // a second screen and plugging it back in does not lose it.

                    if root.display-tiles.length > 1 : VerticalLayout {
                        spacing: 4px;

                        Rectangle { height: 8px; }

                        Text {
                            text: "Displays";
                            font-weight: 700;
                            horizontal-alignment: center;
                        }

                        display-mode-combo := SettingCombo {
                            label: "Mode";
                            hint: "How the screens relate. One screen: only the screen below gets a wallpaper and the rest keep theirs. Mirror: every screen gets the same view, rendered at its own size and shape. Extend: one continuous view is spread across all of them.";
                            label-width: 52px;
                            model: root.display-mode-options;
                            current-index <=> root.display-mode-index;
                            selected => { root.display-plan-changed(); }
                        }

                        display-screen-combo := SettingCombo {
                            label: "Screen";
                            hint: "Which screen gets the picture in one-screen mode, and which screen the view is centered on in the other two.";
                            label-width: 52px;
                            model: root.display-screen-options;
                            current-index <=> root.display-anchor-index;
                            selected => { root.display-plan-changed(); }
                        }

                        Rectangle {
                            height: 88px;
                            background: Palette.background.darker(0.15);
                            border-radius: 4px;

                            board := Rectangle {
                                width: min(parent.width - 12px, (parent.height - 12px) * root.display-aspect);
                                height: self.width / root.display-aspect;

                                for tile in root.display-tiles : Rectangle {
                                    x: board.width * tile.x;
                                    y: board.height * tile.y;
                                    width: board.width * tile.width;
                                    height: board.height * tile.height;
                                    background: tile.anchor ? Palette.accent-background : Palette.background;
                                    border-width: 1px;
                                    border-color: Palette.background.darker(0.4);
                                    border-radius: 2px;

                                    Text {
                                        text: tile.label;
                                        font-size: 10px;
                                        color: tile.anchor ? Palette.accent-foreground : Palette.foreground;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }
                                }
                            }
                        }
                    }

                    // --- Advanced toggle ---

                    Rectangle { height: 8px; }

                    TouchArea {
                        height: 24px;
                        clicked => { root.advanced-open = !root.advanced-open; }

                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: root.advanced-open ? "\u{25bc}" : "\u{25b6}";
                                vertical-alignment: center;
                                font-size: 11px;
                            }
                            Text {
                                text: "Advanced";
                                vertical-alignment: center;
                                font-weight: 700;
                            }
                        }
                    }

                    // --- Collapsible advanced section ---

                    if root.advanced-open :
                    VerticalLayout {
                        spacing: 4px;

                        SettingGroup {
                            title: "Rendering";
                            VerticalLayout {
                                spacing: 4px;

                                SettingCombo {
                                    label: "Surface";
                                    hint: "What the globe shows: the procedural grid under the real Sun, the day map lit everywhere, the night map everywhere, or the two blended across the terminator by the Sun's position.";
                                    model: texture-options;
                                    current-index <=> root.texture-index;
                                    selected => { root.texture-changed(); }
                                }

                                SettingCombo {
                                    label: "Resolution";
                                    hint: "How fine the surface gets: 8192 loads the finest tiles, 4096 the next level, 2048 the base cube alone. Lower costs less memory and takes effect without a restart.";
                                    model: texture-resolution-options;
                                    current-index <=> root.texture-resolution-index;
                                    selected => { root.texture-resolution-changed(); }
                                }

                                SettingCombo {
                                    label: "Anti-aliasing";
                                    hint: "How many samples each pixel is rendered from, which is what smooths the globe's edge and the star sprites.";
                                    model: aa-options;
                                    current-index <=> root.aa-index;
                                    selected => { root.msaa-changed(); }
                                }

                                // One line, whatever the adapter calls itself,
                                // with the whole name on hover. Wrapping this
                                // would read better, but a wrapped Text inside
                                // an `if` reports the height of one line
                                // however many it takes, and a scroll area
                                // sized from that cuts the rest off.
                                adapter-line := Text {
                                    text: renderer-info;
                                    color: #888888;
                                    font-size: 11px;
                                    overflow: elide;
                                    min-width: 0;

                                    Tooltip {
                                        Hint { text: root.renderer-info; }
                                    }
                                }
                            }
                        }

                        SettingGroup {
                            title: "Camera Position";
                            VerticalLayout {
                                spacing: 4px;

                                SettingCheck {
                                    text: "Fixed toward the Sun";
                                    hint: "Keeps the camera where it is relative to the Sun, so the Earth turns beneath it once a day and the lighting it shows stays the same.";
                                    checked <=> root.camera-position.sun-fixed;
                                    toggled => { root.camera-frame-toggled(); }
                                }

                                if !root.camera-position.sun-fixed : longitude-slider := SettingRow {
                                    label: "Longitude";
                                    hint: "The meridian the camera hangs above, which is what turns the globe left and right.";
                                    minimum: -180;
                                    maximum: 180;
                                    value <=> root.camera-position.longitude;
                                    resettable: false;
                                    value-text: round(root.camera-position.longitude) + "°";
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }

                                if root.camera-position.sun-fixed : solar-time-slider := SettingRow {
                                    label: "Time of day";
                                    hint: "The local solar time beneath the camera, which decides the side of the Earth it faces: 12:00 looks at noon, 00:00 at midnight. The Earth turns beneath it while the time stays.";
                                    minimum: 0;
                                    maximum: 24;
                                    value <=> root.camera-position.solar-time;
                                    resettable: false;
                                    value-text: root.solar-time-label;
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }

                                latitude-slider := SettingRow {
                                    label: "Latitude";
                                    hint: "How far north or south of the equator the camera hangs, from one pole to the other.";
                                    minimum: -89;
                                    maximum: 89;
                                    value <=> root.camera-position.latitude;
                                    resettable: false;
                                    value-text: round(root.camera-position.latitude) + "°";
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }

                                zoom-slider := SettingRow {
                                    label: "Zoom";
                                    hint: "Distance from the Earth's centre in Earth radii, mapped exponentially so both ends of the slider stay useful.";
                                    minimum: 0.0;
                                    maximum: 1.0;
                                    value <=> root.camera-position.zoom;
                                    resettable: false;
                                    value-text: round(root.zoom-display-distance * 10) / 10;
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }
                            }
                        }

                        SettingGroup {
                            title: "Camera Orientation";
                            modified: root.camera-orientation != root.defaults.camera-orientation;
                            reset => {
                                root.camera-orientation = root.defaults.camera-orientation;
                                root.sliders-changed();
                            }
                            VerticalLayout {
                                spacing: 4px;

                                tilt-slider := SettingRow {
                                    label: "Tilt";
                                    hint: "Rolls the whole frame around the view axis, tipping the poles away from vertical.";
                                    minimum: -180;
                                    maximum: 180;
                                    value <=> root.camera-orientation.tilt;
                                    default-value: root.defaults.camera-orientation.tilt;
                                    value-text: round(root.camera-orientation.tilt) + "°";
                                    value-width: 35px;
                                    changed => {
                                        if root.camera-orientation.tilt > -5 && root.camera-orientation.tilt < 5 {
                                            root.camera-orientation.tilt = 0;
                                        }
                                        root.sliders-changed();
                                    }
                                }

                                yaw-slider := SettingRow {
                                    label: "Yaw";
                                    hint: "Swings the aim point sideways across the globe, so the camera looks off-centre rather than at the middle.";
                                    minimum: -90;
                                    maximum: 90;
                                    value <=> root.camera-orientation.yaw;
                                    default-value: root.defaults.camera-orientation.yaw;
                                    value-text: round(root.camera-orientation.yaw) + "°";
                                    value-width: 35px;
                                    changed => {
                                        if root.camera-orientation.yaw > -3 && root.camera-orientation.yaw < 3 {
                                            root.camera-orientation.yaw = 0;
                                        }
                                        root.sliders-changed();
                                    }
                                }

                                pitch-slider := SettingRow {
                                    label: "Pitch";
                                    hint: "Swings the aim point up or down across the globe, which is what puts the horizon low in the frame.";
                                    minimum: -90;
                                    maximum: 90;
                                    value <=> root.camera-orientation.pitch;
                                    default-value: root.defaults.camera-orientation.pitch;
                                    value-text: round(root.camera-orientation.pitch) + "°";
                                    value-width: 35px;
                                    changed => {
                                        if root.camera-orientation.pitch > -3 && root.camera-orientation.pitch < 3 {
                                            root.camera-orientation.pitch = 0;
                                        }
                                        root.sliders-changed();
                                    }
                                }
                            }
                        }

                        SettingGroup {
                            title: "Framing";
                            modified: root.framing != root.defaults.framing;
                            reset => {
                                root.framing = root.defaults.framing;
                                root.sliders-changed();
                            }
                            VerticalLayout {
                                spacing: 4px;

                                camera-fov-slider := SettingRow {
                                    label: "Field of view";
                                    hint: "How wide the Earth lens is: narrow flattens the globe the way a long lens does, wide exaggerates its curvature. The sky behind it has a lens of its own.";
                                    minimum: 10.0;
                                    maximum: 170.0;
                                    value <=> root.framing.fov;
                                    default-value: root.defaults.framing.fov;
                                    value-text: round(root.framing.fov) + "°";
                                    changed => { root.sliders-changed(); }
                                }

                                offset-x-slider := SettingRow {
                                    label: "Offset X";
                                    hint: "Slides the finished frame left or right without moving the camera.";
                                    minimum: -3.0;
                                    maximum: 3.0;
                                    value <=> root.framing.offset-x;
                                    default-value: root.defaults.framing.offset-x;
                                    value-text: round(root.framing.offset-x * 100) / 100;
                                    value-width: 35px;
                                    changed => {
                                        if root.framing.offset-x > -0.05 && root.framing.offset-x < 0.05 {
                                            root.framing.offset-x = 0;
                                        }
                                        root.sliders-changed();
                                    }
                                }

                                offset-y-slider := SettingRow {
                                    label: "Offset Y";
                                    hint: "Slides the finished frame up or down without moving the camera.";
                                    minimum: -3.0;
                                    maximum: 3.0;
                                    value <=> root.framing.offset-y;
                                    default-value: root.defaults.framing.offset-y;
                                    value-text: round(root.framing.offset-y * 100) / 100;
                                    value-width: 35px;
                                    changed => {
                                        if root.framing.offset-y > -0.05 && root.framing.offset-y < 0.05 {
                                            root.framing.offset-y = 0;
                                        }
                                        root.sliders-changed();
                                    }
                                }
                            }
                        }

                        SettingGroup {
                            title: "Date / Time";
                            modified: root.datetime.use-custom;
                            reset => {
                                root.datetime = root.defaults.datetime;
                                root.sliders-changed();
                            }
                            VerticalLayout {
                                spacing: 4px;

                                SettingCheck {
                                    text: "Override date/time";
                                    hint: "Render a chosen instant instead of the passing one, which freezes the Sun, the Moon and the stars where they were, and stops the Earth turning under a camera fixed toward the Sun.";
                                    checked <=> root.datetime.use-custom;
                                    toggled => { root.datetime-override-toggled(); }
                                }

                                if root.datetime.use-custom :
                                VerticalLayout {
                                    spacing: 4px;

                                    custom-hour-slider := SettingRow {
                                        label: "Hour";
                                        hint: "Time of day in UTC, which is what decides the longitude the Sun stands over, and so the side of the Earth a camera fixed toward the Sun looks at.";
                                        indent: 8px;
                                        minimum: 0.0;
                                        maximum: 23.99;
                                        value <=> root.datetime.hour;
                                        resettable: false;
                                        value-text: root.hour-label;
                                        changed => { root.sliders-changed(); }
                                    }

                                    custom-day-slider := SettingRow {
                                        label: "Day";
                                        hint: "Day of the year, which is what decides the Sun's declination and so the season the terminator shows.";
                                        indent: 8px;
                                        minimum: 1.0;
                                        maximum: root.max-day-of-year;
                                        value <=> root.datetime.day-of-year;
                                        resettable: false;
                                        value-text: root.day-label;
                                        changed => { root.sliders-changed(); }
                                    }

                                    SettingCombo {
                                        label: "Year";
                                        hint: "Which year that day belongs to. The Sun barely notices; the Moon and the planets do.";
                                        indent: 8px;
                                        model: root.year-options;
                                        current-index <=> root.datetime.year-index;
                                        selected => { root.sliders-changed(); }
                                    }
                                }
                            }
                        }

                        SettingGroup {
                            title: "Clouds";
                            modified: root.clouds != root.defaults.clouds;
                            reset => {
                                root.clouds = root.defaults.clouds;
                                root.sliders-changed();
                            }
                            VerticalLayout {
                                spacing: 4px;

                                SettingCheck {
                                    text: "Show clouds";
                                    hint: "Master switch for the cloud layer. While it is off, no new download or decode starts.";
                                    checked <=> root.clouds.enabled;
                                    toggled => { root.sliders-changed(); }
                                }

                                if root.clouds.enabled :
                                VerticalLayout {
                                    spacing: 4px;

                                    cloud-opacity-slider := SettingRow {
                                        label: "Day opacity";
                                        hint: "How strongly the cloud layer covers the sunlit surface underneath it.";
                                        indent: 8px;
                                        minimum: 0.0;
                                        maximum: 1.0;
                                        value <=> root.clouds.opacity;
                                        default-value: root.defaults.clouds.opacity;
                                        value-text: round(root.clouds.opacity * 100) + "%";
                                        value-width: 35px;
                                        changed => { root.sliders-changed(); }
                                    }

                                    cloud-opacity-night-slider := SettingRow {
                                        label: "Night opacity";
                                        hint: "How strongly the cloud layer covers the night surface, where the city lights under it are far brighter than the cloud itself. At the top of the range nothing shines through.";
                                        indent: 8px;
                                        minimum: 0.0;
                                        maximum: 1.0;
                                        value <=> root.clouds.opacity-night;
                                        default-value: root.defaults.clouds.opacity-night;
                                        value-text: round(root.clouds.opacity-night * 100) + "%";
                                        value-width: 35px;
                                        changed => { root.sliders-changed(); }
                                    }

                                    cloud-night-slider := SettingRow {
                                        label: "Night brightness";
                                        hint: "How bright a cloud is on the night hemisphere, where the real light is far too faint to draw at this exposure.";
                                        indent: 8px;
                                        minimum: 0.0;
                                        maximum: 0.6;
                                        value <=> root.clouds.night-brightness;
                                        default-value: root.defaults.clouds.night-brightness;
                                        value-text: round(root.clouds.night-brightness * 100) + "%";
                                        value-width: 35px;
                                        changed => { root.sliders-changed(); }
                                    }

                                    SettingHeading {
                                        text: "Haze removal";
                                        modified: root.clouds.haze != root.defaults.clouds.haze;
                                        reset => {
                                            root.clouds.haze = root.defaults.clouds.haze;
                                            root.sliders-changed();
                                        }
                                    }

                                    cloud-haze-equator-slider := SettingRow {
                                        label: "Toward the equator";
                                        hint: "How much of the grey veil cold clear ground leaves in the source image is taken off, estimated from the map itself region by region. Up to 100% that share of the veil goes; beyond it, also the part of it brighter than the estimate trusts, which is mostly polar ground.";
                                        indent: 8px;
                                        minimum: 0.0;
                                        maximum: 2.0;
                                        value <=> root.clouds.haze.equator;
                                        default-value: root.defaults.clouds.haze.equator;
                                        value-text: round(root.clouds.haze.equator * 100) + "%";
                                        value-width: 35px;
                                        changed => { root.sliders-changed(); }
                                    }

                                    cloud-haze-pole-slider := SettingRow {
                                        label: "Toward the poles";
                                        hint: "The same, poleward of the switch latitude, where cold ground leaves the most veil.";
                                        indent: 8px;
                                        minimum: 0.0;
                                        maximum: 2.0;
                                        value <=> root.clouds.haze.pole;
                                        default-value: root.defaults.clouds.haze.pole;
                                        value-text: round(root.clouds.haze.pole * 100) + "%";
                                        value-width: 35px;
                                        changed => { root.sliders-changed(); }
                                    }

                                    cloud-haze-latitude-slider := SettingRow {
                                        label: "Switch latitude";
                                        hint: "Where the haze removal changes from its value toward the equator to its value toward the poles, at the middle of the blend.";
                                        indent: 8px;
                                        minimum: 20.0;
                                        maximum: 80.0;
                                        value <=> root.clouds.haze.latitude;
                                        default-value: root.defaults.clouds.haze.latitude;
                                        value-text: round(root.clouds.haze.latitude) + "°";
                                        value-width: 35px;
                                        changed => { root.sliders-changed(); }
                                    }

                                    cloud-haze-band-slider := SettingRow {
                                        label: "Blend width";
                                        hint: "How many degrees of latitude the change from one haze removal to the other is spread over, centered on the switch latitude.";
                                        indent: 8px;
                                        minimum: 5.0;
                                        maximum: 90.0;
                                        value <=> root.clouds.haze.band;
                                        default-value: root.defaults.clouds.haze.band;
                                        value-text: round(root.clouds.haze.band) + "°";
                                        value-width: 35px;
                                        changed => { root.sliders-changed(); }
                                    }

                                    SettingHeading {
                                        text: "Land";
                                        modified: root.clouds.land != root.defaults.clouds.land;
                                        reset => {
                                            root.clouds.land = root.defaults.clouds.land;
                                            root.sliders-changed();
                                        }
                                    }

                                    cloud-floor-land-slider := SettingRow {
                                        label: "Floor";
                                        hint: "Brightness below which what is left of a cloud pixel after the haze removal counts as clear sky.";
                                        indent: 8px;
                                        minimum: 0.0;
                                        maximum: 0.5;
                                        value <=> root.clouds.land.floor;
                                        default-value: root.defaults.clouds.land.floor;
                                        value-text: round(root.clouds.land.floor * 100) + "%";
                                        value-width: 35px;
                                        changed => { root.sliders-changed(); }
                                    }

                                    cloud-gamma-land-slider := SettingRow {
                                        label: "Gamma";
                                        hint: "Contrast curve of the cloud layer: below one keeps only the dense tops, above one lifts the thin cloud.";
                                        indent: 8px;
                                        minimum: 0.1;
                                        maximum: 2.0;
                                        value <=> root.clouds.land.gamma;
                                        default-value: root.defaults.clouds.land.gamma;
                                        value-text: round(root.clouds.land.gamma * 100) / 100;
                                        value-width: 35px;
                                        changed => { root.sliders-changed(); }
                                    }

                                    SettingHeading {
                                        text: "Ocean";
                                        modified: root.clouds.ocean != root.defaults.clouds.ocean;
                                        reset => {
                                            root.clouds.ocean = root.defaults.clouds.ocean;
                                            root.sliders-changed();
                                        }
                                    }

                                    cloud-floor-ocean-slider := SettingRow {
                                        label: "Floor";
                                        hint: "Brightness below which what is left of a cloud pixel after the haze removal counts as clear sky.";
                                        indent: 8px;
                                        minimum: 0.0;
                                        maximum: 0.5;
                                        value <=> root.clouds.ocean.floor;
                                        default-value: root.defaults.clouds.ocean.floor;
                                        value-text: round(root.clouds.ocean.floor * 100) + "%";
                                        value-width: 35px;
                                        changed => { root.sliders-changed(); }
                                    }

                                    cloud-gamma-ocean-slider := SettingRow {
                                        label: "Gamma";
                                        hint: "Contrast curve of the cloud layer: below one keeps only the dense tops, above one lifts the thin cloud.";
                                        indent: 8px;
                                        minimum: 0.1;
                                        maximum: 2.0;
                                        value <=> root.clouds.ocean.gamma;
                                        default-value: root.defaults.clouds.ocean.gamma;
                                        value-text: round(root.clouds.ocean.gamma * 100) / 100;
                                        value-width: 35px;
                                        changed => { root.sliders-changed(); }
                                    }
                                }
                            }
                        }

                        SettingGroup {
                            title: "Celestial";
                            modified: root.celestial != root.defaults.celestial;
                            reset => {
                                root.celestial = root.defaults.celestial;
                                root.sliders-changed();
                            }
                            VerticalLayout {
                                spacing: 4px;

                                SettingHeading {
                                    text: "Sky";
                                    modified: root.celestial.sky != root.defaults.celestial.sky;
                                    reset => {
                                        root.celestial.sky = root.defaults.celestial.sky;
                                        root.sliders-changed();
                                    }
                                }

                                sky-fov-slider := SettingRow {
                                    label: "Field of view";
                                    hint: "How much sky the background lens covers, which is what sets the scale of the constellations and the Milky Way.";
                                    indent: 8px;
                                    minimum: root.sky-fov-minimum;
                                    maximum: root.sky-fov-maximum;
                                    value <=> root.celestial.sky.fov;
                                    default-value: root.defaults.celestial.sky.fov;
                                    value-text: round(root.celestial.sky.fov) + "°";
                                    changed => { root.sliders-changed(); }
                                }

                                milky-way-intensity-slider := SettingRow {
                                    label: "Milky Way";
                                    hint: "Brightness of the diffuse galactic band behind the stars. Zero leaves it out of the frame.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 2.0;
                                    value <=> root.celestial.sky.milky-way;
                                    default-value: root.defaults.celestial.sky.milky-way;
                                    value-text: round(root.celestial.sky.milky-way * 100) / 100 + "×";
                                    changed => { root.sliders-changed(); }
                                }

                                SettingHeading {
                                    text: "Sun";
                                    modified: root.celestial.sun != root.defaults.celestial.sun;
                                    reset => {
                                        root.celestial.sun = root.defaults.celestial.sun;
                                        root.sliders-changed();
                                    }
                                }

                                sun-glow-slider := SettingRow {
                                    label: "Glare";
                                    hint: "Master strength of the Sun's glare, and the switch for the Sun itself: at zero neither the disk nor the glare is drawn.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 3.0;
                                    value <=> root.celestial.sun.glow;
                                    default-value: root.defaults.celestial.sun.glow;
                                    value-text: round(root.celestial.sun.glow * 100) / 100 + "×";
                                    changed => { root.sliders-changed(); }
                                }

                                sun-rays-slider := SettingRow {
                                    label: "Rays";
                                    hint: "Strength of the fine radial needles the eye itself adds around a bright source.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 2.0;
                                    value <=> root.celestial.sun.rays;
                                    default-value: root.defaults.celestial.sun.rays;
                                    value-text: round(root.celestial.sun.rays * 100) + "%";
                                    changed => { root.sliders-changed(); }
                                }

                                sun-size-slider := SettingRow {
                                    label: "Size";
                                    hint: "Multiplies the Sun's radius above its true half degree, the way the Moon's does. The glare's inner lobe grows with it and the rest of it does not.";
                                    indent: 8px;
                                    minimum: 1.0;
                                    maximum: 8.0;
                                    value <=> root.celestial.sun.size;
                                    default-value: root.defaults.celestial.sun.size;
                                    value-text: round(root.celestial.sun.size * 10) / 10 + "×";
                                    changed => { root.sliders-changed(); }
                                }

                                sun-halo-radius-slider := SettingRow {
                                    label: "Halo radius";
                                    hint: "Angular radius of the faint colored ring around the glare.";
                                    indent: 8px;
                                    minimum: 1.5;
                                    maximum: 8.0;
                                    value <=> root.celestial.sun.halo-radius;
                                    default-value: root.defaults.celestial.sun.halo-radius;
                                    value-text: round(root.celestial.sun.halo-radius * 10) / 10 + "°";
                                    changed => { root.sliders-changed(); }
                                }

                                sun-flare-slider := SettingRow {
                                    label: "Lens flare";
                                    hint: "Aperture spikes and lens ghosts, which belong to a camera rather than to an eye.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 1.0;
                                    value <=> root.celestial.sun.flare;
                                    default-value: root.defaults.celestial.sun.flare;
                                    value-text: round(root.celestial.sun.flare * 100) + "%";
                                    changed => { root.sliders-changed(); }
                                }

                                sun-horizon-boost-slider := SettingRow {
                                    label: "Sunrise glare";
                                    hint: "How much brighter the glare peaks as the disk clears the horizon, before the eye adjusts. One is the physical answer.";
                                    indent: 8px;
                                    minimum: 1.0;
                                    maximum: 8.0;
                                    value <=> root.celestial.sun.horizon-boost;
                                    default-value: root.defaults.celestial.sun.horizon-boost;
                                    value-text: round(root.celestial.sun.horizon-boost * 10) / 10 + "×";
                                    changed => { root.sliders-changed(); }
                                }

                                sun-horizon-reach-slider := SettingRow {
                                    label: "Adaptation";
                                    hint: "How far above the horizon, in horizon depths, the eye takes to settle back to normal.";
                                    indent: 8px;
                                    minimum: 0.5;
                                    maximum: 10.0;
                                    value <=> root.celestial.sun.horizon-reach;
                                    default-value: root.defaults.celestial.sun.horizon-reach;
                                    value-text: round(root.celestial.sun.horizon-reach * 10) / 10;
                                    changed => { root.sliders-changed(); }
                                }

                                sun-horizon-depth-slider := SettingRow {
                                    label: "Horizon depth";
                                    hint: "Thickness of the horizon zone in Sun diameters. Zero uses the painted atmosphere alone.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 4.0;
                                    value <=> root.celestial.sun.horizon-depth;
                                    default-value: root.defaults.celestial.sun.horizon-depth;
                                    value-text: round(root.celestial.sun.horizon-depth * 10) / 10;
                                    changed => { root.sliders-changed(); }
                                }

                                sun-reddening-slider := SettingRow {
                                    label: "Reddening";
                                    hint: "How much the low atmosphere colors the disk and the glare. One is the measured atmosphere. The warm band it spreads along the limb is the Atmosphere group's Sunrise band.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 2.0;
                                    value <=> root.celestial.sun.reddening;
                                    default-value: root.defaults.celestial.sun.reddening;
                                    value-text: round(root.celestial.sun.reddening * 100) + "%";
                                    changed => { root.sliders-changed(); }
                                }

                                sun-refraction-slider := SettingRow {
                                    label: "Refraction";
                                    hint: "Lifts and flattens the disk at the horizon the way the atmosphere bends its light.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 2.0;
                                    value <=> root.celestial.sun.refraction;
                                    default-value: root.defaults.celestial.sun.refraction;
                                    value-text: round(root.celestial.sun.refraction * 100) + "%";
                                    changed => { root.sliders-changed(); }
                                }

                                SettingHeading {
                                    text: "Moon";
                                    modified: root.celestial.moon != root.defaults.celestial.moon;
                                    reset => {
                                        root.celestial.moon = root.defaults.celestial.moon;
                                        root.sliders-changed();
                                    }
                                }

                                moon-brightness-slider := SettingRow {
                                    label: "Brightness";
                                    hint: "Brightness of the Moon's sunlit face, and the switch for the Moon itself: zero draws nothing.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 3.0;
                                    value <=> root.celestial.moon.brightness;
                                    default-value: root.defaults.celestial.moon.brightness;
                                    value-text: round(root.celestial.moon.brightness * 100) / 100 + "×";
                                    changed => { root.sliders-changed(); }
                                }

                                moon-size-slider := SettingRow {
                                    label: "Size";
                                    hint: "Multiplies the Moon's radius above its true half degree. A narrower sky field of view magnifies it honestly instead.";
                                    indent: 8px;
                                    minimum: 1.0;
                                    maximum: 8.0;
                                    value <=> root.celestial.moon.size;
                                    default-value: root.defaults.celestial.moon.size;
                                    value-text: round(root.celestial.moon.size * 10) / 10 + "×";
                                    changed => { root.sliders-changed(); }
                                }

                                moon-earthshine-slider := SettingRow {
                                    label: "Earthshine";
                                    hint: "Floor under the Moon's unlit face, so a new moon does not disappear altogether.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 0.5;
                                    value <=> root.celestial.moon.earthshine;
                                    default-value: root.defaults.celestial.moon.earthshine;
                                    value-text: round(root.celestial.moon.earthshine * 100) + "%";
                                    changed => { root.sliders-changed(); }
                                }

                                SettingHeading {
                                    text: "Stars";
                                    modified: root.celestial.stars != root.defaults.celestial.stars;
                                    reset => {
                                        root.celestial.stars = root.defaults.celestial.stars;
                                        root.sliders-changed();
                                    }
                                }

                                star-intensity-slider := SettingRow {
                                    label: "Brightness";
                                    hint: "Display gain for the stars and the naked-eye planets, and the switch for both: zero leaves the sky empty.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 5.0;
                                    value <=> root.celestial.stars.intensity;
                                    default-value: root.defaults.celestial.stars.intensity;
                                    value-text: round(root.celestial.stars.intensity * 100) / 100 + "×";
                                    changed => { root.sliders-changed(); }
                                }

                                star-size-slider := SettingRow {
                                    label: "Size";
                                    hint: "Multiplies the compact core of each star, leaving its halo to the two glow sliders.";
                                    indent: 8px;
                                    minimum: 0.5;
                                    maximum: 3.0;
                                    value <=> root.celestial.stars.size;
                                    default-value: root.defaults.celestial.stars.size;
                                    value-text: round(root.celestial.stars.size * 100) / 100 + "×";
                                    changed => { root.sliders-changed(); }
                                }

                                star-glow-strength-slider := SettingRow {
                                    label: "Glow strength";
                                    hint: "How pronounced the soft halo around the brighter stars is.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 3.0;
                                    value <=> root.celestial.stars.glow-strength;
                                    default-value: root.defaults.celestial.stars.glow-strength;
                                    value-text: round(root.celestial.stars.glow-strength * 100) + "%";
                                    changed => { root.sliders-changed(); }
                                }

                                star-glow-radius-slider := SettingRow {
                                    label: "Glow radius";
                                    hint: "How far that halo reaches, in pixels at 1080p; a larger frame scales it up on its own.";
                                    indent: 8px;
                                    minimum: 1.0;
                                    maximum: 30.0;
                                    value <=> root.celestial.stars.glow-radius;
                                    default-value: root.defaults.celestial.stars.glow-radius;
                                    value-text: round(root.celestial.stars.glow-radius * 10) / 10 + " px";
                                    changed => { root.sliders-changed(); }
                                }

                                star-contrast-slider := SettingRow {
                                    label: "Contrast";
                                    hint: "Separation between bright and faint stars; below zero they even out, above zero the bright ones pull away.";
                                    indent: 8px;
                                    minimum: -1.0;
                                    maximum: 1.0;
                                    value <=> root.celestial.stars.contrast;
                                    default-value: root.defaults.celestial.stars.contrast;
                                    value-text: round(root.celestial.stars.contrast * 100) + "%";
                                    changed => { root.sliders-changed(); }
                                }

                                star-mag-limit-slider := SettingRow {
                                    label: "Faintest";
                                    hint: "Dimmest apparent magnitude still drawn. The naked eye reaches about 6 under a dark sky, and the catalog stops at 7.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 7.0;
                                    value <=> root.celestial.stars.mag-limit;
                                    default-value: root.defaults.celestial.stars.mag-limit;
                                    value-text: round(root.celestial.stars.mag-limit * 10) / 10;
                                    changed => { root.sliders-changed(); }
                                }
                            }
                        }

                        SettingGroup {
                            title: "Atmosphere";
                            modified: root.atmosphere != root.defaults.atmosphere;
                            reset => {
                                root.atmosphere = root.defaults.atmosphere;
                                root.sliders-changed();
                            }
                            VerticalLayout {
                                spacing: 4px;

                                SettingCheck {
                                    text: "Atmosphere glow";
                                    hint: "Master switch for the three glowing shells around the globe.";
                                    checked <=> root.atmosphere.enabled;
                                    toggled => { root.sliders-changed(); }
                                }

                                if root.atmosphere.enabled :
                                VerticalLayout {
                                    spacing: 4px;

                                    SettingHeading {
                                        text: "Rayleigh";
                                        modified: root.atmosphere.rayleigh != root.defaults.atmosphere.rayleigh;
                                        reset => {
                                            root.atmosphere.rayleigh = root.defaults.atmosphere.rayleigh;
                                            root.sliders-changed();
                                        }
                                    }

                                    rayleigh-intensity-slider := SettingRow {
                                        label: "Intensity";
                                        hint: "Strength of the blue scattering halo that rings the daylit limb.";
                                        indent: 8px;
                                        minimum: 0.0;
                                        maximum: 1.0;
                                        value <=> root.atmosphere.rayleigh.intensity;
                                        default-value: root.defaults.atmosphere.rayleigh.intensity;
                                        value-text: round(root.atmosphere.rayleigh.intensity * 100) + "%";
                                        value-width: 35px;
                                        changed => { root.sliders-changed(); }
                                    }

                                    rayleigh-sharpness-slider := SettingRow {
                                        label: "Sharpness";
                                        hint: "How tightly that halo hugs the limb; higher leaves a thinner, harder band.";
                                        indent: 8px;
                                        minimum: 10.0;
                                        maximum: 100.0;
                                        value <=> root.atmosphere.rayleigh.sharpness;
                                        default-value: root.defaults.atmosphere.rayleigh.sharpness;
                                        value-text: round(root.atmosphere.rayleigh.sharpness * 10) / 10;
                                        value-width: 35px;
                                        changed => { root.sliders-changed(); }
                                    }

                                    rayleigh-haze-slider := SettingRow {
                                        label: "Haze";
                                        hint: "How far the scattering bleeds inward over the disc itself rather than sitting on its edge.";
                                        indent: 8px;
                                        minimum: 0.0;
                                        maximum: 1.0;
                                        value <=> root.atmosphere.rayleigh.haze;
                                        default-value: root.defaults.atmosphere.rayleigh.haze;
                                        value-text: round(root.atmosphere.rayleigh.haze * 100) + "%";
                                        value-width: 35px;
                                        changed => { root.sliders-changed(); }
                                    }

                                    SettingHeading {
                                        text: "Sunrise band";
                                        modified: root.atmosphere.sunrise != root.defaults.atmosphere.sunrise;
                                        reset => {
                                            root.atmosphere.sunrise = root.defaults.atmosphere.sunrise;
                                            root.sliders-changed();
                                        }
                                    }

                                    atmo-sunrise-glow-slider := SettingRow {
                                        label: "Brightness";
                                        hint: "Brightness of the warm band the atmosphere takes around a rising or setting Sun.";
                                        indent: 8px;
                                        minimum: 0.0;
                                        maximum: 3.0;
                                        value <=> root.atmosphere.sunrise.glow;
                                        default-value: root.defaults.atmosphere.sunrise.glow;
                                        value-text: round(root.atmosphere.sunrise.glow * 100) / 100 + "×";
                                        value-width: 35px;
                                        changed => { root.sliders-changed(); }
                                    }

                                    atmo-sunrise-width-slider := SettingRow {
                                        label: "Band width";
                                        hint: "How far along the horizon that band reaches from the Sun.";
                                        indent: 8px;
                                        minimum: 10.0;
                                        maximum: 90.0;
                                        value <=> root.atmosphere.sunrise.width;
                                        default-value: root.defaults.atmosphere.sunrise.width;
                                        value-text: round(root.atmosphere.sunrise.width) + "°";
                                        value-width: 35px;
                                        changed => { root.sliders-changed(); }
                                    }

                                    SettingHeading {
                                        text: "Nightglow";
                                        modified: root.atmosphere.nightglow != root.defaults.atmosphere.nightglow;
                                        reset => {
                                            root.atmosphere.nightglow = root.defaults.atmosphere.nightglow;
                                            root.sliders-changed();
                                        }
                                    }

                                    nightglow-intensity-slider := SettingRow {
                                        label: "Intensity";
                                        hint: "Strength of the faint airglow that traces the night limb.";
                                        indent: 8px;
                                        minimum: 0.0;
                                        maximum: 1.0;
                                        value <=> root.atmosphere.nightglow.intensity;
                                        default-value: root.defaults.atmosphere.nightglow.intensity;
                                        value-text: round(root.atmosphere.nightglow.intensity * 100) + "%";
                                        value-width: 35px;
                                        changed => { root.sliders-changed(); }
                                    }

                                    nightglow-balance-slider := SettingRow {
                                        label: "Balance";
                                        hint: "Mix between the orange sodium band and the green oxygen band of that airglow.";
                                        indent: 8px;
                                        minimum: 0.0;
                                        maximum: 1.0;
                                        value <=> root.atmosphere.nightglow.balance;
                                        default-value: root.defaults.atmosphere.nightglow.balance;
                                        value-text: root.atmosphere.nightglow.balance <= 0.01 ? "orange" :
                                                    root.atmosphere.nightglow.balance >= 0.99 ? "green" :
                                                    round(root.atmosphere.nightglow.balance * 100) / 100;
                                        value-width: 35px;
                                        changed => { root.sliders-changed(); }
                                    }

                                    nightglow-falloff-slider := SettingRow {
                                        label: "Falloff";
                                        hint: "How quickly the airglow fades with distance from the limb.";
                                        indent: 8px;
                                        minimum: 2.0;
                                        maximum: 50.0;
                                        value <=> root.atmosphere.nightglow.falloff;
                                        default-value: root.defaults.atmosphere.nightglow.falloff;
                                        value-text: round(root.atmosphere.nightglow.falloff * 10) / 10;
                                        value-width: 35px;
                                        changed => { root.sliders-changed(); }
                                    }
                                }
                            }
                        }

                        SettingGroup {
                            title: "Lighting";
                            modified: root.lighting != root.defaults.lighting;
                            reset => {
                                root.lighting = root.defaults.lighting;
                                root.sliders-changed();
                            }
                            VerticalLayout {
                                spacing: 4px;

                                terminator-slider := SettingRow {
                                    label: "Terminator";
                                    hint: "Width of the blend between the day and night maps across the day/night boundary.";
                                    minimum: 0.01;
                                    maximum: 0.3;
                                    value <=> root.lighting.terminator-width;
                                    default-value: root.defaults.lighting.terminator-width;
                                    value-text: round(root.lighting.terminator-width * 1000) / 1000;
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }

                                SettingCheck {
                                    text: "Dayside shading";
                                    hint: "Shade the daylit half by the Sun's angle instead of laying the map on flat.";
                                    checked <=> root.lighting.diffuse-shading;
                                    toggled => { root.sliders-changed(); }
                                }

                                diffuse-floor-slider := SettingRow {
                                    label: "Floor";
                                    hint: "How bright the dimmest shaded daylight still is, so the approach to the terminator does not go black.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 1.0;
                                    value <=> root.lighting.diffuse-floor;
                                    default-value: root.defaults.lighting.diffuse-floor;
                                    value-text: round(root.lighting.diffuse-floor * 100) / 100;
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }

                                diffuse-ramp-slider := SettingRow {
                                    label: "Ramp";
                                    hint: "How quickly that shading falls off as the surface turns away from the Sun.";
                                    indent: 8px;
                                    minimum: 0.1;
                                    maximum: 1.0;
                                    value <=> root.lighting.diffuse-ramp;
                                    default-value: root.defaults.lighting.diffuse-ramp;
                                    value-text: round(root.lighting.diffuse-ramp * 100) / 100;
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }

                                spec-shininess-slider := SettingRow {
                                    label: "Shininess";
                                    hint: "Tightness of the specular highlight the Sun leaves on the oceans; higher makes a smaller, harder glint.";
                                    minimum: 10;
                                    maximum: 500;
                                    value <=> root.lighting.spec-shininess;
                                    default-value: root.defaults.lighting.spec-shininess;
                                    value-text: round(root.lighting.spec-shininess);
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }

                                spec-intensity-slider := SettingRow {
                                    label: "Glint";
                                    hint: "Strength of that specular highlight.";
                                    minimum: 0.0;
                                    maximum: 1.0;
                                    value <=> root.lighting.spec-intensity;
                                    default-value: root.defaults.lighting.spec-intensity;
                                    value-text: round(root.lighting.spec-intensity * 100) / 100;
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }

                                fresnel-mix-slider := SettingRow {
                                    label: "Fresnel mix";
                                    hint: "How much the ocean brightens where it turns away from the camera, the way water does at a glancing angle.";
                                    minimum: 0.0;
                                    maximum: 1.0;
                                    value <=> root.lighting.fresnel-mix;
                                    default-value: root.defaults.lighting.fresnel-mix;
                                    value-text: round(root.lighting.fresnel-mix * 100) / 100;
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }

                                fresnel-exp-slider := SettingRow {
                                    label: "Fresnel extent";
                                    hint: "How far in from the limb that glancing-angle brightening reaches.";
                                    minimum: 1.0;
                                    maximum: 8.0;
                                    value <=> root.lighting.fresnel-exp;
                                    default-value: root.defaults.lighting.fresnel-exp;
                                    value-text: round(root.lighting.fresnel-exp * 10) / 10;
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }
                            }
                        }

                        SettingGroup {
                            title: "Color Correction";
                            modified: root.color-correction != root.defaults.color-correction;
                            reset => {
                                root.color-correction = root.defaults.color-correction;
                                root.sliders-changed();
                            }
                            VerticalLayout {
                                spacing: 4px;

                                SettingHeading {
                                    text: "Day Texture";
                                    modified: root.color-correction.day != root.defaults.color-correction.day;
                                    reset => {
                                        root.color-correction.day = root.defaults.color-correction.day;
                                        root.sliders-changed();
                                    }
                                }

                                day-ocean-color := SettingColor {
                                    label: "Ocean";
                                    hint: "Base color of open water on the day map, before gamma, saturation and lighting. Sea ice keeps its own color.";
                                    indent: 8px;
                                    value <=> root.color-correction.day.ocean;
                                    default-value: root.defaults.color-correction.day.ocean;
                                    changed => { root.sliders-changed(); }
                                }

                                day-gamma-slider := SettingRow {
                                    label: "Gamma";
                                    hint: "Brightness curve of the daylit surface map; below one lifts the shadows, above one deepens them.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 1.0;
                                    value <=> root.color-correction.day.gamma;
                                    default-value: root.defaults.color-correction.day.gamma;
                                    value-text: round(root.day-gamma-value * 100) / 100;
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }

                                day-saturation-slider := SettingRow {
                                    label: "Saturation";
                                    hint: "Colour intensity of the daylit surface map; zero is greyscale.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 2.0;
                                    value <=> root.color-correction.day.saturation;
                                    default-value: root.defaults.color-correction.day.saturation;
                                    value-text: round(root.color-correction.day.saturation * 100) / 100;
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }

                                SettingHeading {
                                    text: "Night Texture";
                                    modified: root.color-correction.night != root.defaults.color-correction.night;
                                    reset => {
                                        root.color-correction.night = root.defaults.color-correction.night;
                                        root.sliders-changed();
                                    }
                                }

                                night-ocean-color := SettingColor {
                                    label: "Ocean";
                                    hint: "Base color of open water on the night map, before gamma and saturation. Lights at sea and sea ice keep their own colors.";
                                    indent: 8px;
                                    value <=> root.color-correction.night.ocean;
                                    default-value: root.defaults.color-correction.night.ocean;
                                    changed => { root.sliders-changed(); }
                                }

                                night-gamma-slider := SettingRow {
                                    label: "Gamma";
                                    hint: "Brightness curve of the city-lights map; below one brings out the sparse lights, above one keeps only the cities.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 1.0;
                                    value <=> root.color-correction.night.gamma;
                                    default-value: root.defaults.color-correction.night.gamma;
                                    value-text: round(root.night-gamma-value * 100) / 100;
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }

                                night-saturation-slider := SettingRow {
                                    label: "Saturation";
                                    hint: "Colour intensity of the city-lights map; zero is greyscale.";
                                    indent: 8px;
                                    minimum: 0.0;
                                    maximum: 2.0;
                                    value <=> root.color-correction.night.saturation;
                                    default-value: root.defaults.color-correction.night.saturation;
                                    value-text: round(root.color-correction.night.saturation * 100) / 100;
                                    value-width: 35px;
                                    changed => { root.sliders-changed(); }
                                }
                            }
                        }

                    }
                }
            }

            HorizontalLayout {
                padding: 8px;
                vertical-stretch: 0;

                about-button := Button {
                    text: "About";
                    min-width: 0;
                    clicked => { root.show-about(); }
                    Tooltip {
                        Hint { text: "The version this is, and who the maps, the star catalog and the astronomy come from."; }
                    }
                }
            }
        }
    }

    splitter := Splitter {
        x: sidebar.width;
        height: 100%;

        moved(delta) => {
            root.panel-width = max(panel.min-width, min(root.panel-width + delta, root.width - root.min-image-width));
        }
    }

    // Image fills the area right of the splitter
    image-container := Rectangle {
        x: splitter.x + splitter.width;
        y: 0;
        width: root.width - self.x;
        height: root.height;
        background: black;

        Image {
            source: rendered-image;
            width: parent.width;
            height: parent.height;
            image-fit: contain;
        }

        property <length> last-mouse-x;
        property <length> last-mouse-y;
        property <bool> left-held: false;
        property <bool> right-held: false;
        property <bool> middle-held: false;

        viewport-touch := TouchArea {
            width: parent.width;
            height: parent.height;

            pointer-event(event) => {
                if event.button == PointerEventButton.left {
                    image-container.left-held = event.kind == PointerEventKind.down;
                    if event.kind == PointerEventKind.down {
                        root.mouse-drag-globe-begin();
                    }
                }
                if event.button == PointerEventButton.right {
                    image-container.right-held = event.kind == PointerEventKind.down;
                }
                if event.button == PointerEventButton.middle {
                    image-container.middle-held = event.kind == PointerEventKind.down;
                }
                if event.kind == PointerEventKind.down || event.kind == PointerEventKind.up {
                    image-container.last-mouse-x = self.mouse-x;
                    image-container.last-mouse-y = self.mouse-y;
                }
                image-container.note-gesture(image-container.gesture);
            }

            moved => {
                if image-container.left-held && image-container.right-held {
                    root.mouse-drag-tilt(
                        (self.mouse-x - image-container.last-mouse-x) / 1px,
                        (self.mouse-y - image-container.last-mouse-y) / 1px
                    );
                } else if image-container.left-held {
                    root.mouse-drag-globe(
                        (self.mouse-x - image-container.last-mouse-x) / 1px,
                        (self.mouse-y - image-container.last-mouse-y) / 1px
                    );
                } else if image-container.right-held {
                    root.mouse-drag-frame(
                        (self.mouse-x - image-container.last-mouse-x) / 1px,
                        (self.mouse-y - image-container.last-mouse-y) / 1px
                    );
                } else if image-container.middle-held {
                    root.mouse-drag-orient(
                        (self.mouse-x - image-container.last-mouse-x) / 1px,
                        (self.mouse-y - image-container.last-mouse-y) / 1px
                    );
                }
                image-container.last-mouse-x = self.mouse-x;
                image-container.last-mouse-y = self.mouse-y;
            }

            scroll-event(event) => {
                root.mouse-scroll(event.delta-y / 1px);
                image-container.wheel-at = animation-tick();
                image-container.wheel-turning = true;
                image-container.note-gesture("zoom");
                return accept;
            }
        }

        // The wheel has no held state of its own: it counts as in progress
        // until it has been still for 350 ms.
        property <bool> wheel-turning;
        property <duration> wheel-at;
        Timer {
            interval: 50ms;
            running: image-container.wheel-turning;
            triggered => {
                if animation-tick() - image-container.wheel-at >= 350ms {
                    image-container.wheel-turning = false;
                }
            }
        }

        // The gesture in progress on the globe, by the name its control on
        // the camera panel goes by.
        property <string> gesture: self.left-held && self.right-held ? "roll"
            : self.left-held ? "orbit"
            : self.right-held ? "frame"
            : self.middle-held ? "look"
            : "";
        // The gestures used on the globe this session, and the controls whose
        // gesture a tip has named, so the first use of a control can tell
        // whether its gesture is new. Nothing of it is saved.
        property <bool> used-orbit;
        property <bool> used-roll;
        property <bool> used-zoom;
        property <bool> used-look;
        property <bool> used-frame;
        property <bool> taught-orbit;
        property <bool> taught-roll;
        property <bool> taught-zoom;
        property <bool> taught-look;
        property <bool> taught-frame;
        property <string> tip-mouse;
        property <string> tip-text;
        property <duration> tip-at;
        property <bool> tip-shown;

        function note-gesture(gesture: string) {
            if gesture == "orbit" { image-container.used-orbit = true; }
            if gesture == "roll" { image-container.used-roll = true; }
            if gesture == "zoom" { image-container.used-zoom = true; }
            if gesture == "look" { image-container.used-look = true; }
            if gesture == "frame" { image-container.used-frame = true; }
        }

        function teach(control: string) {
            if control == "orbit" {
                if image-container.used-orbit || image-container.taught-orbit { return; }
                image-container.taught-orbit = true;
            } else if control == "roll" {
                if image-container.used-roll || image-container.taught-roll { return; }
                image-container.taught-roll = true;
            } else if control == "zoom" {
                if image-container.used-zoom || image-container.taught-zoom { return; }
                image-container.taught-zoom = true;
            } else if control == "look" {
                if image-container.used-look || image-container.taught-look { return; }
                image-container.taught-look = true;
            } else if control == "frame" {
                if image-container.used-frame || image-container.taught-frame { return; }
                image-container.taught-frame = true;
            } else {
                return;
            }
            image-container.tip-mouse = control == "orbit" ? "left"
                : control == "roll" ? "both"
                : control == "frame" ? "right"
                : control == "look" ? "middle"
                : "wheel";
            image-container.tip-text = control == "orbit" ? "Faster: drag the globe with the left button"
                : control == "roll" ? "Or drag the globe with left and right held"
                : control == "frame" ? "Or drag the globe with the right button"
                : control == "look" ? "Or drag the globe with the middle button"
                : "Or scroll the mouse wheel over the globe";
            image-container.tip-at = animation-tick();
            image-container.tip-shown = true;
        }

        Timer {
            interval: 100ms;
            running: image-container.tip-shown;
            triggered => {
                if animation-tick() - image-container.tip-at >= 2800ms {
                    image-container.tip-shown = false;
                }
            }
        }

        Timer {
            interval: 16ms;
            running: root.camera-easing;
            triggered => {
                let now = animation-tick();
                root.camera-ease-tick(min(now - image-container.ease-tick, 100ms) / 1s);
                image-container.ease-tick = now;
            }
        }
        property <duration> ease-tick;
        changed ease-requested => {
            image-container.ease-tick = animation-tick();
        }
        property <bool> ease-requested: root.camera-easing;

        camera-panel := CameraPanel {
            x: parent.width - self.width - 12px;
            y: 12px;
            tilt: root.camera-orientation.tilt;
            zoom <=> root.camera-position.zoom;
            default-zoom: root.defaults.camera-position.zoom;
            look-modified: root.camera-orientation.yaw != root.defaults.camera-orientation.yaw
                || root.camera-orientation.pitch != root.defaults.camera-orientation.pitch;
            frame-modified: root.framing.offset-x != root.defaults.framing.offset-x
                || root.framing.offset-y != root.defaults.framing.offset-y;
            lit-orbit: image-container.gesture == "orbit";
            lit-roll: image-container.gesture == "roll";
            lit-zoom: image-container.wheel-turning;
            lit-look: image-container.gesture == "look";
            lit-frame: image-container.gesture == "frame";
            stick(which, x, y, seconds) => { root.camera-stick(which, x, y, seconds); }
            orbit-step(right, up) => { root.camera-orbit-step(right, up); }
            roll(degrees) => { root.camera-roll(degrees); }
            reset(which) => { root.camera-reset(which); }
            zoom-step(direction) => { root.camera-zoom-step(direction); }
            zoom-rate(direction, seconds) => { root.camera-zoom-rate(direction, seconds); }
            zoom-changed => { root.sliders-changed(); }
            used(control) => { image-container.teach(control); }
        }

        // The hover hint of whichever overlay control the pointer rests on,
        // after 450 ms, left of the camera panel.
        property <string> hint-id: camera-panel.any-held ? "" : camera-panel.hovered-hint;
        property <string> shown-hint;
        property <duration> hint-since;
        changed hint-id => {
            image-container.shown-hint = "";
            image-container.hint-since = animation-tick();
        }
        Timer {
            interval: 50ms;
            running: image-container.hint-id != "" && image-container.shown-hint != image-container.hint-id;
            triggered => {
                if animation-tick() - image-container.hint-since >= 450ms {
                    image-container.shown-hint = image-container.hint-id;
                }
            }
        }

        if image-container.shown-hint != "" : hint := OverlayHint {
            content: OverlayHints.content(image-container.shown-hint);
            x: camera-panel.x - self.width - 12px;
            y: clamp(camera-panel.y + camera-panel.hovered-y - self.height / 2, 6px, parent.height - self.height - 6px);
        }

        if image-container.tip-shown : GestureTip {
            x: (parent.width - self.width) / 2;
            y: 14px;
            mouse: image-container.tip-mouse;
            text: image-container.tip-text;
        }

        if loading-text != "" : Rectangle {
            x: parent.width - loading-label.width - 16px;
            y: parent.height - loading-label.height - 12px;
            width: loading-label.width + 16px;
            height: loading-label.height + 8px;
            border-radius: 4px;
            background: #000000aa;

            loading-label := Text {
                x: 8px;
                y: 4px;
                text: loading-text;
                color: #cccccc;
                font-size: 12px;
            }
        }
    }
}
