// The sheet of every mouse gesture and keyboard shortcut on the preview, in
// the platform's names. F1 or Ctrl + ? (⌘? on macOS) opens it; Esc or a click
// outside the card closes it.

import { OverlayStyle, OverlayHints, MouseGlyph, KeyCap } from "common.slint";

struct SheetGesture {
    mouse: string,
    text: string,
}

struct SheetKeys {
    keys: [string],
    text: string,
}

component SheetHeading inherits Text {
    color: OverlayStyle.dim;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.7px;
}

// What a row of the sheet does, beside its gesture or keys. The rows place it
// by hand: a box layout in a repeated row measures wrapping text at its
// one-line width and would keep the row one line high.
component SheetText inherits Text {
    color: OverlayStyle.fg;
    font-size: 12px;
    wrap: word-wrap;
    vertical-alignment: center;
}

export component ShortcutSheet inherits Rectangle {
    callback close();

    property <[SheetGesture]> gestures: [
        { mouse: "left", text: "Orbit the globe" },
        { mouse: "wheel", text: "Zoom" },
        { mouse: "middle", text: "Look around (yaw, pitch)" },
        { mouse: "both", text: "Roll the picture" },
        { mouse: "right", text: "Move the frame" },
    ];
    property <[SheetKeys]> keys: [
        { keys: ["←", "→", "↑", "↓"], text: "Orbit" },
        { keys: [OverlayHints.shift-key, "←↑↓→"], text: "Look" },
        { keys: [OverlayHints.mod-key, "←↑↓→"], text: "Move the frame" },
        { keys: ["W", "A", "S", "D"], text: "Like the arrows, alone or with " + OverlayHints.shift-key + " or " + OverlayHints.mod-key },
        { keys: ["+", "−"], text: "Zoom" },
        { keys: ["Q", "E"], text: "Roll" },
        { keys: ["N"], text: "North up" },
        { keys: ["Space"], text: "Play / pause" },
        { keys: ["J", "K", "L"], text: "Shuttle: back, pause, forward; again for faster" },
        { keys: ["R"], text: "Reverse direction" },
        { keys: [",", "."], text: "Step back / forward (" + OverlayHints.shift-key + ": bigger)" },
        { keys: ["0"], text: "Back to now" },
        { keys: ["H"], text: "Hide controls" },
        { keys: OverlayHints.help-keys(), text: "This sheet" },
    ];

    background: #0000008c;

    TouchArea {
        clicked => { root.close(); }
    }

    // Two equal columns where each leaves its descriptions at least 110 px
    // beside the 104 px of gesture or keys, otherwise the keyboard below the
    // mouse; a card taller than the room scrolls.
    card := Rectangle {
        property <length> inner: self.width - 44px;
        property <bool> two-columns: (self.inner - 26px) / 2 >= 214px;
        property <length> column: self.two-columns ? (self.inner - 26px) / 2 : self.inner;

        x: (parent.width - self.width) / 2;
        y: max(8px, (parent.height - self.height) / 2);
        width: min(660px, parent.width - 16px);
        height: min(card-layout.preferred-height, parent.height - 16px);
        border-radius: 14px;
        border-width: 1px;
        border-color: OverlayStyle.border;
        background: OverlayStyle.solid;
        drop-shadow-blur: 22px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: #00000073;

        TouchArea { }

        scroller := Flickable {
            content-width: self.width;
            content-height: card-layout.preferred-height;

            card-layout := VerticalLayout {
                padding-top: 18px;
                padding-bottom: 18px;
                padding-left: 22px;
                padding-right: 22px;
                spacing: 10px;

                // The platform beside the title, or under it where both do
                // not fit on one line.
                Rectangle {
                    property <bool> one-line: heading.preferred-width + 10px + platform.preferred-width <= card.inner;

                    height: self.one-line ? max(heading.preferred-height, platform.preferred-height)
                        : heading.preferred-height + 2px + platform.preferred-height;

                    heading := Text {
                        x: 0;
                        y: 0;
                        width: self.preferred-width;
                        height: parent.one-line ? parent.height : self.preferred-height;
                        text: "Mouse and keyboard";
                        color: OverlayStyle.fg;
                        font-size: 15px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    platform := Text {
                        x: parent.one-line ? heading.width + 10px : 0;
                        y: parent.one-line ? 0 : heading.height + 2px;
                        width: self.preferred-width;
                        height: parent.one-line ? parent.height : self.preferred-height;
                        text: OverlayHints.is-macos ? "macOS" : "Windows and Linux";
                        color: OverlayStyle.dim;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: card.two-columns
                        ? max(mouse-column.preferred-height, keys-column.preferred-height)
                        : mouse-column.preferred-height + 16px + keys-column.preferred-height;

                    mouse-column := VerticalLayout {
                        x: 0;
                        y: 0;
                        width: card.column;
                        height: self.preferred-height;
                        spacing: 2px;

                        SheetHeading {
                            text: "MOUSE ON THE GLOBE";
                        }

                        for gesture in root.gestures : Rectangle {
                            height: max(24px, gesture-text.height + 6px);

                            MouseGlyph {
                                x: 0;
                                which: gesture.mouse;
                            }

                            gesture-text := SheetText {
                                x: 104px;
                                width: parent.width - 104px;
                                text: gesture.text;
                            }
                        }
                    }

                    keys-column := VerticalLayout {
                        x: card.two-columns ? card.column + 26px : 0;
                        y: card.two-columns ? 0 : mouse-column.preferred-height + 16px;
                        width: card.column;
                        height: self.preferred-height;
                        spacing: 2px;

                        SheetHeading {
                            text: "KEYBOARD";
                        }

                        for entry in root.keys : Rectangle {
                            height: max(24px, entry-text.height + 6px);

                            keys := HorizontalLayout {
                                x: 0;
                                width: self.preferred-width;
                                height: 18px;
                                spacing: 3px;

                                for key in entry.keys : KeyCap {
                                    text: key;
                                }
                            }

                            entry-text := SheetText {
                                x: max(104px, keys.width + 8px);
                                width: parent.width - self.x;
                                text: entry.text;
                            }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: OverlayStyle.border;
                }

                Text {
                    text: "The shortcuts act on the preview: click the globe if they do not answer.";
                    color: OverlayStyle.dim;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }

        if scroller.content-height > scroller.height : Rectangle {
            x: parent.width - 6px;
            y: 6px + (parent.height - 12px - self.height) * (-scroller.content-y) / (scroller.content-height - scroller.height);
            width: 3px;
            height: max(24px, (parent.height - 12px) * scroller.height / scroller.content-height);
            border-radius: 1.5px;
            background: #ffffff40;
        }
    }
}
