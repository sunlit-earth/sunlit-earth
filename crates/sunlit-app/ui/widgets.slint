import { Slider, ComboBox, CheckBox, LineEdit, Palette } from "std-widgets.slint";

// One monitor's place in the layout diagram.
//
// The rectangle is already normalized to the bounding box of every monitor, so
// the diagram multiplies by the board's size and does nothing else; the
// arithmetic that decides it is in `displays.rs`, where it is tested.
export struct MonitorTile {
    label: string,
    x: float,
    y: float,
    width: float,
    height: float,
    anchor: bool,
}

// One block of the attributions document, cut out of the markdown by
// `about::parse_blocks`.
//
// `kind` is 0 for a paragraph, 1 for a heading and 2 for a list item; `depth`
// is a heading's level or a list item's nesting. A heading renders as a plain
// `Text`, since `StyledText` has no font weight or size of its own, and so it
// carries its text in `heading`; every other kind carries inline markdown in
// `body`.
export struct AboutBlock {
    kind: int,
    depth: int,
    heading: string,
    body: styled-text,
}

export component Splitter inherits Rectangle {
    callback moved(length);

    width: 4px;
    background: touch.has-hover || touch.pressed ? Palette.accent-background : transparent;

    touch := TouchArea {
        width: 10px;
        x: -3px;
        mouse-cursor: ew-resize;

        moved => {
            root.moved(self.mouse-x - self.pressed-x);
        }
    }
}

// The hover text's own popup.
//
// `Tooltip { text: ... }` would be one line, but the built-in content does not
// wrap and a sentence is wider than any screen, so this is the custom-content
// form. The compiler still wraps it in the built-in `ToolTipImpl`, which is
// where the background and the border come from, and which sizes the popup
// from its children's preferred width. A `Text` reports the width it would
// take unwrapped however narrow the element around it is, so the width here is
// declared as a constraint and not only as a size; the height then follows
// from the wrap at that width.
export component Hint inherits Rectangle {
    in property <string> text;

    min-width: 300px;
    max-width: 300px;
    preferred-width: 300px;
    height: body.preferred-height;

    body := VerticalLayout {
        padding-left: 9px;
        padding-right: 9px;
        padding-bottom: 6px;

        Text {
            text: root.text;
            color: Palette.foreground;
            wrap: word-wrap;
        }
    }
}

// The slot a reset button appears in, at the end of a row, a heading or a
// group's title.
//
// The slot keeps its width while the button is gone, so nothing beside it
// moves when a value leaves its default. It is as wide as the icon, which
// then ends where the panel's buttons end; the button around it is wider and
// reaches past the slot on both sides. The icon is an SVG rather than the ↺
// character, which not every desktop's font has.
export component ResetSlot inherits Rectangle {
    in property <bool> shown;
    // What the button resets, which is what its accessible label names.
    in property <string> target;
    // The button's hover text, which is also its accessible description.
    in property <string> hint;
    callback reset();

    width: 12px;
    min-height: 16px;

    if root.shown : touch := TouchArea {
        x: (root.width - self.width) / 2;
        width: 16px;
        height: 16px;
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: "Reset " + root.target;
        accessible-description: root.hint;
        accessible-action-default => { root.reset(); }
        clicked => { root.reset(); }

        Rectangle {
            border-radius: 3px;
            background: touch.pressed ? Palette.foreground.with-alpha(0.2)
                : touch.has-hover ? Palette.foreground.with-alpha(0.1)
                : transparent;
        }

        Image {
            width: 12px;
            height: 12px;
            source: @image-url("icons/reset.svg");
            colorize: Palette.foreground;
        }

        Tooltip {
            text: @markdown("\{root.hint}");
        }
    }
}

// One row of the settings panel: a label, a control, and the value it reads.
//
// The row's hover text covers everything but the reset, which has its own; a
// hover text over both would open both. A `Tooltip` lowers to a full-size
// child area, which inside a layout would claim a cell of its own, so the
// label, the slider and the value sit in a Rectangle that carries it.
export component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <string> value-text;
    // A sub-row shifts its label right and gives up the same width, so the
    // sliders of a group stay in one column whatever the nesting is.
    in property <length> indent: 0px;
    in property <length> label-width: 88px;
    in property <length> value-width: 45px;
    in property <float> minimum;
    in property <float> maximum;
    in-out property <float> value;
    // What the row's reset puts back. A row that leaves it out resets to zero.
    in property <float> default-value;
    in property <bool> resettable: true;
    out property <bool> modified: root.resettable && root.value != root.default-value;
    callback changed();

    min-height: row.min-height;
    preferred-height: row.preferred-height;

    row := HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 2px;

        Rectangle {
            min-width: setting.min-width;
            preferred-width: setting.preferred-width;
            min-height: setting.min-height;
            preferred-height: setting.preferred-height;

            setting := HorizontalLayout {
                width: 100%;
                height: 100%;
                spacing: 4px;
                padding-left: root.indent;

                Text {
                    text: root.label;
                    vertical-alignment: center;
                    min-width: root.label-width - root.indent;
                }
                Slider {
                    minimum: root.minimum;
                    maximum: root.maximum;
                    value <=> root.value;
                    changed => { root.changed(); }
                }
                Text {
                    text: root.value-text;
                    vertical-alignment: center;
                    min-width: root.value-width;
                }
            }

            Tooltip {
                Hint { text: root.hint; }
            }
        }
        ResetSlot {
            shown: root.modified;
            target: root.label;
            hint: "Reset to default";
            reset => {
                root.value = root.default-value;
                root.changed();
            }
        }
    }
}

// A color's `#rrggbb` text, both ways. The app implements the two with
// `Rgb8`'s own functions, so the config file and the panel read one spelling.
export struct ParsedColor {
    valid: bool,
    color: color,
}

export global ColorText {
    pure callback format(color) -> string;
    pure callback parse(string) -> ParsedColor;
}

// What a color row's popup holds: a saturation and value square over the hue,
// a hue strip, and a hex field.
//
// The color is the only state that persists. The picker takes its hue,
// saturation and value from `value` when it is created, which is each time
// the popup opens, keeps its own hue while saturation or value is zero so a
// gray does not lose it, and writes `value` from its pointer and edit
// handlers alone. A color nobody touches never passes through a float round
// trip.
//
// The square's vertical axis is the square root of value: both ocean
// defaults are dark, at a value of 0.24 by day and 0.06 by night, which a
// linear axis puts in the square's bottom quarter and bottom sixteenth. The
// black layer's stops are 1 - (1 - y)^2 at every eighth of the height, close
// enough to the curve that a pick and the color drawn under it agree within a
// level.
export component ColorPicker inherits Rectangle {
    in-out property <color> value;
    callback changed();

    property <float> hue;
    property <float> saturation;
    property <float> brightness;

    width: 180px;
    height: layout.preferred-height;
    background: Palette.background;
    border-width: 1px;
    border-color: Palette.border;
    border-radius: 4px;

    init => {
        root.take(root.value);
        hex.text = ColorText.format(root.value);
    }

    function take(color: color) {
        let hsv = color.to-hsv();
        if hsv.saturation > 0 && hsv.value > 0 {
            root.hue = hsv.hue;
        }
        root.saturation = hsv.saturation;
        root.brightness = hsv.value;
    }

    function pick() {
        root.value = hsv(root.hue, root.saturation, root.brightness);
        hex.text = ColorText.format(root.value);
        root.changed();
    }

    function pick-square(x: length, y: length) {
        let up = 1 - clamp(y / square.height, 0, 1);
        root.saturation = clamp(x / square.width, 0, 1);
        root.brightness = up * up;
        root.pick();
    }

    function pick-hue(hue: float) {
        root.hue = clamp(hue, 0, 360);
        root.pick();
    }

    function enter(text: string) {
        let parsed = ColorText.parse(text);
        if parsed.valid {
            root.value = parsed.color;
            root.take(parsed.color);
            hex.text = ColorText.format(root.value);
            root.changed();
        }
    }

    layout := VerticalLayout {
        padding: 8px;
        spacing: 6px;

        square := Rectangle {
            height: 120px;
            clip: true;

            Rectangle {
                background: hsv(root.hue, 1, 1);
            }
            Rectangle {
                background: @linear-gradient(90deg, #ffffff 0%, #ffffff00 100%);
            }
            Rectangle {
                background: @linear-gradient(180deg,
                    #00000000 0%,
                    #0000003c 12.5%,
                    #00000070 25%,
                    #0000009b 37.5%,
                    #000000bf 50%,
                    #000000db 62.5%,
                    #000000ef 75%,
                    #000000fb 87.5%,
                    #000000ff 100%);
            }
            Rectangle {
                x: root.saturation * parent.width - self.width / 2;
                y: (1 - sqrt(root.brightness)) * parent.height - self.height / 2;
                width: 10px;
                height: 10px;
                border-radius: 5px;
                border-width: 2px;
                border-color: root.brightness > 0.3 && root.saturation < 0.5 ? #000000 : #ffffff;
            }
            TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        root.pick-square(self.mouse-x, self.mouse-y);
                    }
                }
                moved => {
                    root.pick-square(self.mouse-x, self.mouse-y);
                }
            }
        }

        strip := Rectangle {
            height: 14px;
            border-radius: 2px;
            background: @linear-gradient(90deg,
                #ff0000 0%,
                #ffff00 16.667%,
                #00ff00 33.333%,
                #00ffff 50%,
                #0000ff 66.667%,
                #ff00ff 83.333%,
                #ff0000 100%);

            Rectangle {
                x: root.hue / 360 * parent.width - self.width / 2;
                y: -2px;
                width: 4px;
                height: parent.height + 4px;
                border-width: 1px;
                border-color: #ffffff;
                background: #00000060;
            }
            TouchArea {
                accessible-role: slider;
                accessible-label: "Hue";
                accessible-value: round(root.hue);
                accessible-value-minimum: 0;
                accessible-value-maximum: 360;
                accessible-value-step: 1;
                accessible-action-set-value(text) => {
                    root.pick-hue(text.to-float());
                }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        root.pick-hue(self.mouse-x / self.width * 360);
                    }
                }
                moved => {
                    root.pick-hue(self.mouse-x / self.width * 360);
                }
            }
        }

        HorizontalLayout {
            spacing: 6px;

            Text {
                text: "Hex";
                vertical-alignment: center;
            }
            hex := LineEdit {
                min-width: 0;
                accessible-label: "Hex";
                accepted(text) => {
                    root.enter(text);
                }
                changed has-focus => {
                    if !self.has-focus {
                        self.text = ColorText.format(root.value);
                    }
                }
            }
        }
    }
}

// A color row, on the same label column as SettingRow: the label, a swatch
// that opens the picker, the color's hex text, and the reset. Its contract is
// SettingRow's: `value`, `default-value`, `modified` and `changed`.
//
// The swatch's accessible value is the hex text, and setting it reads one, so
// a screen reader, and a test, can set the color without the popup.
export component SettingColor inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <length> indent: 0px;
    in property <length> label-width: 88px;
    in-out property <color> value;
    // What the row's reset puts back.
    in property <color> default-value;
    out property <bool> modified: root.value != root.default-value;
    callback changed();

    min-height: row.min-height;
    preferred-height: row.preferred-height;

    row := HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 2px;

        Rectangle {
            min-width: setting.min-width;
            preferred-width: setting.preferred-width;
            min-height: setting.min-height;
            preferred-height: setting.preferred-height;

            setting := HorizontalLayout {
                width: 100%;
                height: 100%;
                spacing: 4px;
                padding-left: root.indent;
                alignment: start;

                Text {
                    text: root.label;
                    vertical-alignment: center;
                    min-width: root.label-width - root.indent;
                }
                VerticalLayout {
                    alignment: center;

                    swatch := Rectangle {
                        width: 36px;
                        height: 18px;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: swatch-touch.has-hover ? Palette.foreground : Palette.border;
                        background: root.value;

                        swatch-touch := TouchArea {
                            mouse-cursor: pointer;
                            accessible-role: button;
                            accessible-label: root.label;
                            accessible-description: "Pick a color";
                            accessible-value: ColorText.format(root.value);
                            accessible-action-default => {
                                popup.show();
                            }
                            accessible-action-set-value(text) => {
                                let parsed = ColorText.parse(text);
                                if parsed.valid {
                                    root.value = parsed.color;
                                    root.changed();
                                }
                            }
                            clicked => {
                                popup.show();
                            }
                        }
                    }
                }
                Text {
                    text: ColorText.format(root.value);
                    vertical-alignment: center;
                }
            }

            Tooltip {
                Hint { text: root.hint; }
            }
        }
        ResetSlot {
            shown: root.modified;
            target: root.label;
            hint: "Reset to default";
            reset => {
                root.value = root.default-value;
                root.changed();
            }
        }
    }

    popup := PopupWindow {
        x: swatch.absolute-position.x - root.absolute-position.x;
        y: swatch.absolute-position.y - root.absolute-position.y + swatch.height + 2px;
        width: picker.width;
        height: picker.height;
        close-policy: PopupClosePolicy.close-on-click-outside;

        picker := ColorPicker {
            value <=> root.value;
            changed => {
                root.changed();
            }
        }
    }
}

// A checkbox row. The checkbox carries its own wording, so there is no label
// column to align it against.
//
// A CheckBox reports the width of that wording as its minimum, which would
// make one long label the floor of the whole sidebar, so it is pinned here.
export component SettingCheck inherits Rectangle {
    in property <string> text;
    in property <string> hint;
    in property <length> indent: 0px;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    callback toggled();

    min-height: row.min-height;
    preferred-height: row.preferred-height;

    row := HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: root.indent;

        CheckBox {
            text: root.text;
            min-width: 0;
            enabled: root.enabled;
            checked <=> root.checked;
            toggled => { root.toggled(); }
        }
    }

    Tooltip {
        Hint { text: root.hint; }
    }
}

// A combo box row, on the same label column as SettingRow.
export component SettingCombo inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <length> indent: 0px;
    in property <length> label-width: 88px;
    in property <[string]> model;
    in-out property <int> current-index;
    callback selected();

    min-height: row.min-height;
    preferred-height: row.preferred-height;

    row := HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 4px;
        padding-left: root.indent;

        Text {
            text: root.label;
            vertical-alignment: center;
            min-width: root.label-width - root.indent;
        }
        ComboBox {
            // The fluent ComboBox asks for 160px flat, which would set the
            // sidebar's floor. 140 fits the longest value the fixed models
            // carry, at 93px of text inside 42px of padding, spacing and
            // chevron, with slack for another platform's font. A screen label
            // is longer than that and elides, as it did at 160.
            min-width: 140px;
            model: root.model;
            current-index <=> root.current-index;
            max-height: 24px;
            selected => { root.selected(); }
        }
    }

    Tooltip {
        Hint { text: root.hint; }
    }
}

// The heading above a run of related rows inside a group, and the reset for
// all of them.
export component SettingHeading inherits Rectangle {
    in property <string> text;
    in property <bool> modified;
    callback reset();

    min-height: row.min-height;
    preferred-height: row.preferred-height;

    row := HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 4px;

        Text {
            text: root.text;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        ResetSlot {
            shown: root.modified;
            target: root.text;
            hint: "Reset " + root.text + " to defaults";
            reset => { root.reset(); }
        }
    }
}

// A titled group of settings, and the reset for everything in it.
//
// This is the fluent GroupBox's layout, 16px above the title, 8px under it and
// 8px under the content, the title semi-bold at the default size and the
// content with no horizontal padding, with a reset slot beside the title, so
// the group's reset lines up with its rows'.
export component SettingGroup {
    in property <string> title;
    in property <bool> modified;
    callback reset();

    accessible-role: groupbox;
    accessible-label: root.title;

    VerticalLayout {
        spacing: 8px;
        padding-top: 16px;
        padding-bottom: 8px;

        HorizontalLayout {
            vertical-stretch: 0;
            spacing: 4px;

            Text {
                text: root.title;
                color: Palette.foreground;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
                accessible-role: none;
            }
            ResetSlot {
                shown: root.modified;
                target: root.title;
                hint: "Reset " + root.title + " to defaults";
                reset => { root.reset(); }
            }
        }

        @children
    }
}
