// The web addresses the app opens. Every one of them is handed to
// `open::url` in Rust, whose check a unit test walks each of them through.
export global Links {
    out property <string> website: "https://sunlit.earth";
    out property <string> repository: "https://github.com/sunlit-earth/sunlit-earth";
    out property <string> new-issue: "https://github.com/sunlit-earth/sunlit-earth/issues/new";
}
