// What a launch says when an older version, which cannot be asked to show its
// window, is already running: this copy did not start, and how to get to the
// running one.

import { Button, Palette } from "std-widgets.slint";

export component OlderVersionWindow inherits Window {
    title: "Sunlit Earth";
    icon: @image-url("../../../assets/icon/sunlit-earth.svg");
    background: Palette.background;
    width: 440px;

    in property <string> version;
    callback dismiss();

    property <string> tray-icon: Platform.os == OperatingSystemType.macos ? "menu bar icon" : "tray icon";

    layout := VerticalLayout {
        padding: 20px;
        spacing: 14px;

        // Takes the height the window is dragged to, below the texts: with
        // every cell at stretch 0 the layout would share it out among all of
        // them, the button included.
        VerticalLayout {
            spacing: 14px;
            alignment: start;
            vertical-stretch: 1;

            Text {
                text: "An older version is already running";
                color: Palette.foreground;
                font-size: 15px;
                font-weight: 600;
            }

            Text {
                text: "An older version of Sunlit Earth is already running, so Sunlit Earth " + root.version + " did not start. Open the running one from its " + root.tray-icon + ", or quit it there and open Sunlit Earth again.";
                color: Palette.foreground;
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        HorizontalLayout {
            alignment: end;

            Button {
                text: "Close";
                primary: true;
                clicked => { root.dismiss(); }
            }
        }
    }
}
