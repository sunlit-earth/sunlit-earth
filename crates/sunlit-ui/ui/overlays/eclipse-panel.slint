// Eclipse mode's panel above the time bar: the eclipse the mode is on, its
// phases and their times, and what the instant on screen shows. Also the
// eclipse's mark, which the date track, the mode button and the pill share.

import { OverlayStyle } from "common.slint";

// A solar eclipse's mark in a 9 by 9 box, scaled to the element's size. The
// shape says the kind: a total eclipse is a dark disk with a thin bright rim,
// an annular one a thick bright ring around a smaller dark center, a partial
// one a bright disk with a dark bite out of it.
export component EclipseGlyph inherits Rectangle {
    // 0 partial, 1 annular, 2 total.
    in property <int> kind;
    in property <color> bright: OverlayStyle.sun;
    in property <color> dark: #20180a;

    width: 9px;
    height: 9px;

    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 9;
        viewbox-height: 9;
        commands: root.kind == 0 ? "M4.34 0A4.5 4.5 0 1 0 9 4.66A3.5 3.5 0 0 1 4.34 0Z"
            : "M0 4.5A4.5 4.5 0 1 0 9 4.5A4.5 4.5 0 1 0 0 4.5Z";
        fill: root.bright;
    }

    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 9;
        viewbox-height: 9;
        commands: root.kind == 0 ? "M4.34 0A4.5 4.5 0 0 1 9 4.66A3.5 3.5 0 0 1 4.34 0Z"
            : root.kind == 1 ? "M2.2 4.5A2.3 2.3 0 1 0 6.8 4.5A2.3 2.3 0 1 0 2.2 4.5Z"
            : "M0.9 4.5A3.6 3.6 0 1 0 8.1 4.5A3.6 3.6 0 1 0 0.9 4.5Z";
        fill: root.dark;
    }
}

// One phase of the eclipse: a contact or the peak.
export struct EclipsePhase {
    label: string,
    // "17:34", in the displayed zone.
    time: string,
    // 0 the penumbra's contact, 1 the umbra's, 2 the peak.
    glyph: int,
}

// What the panel shows, written whole by Rust.
export struct EclipsePanelView {
    kind: int,
    // "Total solar eclipse".
    title: string,
    // "Wed 12 Aug 2026 · UTC+2".
    date-text: string,
    phases: [EclipsePhase],
    // The phase row of the instant on screen, -1 for none.
    current: int,
    // "Totality 2 min 21 s at greatest eclipse".
    fact: string,
    // What the instant on screen shows of the shadow.
    now-text: string,
    has-previous: bool,
    has-next: bool,
}

component Chevron inherits Rectangle {
    in property <bool> left;
    in property <bool> enabled;
    in property <string> label;
    out property <bool> hovered: touch.has-hover;
    callback clicked();

    width: 20px;
    height: 20px;
    border-radius: 6px;
    background: root.enabled && touch.has-hover ? OverlayStyle.faint : transparent;

    Path {
        width: 8px;
        height: 10px;
        viewbox-width: 8;
        viewbox-height: 10;
        commands: root.left ? "M6 1L2 5L6 9" : "M2 1L6 5L2 9";
        stroke: root.enabled ? OverlayStyle.fg : OverlayStyle.border;
        stroke-width: 1.5px;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        accessible-role: button;
        accessible-label: root.label;
        accessible-enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component PhaseRow inherits Rectangle {
    in property <EclipsePhase> phase;
    in property <bool> current;
    out property <bool> hovered: touch.has-hover;
    callback clicked();

    height: 20px;
    border-radius: 5px;
    background: root.current ? OverlayStyle.accent-soft : touch.has-hover ? OverlayStyle.faint : transparent;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 8px;

        VerticalLayout {
            alignment: center;

            Path {
                width: 9px;
                height: 9px;
                viewbox-width: 9;
                viewbox-height: 9;
                commands: root.phase.glyph == 2 ? "M4.5 0.5L8.5 4.5L4.5 8.5L0.5 4.5Z"
                    : "M1 4.5A3.5 3.5 0 1 0 8 4.5A3.5 3.5 0 1 0 1 4.5Z";
                fill: root.phase.glyph == 0 ? transparent : OverlayStyle.sun;
                stroke: OverlayStyle.sun;
                stroke-width: 1px;
            }
        }

        Text {
            text: root.phase.label;
            color: OverlayStyle.fg;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        Text {
            text: root.phase.time;
            color: root.current ? OverlayStyle.fg : OverlayStyle.dim;
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: root.phase.label;
        clicked => { root.clicked(); }
    }
}

export component EclipsePanel inherits Rectangle {
    in property <EclipsePanelView> view;
    // Too little room above the bar for both it and the camera panel: the
    // phases and the fact line give way, and the header and the instant's
    // line stay.
    in property <bool> compact;

    // The panel's height with every line shown, which is what decides
    // whether it has to be compact.
    out property <length> full-height: 2 * 10px + 22px + 16px + 6px + root.view.phases.length * 20px + 4px + 16px + 4px + 16px;
    out property <string> hovered-hint: previous.hovered ? "eclipse-previous" : next.hovered ? "eclipse-next" : "";
    out property <length> hovered-x: previous.hovered ? previous.x + previous.width / 2 : next.x + next.width / 2;
    out property <bool> hovered: touch.has-hover || self.hovered-hint != "" || root.hovered-row >= 0;

    callback previous();
    callback next();
    callback phase-picked(int);

    property <int> hovered-row: -1;

    width: 240px;
    height: lines.preferred-height;
    border-radius: 12px;
    border-width: 1px;
    border-color: OverlayStyle.border;
    background: OverlayStyle.panel;
    drop-shadow-blur: 18px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: #00000066;

    touch := TouchArea { }

    lines := VerticalLayout {
        padding: 10px;
        spacing: 0px;

        HorizontalLayout {
            height: 22px;
            spacing: 6px;

            VerticalLayout {
                alignment: center;

                previous := Chevron {
                    left: true;
                    enabled: root.view.has-previous;
                    label: "Previous solar eclipse";
                    clicked => { root.previous(); }
                }
            }

            VerticalLayout {
                alignment: center;

                EclipseGlyph {
                    kind: root.view.kind;
                    width: 12px;
                    height: 12px;
                }
            }

            Text {
                text: root.view.title;
                color: OverlayStyle.fg;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            VerticalLayout {
                alignment: center;

                next := Chevron {
                    left: false;
                    enabled: root.view.has-next;
                    label: "Next solar eclipse";
                    clicked => { root.next(); }
                }
            }
        }

        Text {
            height: 16px;
            text: root.view.date-text;
            color: OverlayStyle.dim;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if !root.compact : Rectangle {
            height: 6px;
        }

        if !root.compact : VerticalLayout {
            for phase[index] in root.view.phases : PhaseRow {
                phase: phase;
                current: index == root.view.current;
                clicked => { root.phase-picked(index); }
                changed hovered => {
                    if self.hovered {
                        root.hovered-row = index;
                    } else if root.hovered-row == index {
                        root.hovered-row = -1;
                    }
                }
            }
        }

        if !root.compact : Rectangle {
            height: 4px;
        }

        if !root.compact : Text {
            height: 16px;
            text: root.view.fact;
            color: OverlayStyle.dim;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            height: 4px;
        }

        Text {
            height: 16px;
            text: root.view.now-text;
            color: OverlayStyle.sun;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
