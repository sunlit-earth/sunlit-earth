// Outlines of the pictures the preview stands for, a 16:9 render's and a 4:3
// render's, each centered on the preview with its short side the frame's
// short edge as it is displayed. Every output is the same picture scaled until
// the short edges match, so a rectangle is exactly what a render of that shape
// shows. A mark at the center stays on the panel when the outlines do not.

import { OverlayStyle } from "common.slint";

// One rectangle, in the coordinates of the container it is drawn over.
export struct FrameGuide {
    x: length,
    y: length,
    width: length,
    height: length,
    label: string,
    label-x: length,
    label-y: length,
}

component Band inherits Rectangle {
    background: OverlayStyle.fg.with-alpha(0.18);
}

component GuideLabel inherits Text {
    in property <FrameGuide> guide;

    x: guide.label-x;
    y: guide.label-y;
    text: guide.label;
    font-size: 11px;
    color: OverlayStyle.fg.with-alpha(0.7);
}

// One stroke of the center cross, over its halo.
component CrossStroke inherits Rectangle {
    in property <bool> horizontal;
    in property <length> arm;
    property <length> halo: 3px;

    width: horizontal ? 2 * arm + halo : halo;
    height: horizontal ? halo : 2 * arm + halo;
    background: #00000080;

    Rectangle {
        width: horizontal ? 2 * arm + 1px : 1px;
        height: horizontal ? 1px : 2 * arm + 1px;
        background: OverlayStyle.fg.with-alpha(0.8);
    }
}

// One corner of the center rectangle: two arms along its edges, inside it.
component CenterCorner inherits Rectangle {
    in property <bool> right;
    in property <bool> bottom;
    in property <length> arm-x;
    in property <length> arm-y;
    property <length> thickness: 3px;
    property <color> stroke: OverlayStyle.fg.with-alpha(0.5);

    width: arm-x;
    height: arm-y;

    Rectangle {
        x: 0;
        y: bottom ? parent.height - root.thickness : 0;
        width: parent.width;
        height: root.thickness;
        background: root.stroke;
    }

    Rectangle {
        x: right ? parent.width - root.thickness : 0;
        y: bottom ? 0 : root.thickness;
        width: root.thickness;
        height: parent.height - root.thickness;
        background: root.stroke;
    }
}

export component FrameGuides inherits Rectangle {
    // The frame's short edge as it is displayed, in logical pixels.
    in property <length> short-edge;

    property <length> band: 10px;
    property <length> inset: 5px;
    property <length> cross-arm: 12px;
    property <length> corner-arm: 22px;

    // The rectangle of a landscape aspect ratio `aspect` whose height is the
    // short edge, centered.
    pure function outline(aspect: float, label: string) -> FrameGuide {
        let w = root.short-edge * aspect;
        let h = root.short-edge;
        let x = (root.width - w) / 2;
        let y = (root.height - h) / 2;
        return {
            x: x,
            y: y,
            width: w,
            height: h,
            label: label,
            label-x: x + root.band + root.inset,
            label-y: y + root.band + root.inset,
        };
    }

    out property <FrameGuide> wide: outline(16 / 9, "16:9");
    out property <FrameGuide> classic: outline(4 / 3, "4:3");
    // 4:3 lies inside 16:9 at the same height, so 16:9's top and bottom are
    // drawn only where 4:3's are not: from each side bar to 4:3's outer edge.
    // No point is then covered by two bands.
    out property <length> wide-segment-width: max(0, root.classic.x - root.wide.x - root.band);
    out property <FrameGuide> center: {
        x: (root.width - root.height / 3 * 16 / 9) / 2,
        y: root.height / 3,
        width: root.height / 3 * 16 / 9,
        height: root.height / 3,
    };

    classic-band := Rectangle {
        x: root.classic.x;
        y: root.classic.y;
        width: root.classic.width;
        height: root.classic.height;
        border-width: root.band;
        border-color: OverlayStyle.fg.with-alpha(0.18);
    }

    for side in [0, 1]: Rectangle {
        property <length> outer-x: side == 0 ? root.wide.x : root.wide.x + root.wide.width - root.band;
        property <length> segment-x: side == 0 ? root.wide.x + root.band : root.classic.x + root.classic.width;

        wide-side := Band {
            x: parent.outer-x;
            y: root.wide.y;
            width: root.band;
            height: root.wide.height;
        }

        wide-top := Band {
            x: parent.segment-x;
            y: root.wide.y;
            width: root.wide-segment-width;
            height: root.band;
        }

        wide-bottom := Band {
            x: parent.segment-x;
            y: root.wide.y + root.wide.height - root.band;
            width: root.wide-segment-width;
            height: root.band;
        }
    }

    wide-label := GuideLabel {
        guide: root.wide;
    }

    classic-label := GuideLabel {
        guide: root.classic;
    }

    center-mark := Rectangle {
        property <length> arm-x: min(root.corner-arm, root.center.width / 2);
        property <length> arm-y: min(root.corner-arm, root.center.height / 2);

        for corner in [0, 1, 2, 3]: center-corner := CenterCorner {
            right: corner == 1 || corner == 3;
            bottom: corner >= 2;
            arm-x: parent.arm-x;
            arm-y: parent.arm-y;
            x: self.right ? root.center.x + root.center.width - self.arm-x : root.center.x;
            y: self.bottom ? root.center.y + root.center.height - self.arm-y : root.center.y;
        }

        for horizontal in [true, false]: center-cross := CrossStroke {
            horizontal: horizontal;
            arm: root.cross-arm;
            x: root.width / 2 - self.width / 2;
            y: root.height / 2 - self.height / 2;
        }
    }
}
