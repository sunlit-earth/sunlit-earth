// The time bar at the bottom of the preview: the time on screen, playback,
// and the time setting's tracks.

import { DatePickerPopup, TimePickerPopup } from "std-widgets.slint";
import { OverlayStyle } from "common.slint";
import { EclipseGlyph } from "eclipse-panel.slint";

// What the bar shows, written whole by Rust from the time setting, the
// excursion the engine reports and the instant of the last frame.
export struct TimeBarView {
    // The setting is live time and there is no excursion.
    live: bool,
    excursion: bool,
    running: bool,
    // The rate play runs at, signed: multiples of real time, or days a
    // second when play runs the date.
    rate: int,
    date-kind: bool,
    // The folded pill's state: "LIVE", the offset from now, "▶ 60×" or
    // "Preview".
    state-text: string,
    pill-text: string,
    // "UTC" while the bar shows UTC, empty in local time.
    pill-zone: string,
    zone-text: string,
    time-text: string,
    // ":07" while live, empty otherwise.
    seconds-text: string,
    date-text: string,
    offset-text: string,
    // "300×" or "1 week/s", and what it means.
    speed-text: string,
    speed-note: string,
    // Where the handles stand, from 0 to 1 along the displayed day and year.
    day-fraction: float,
    year-fraction: float,
    // The camera is fixed toward the Sun, so the time track is drawn plain.
    sun-fixed: bool,
    // Eclipse mode is on, and the kind of the eclipse it is on, for the
    // pill's mark: 0 partial, 1 annular, 2 total.
    eclipse-follow: bool,
    eclipse-kind: int,
    // Where that eclipse's peak falls along the displayed day, or -1.
    eclipse-peak: float,
    // The instant on screen in the displayed zone, for exact entry.
    year: int,
    month: int,
    day: int,
    hour: int,
    minute: int,
}

// One speed of the speed list, signed.
export struct RateChoice {
    rate: int,
    label: string,
    note: string,
}

// An equinox or a solstice on the date track.
export struct SeasonMark {
    fraction: float,
    label: string,
}

// A solar eclipse on the date track: 0 partial, 1 annular, 2 total.
export struct EclipseMark {
    fraction: float,
    kind: int,
    label: string,
}

// A stretch of the displayed day in which the shadow is on the Earth, the
// penumbra's or the umbra's, cut where the day ends.
export struct EclipseBand {
    start: float,
    end: float,
    umbra: bool,
    cut-start: bool,
    cut-end: bool,
}

// A shape of the bar drawn from SVG path data in a box of its own.
component Glyph inherits Path {
    in property <color> tint;
    fill: self.tint;
}

// A small square button of the transport.
component TimeButton inherits Rectangle {
    // Lit the way play is while it runs.
    in property <bool> lit;
    in property <string> label;
    out property <bool> hovered: touch.has-hover;
    out property <bool> shift-held;
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: root.lit ? OverlayStyle.accent : touch.has-hover ? OverlayStyle.faint : transparent;

    @children

    touch := TouchArea {
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: root.label;

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.shift-held = event.modifiers.shift;
            }
        }

        clicked => { root.clicked(); }
    }
}

// One ruler of speeds on one side of play: a dot per rate, growing with the
// rate, the slowest next to play. A click or a drag along it picks the dot
// nearest the pointer.
component SpeedRuler inherits Rectangle {
    // -1 for the ruler that runs backward.
    in property <int> side;
    in property <[int]> ladder;
    // The rate the bar runs at, signed, and whether it runs.
    in property <int> rate;
    in property <bool> running;
    // From one dot to the next: 11 px at full size, less in a narrow bar,
    // where the dots shrink with it.
    in property <length> pitch: 11px;
    out property <bool> hovered: touch.has-hover;
    callback picked(int);

    property <int> count: self.ladder.length;

    function rate-at(slot: int) -> int {
        return root.side * root.ladder[root.side < 0 ? root.count - 1 - slot : slot];
    }

    function pick(x: length) {
        let slot = max(0, min(root.count - 1, floor((x - 4px) / root.pitch)));
        let rate = root.rate-at(slot);
        if !(root.running && rate == root.rate) {
            root.picked(rate);
        }
    }

    width: 6px + self.count * self.pitch;
    height: 30px;
    border-radius: 15px;
    background: #ffffff0d;

    for slot in root.count : dot := Rectangle {
        property <int> index: root.side < 0 ? root.count - 1 - slot : slot;
        property <int> value: root.side * root.ladder[self.index];
        property <bool> on: root.running && self.value == root.rate;
        property <bool> lit: root.running && (self.value < 0) == (root.rate < 0) && abs(self.value) < abs(root.rate);
        property <length> size: (4px + self.index * 6px / max(1, root.count - 1)) * root.pitch / 11px;
        x: 4px + slot * root.pitch + (root.pitch - 2px - self.size) / 2;
        y: (root.height - self.size) / 2;
        width: self.size;
        height: self.size;
        border-radius: self.size / 2;
        background: self.on ? OverlayStyle.accent : self.lit ? #4cc2ff73 : #ffffff59;
        drop-shadow-blur: self.on ? 8px : 0px;
        drop-shadow-color: OverlayStyle.accent-glow;
    }

    touch := TouchArea {
        mouse-cursor: pointer;

        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.pick(self.mouse-x);
            }
        }

        moved => {
            if self.pressed {
                root.pick(self.mouse-x);
            }
        }
    }
}

// A radio label in front of a track, choosing what play runs.
component DriveLabel inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    in property <bool> running;
    out property <bool> hovered: touch.has-hover;
    callback clicked();

    property <color> tint: root.on ? OverlayStyle.accent : touch.has-hover ? OverlayStyle.fg : OverlayStyle.dim;

    width: 48px;
    height: 22px;
    border-radius: 6px;
    background: touch.has-hover ? OverlayStyle.faint : transparent;

    if root.on && root.running : Glyph {
        x: 3px;
        y: (root.height - 10px) / 2;
        width: 9px;
        height: 10px;
        viewbox-width: 9;
        viewbox-height: 10;
        commands: "M0 0L9 5L0 10Z";
        tint: OverlayStyle.accent;
    }

    if !(root.on && root.running) : Rectangle {
        x: 3px;
        y: (root.height - 9px) / 2;
        width: 9px;
        height: 9px;
        border-radius: 4.5px;
        border-width: 1.5px;
        border-color: root.tint;
        background: root.on ? OverlayStyle.accent : transparent;
    }

    Text {
        x: 17px;
        text: root.text;
        color: root.tint;
        font-size: 10px;
        letter-spacing: 0.6px;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-checked: root.on;
        accessible-label: root.text;
        clicked => { root.clicked(); }
    }
}

// A track of the displayed day or year: a handle where the instant on screen
// stands, the time under the pointer while it hovers, and a press or a drag
// that sets the time setting there.
component Track inherits Rectangle {
    in property <float> fraction;
    in property <color> handle-color;
    in property <color> handle-dot;
    out property <bool> held: touch.pressed;
    out property <bool> hovered: touch.has-hover;
    // What the hover label says at a place along the track.
    pure callback label-at(float) -> string;
    callback moved(float);

    height: 22px;
    border-radius: 6px;

    function along(x: length) -> float {
        return max(0, min(0.99999, x / root.width));
    }

    @children

    Rectangle {
        x: root.fraction * root.width - 8px;
        y: -3px;
        width: 16px;
        height: 28px;
        border-radius: 6px;
        background: root.handle-color;
        drop-shadow-blur: 5px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #00000099;

        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: root.handle-dot;
        }
    }

    touch := TouchArea {
        mouse-cursor: ew-resize;

        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.moved(root.along(self.mouse-x));
            }
        }

        moved => {
            if self.pressed {
                root.moved(root.along(self.mouse-x));
            }
        }
    }

    if touch.has-hover : Rectangle {
        x: max(0px, min(root.width, touch.mouse-x)) - self.width / 2;
        y: -self.height - 4px;
        width: hover-text.preferred-width + 12px;
        height: 20px;
        border-radius: 5px;
        border-width: 1px;
        border-color: OverlayStyle.tip-border;
        background: OverlayStyle.tip-background;

        hover-text := Text {
            text: root.label-at(root.along(touch.mouse-x));
            color: OverlayStyle.fg;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// The bar at the bottom center of the preview. Folded, a pill with the state
// and the time on screen; hovered, pinned, held or with a popup open, the
// bar with the transport, the two tracks and the clock block.
export component TimeBar inherits Rectangle {
    in property <TimeBarView> view;
    in property <[int]> ladder;
    in property <[RateChoice]> rates;
    in property <[SeasonMark]> seasons;
    in property <[EclipseMark]> eclipses;
    in property <[EclipseBand]> eclipse-bands;
    in property <[float]> month-ticks;
    in property <image> shading;
    in-out property <bool> pinned;
    // The pointer is over eclipse mode's panel above the bar, which counts as
    // over the bar.
    in property <bool> panel-hovered;
    // Whether the pointer is over the preview; outside it the bar fades.
    in property <bool> pointer-in;
    // How wide the bar may grow.
    in property <length> room;
    // The preview the bar stands in, in the bar's coordinates. The date and
    // time pickers open inside it.
    in property <length> preview-left;
    in property <length> preview-top;
    in property <length> preview-width;
    // The most speeds either kind of play has.
    in property <int> longest-ladder;

    // The control under the pointer, by its hint id, and the middle of that
    // control in the bar's coordinates.
    out property <string> hovered-hint: pin-touch.has-hover ? "pin"
        : root.skip-back-hovered ? "skip-back"
        : root.skip-forward-hovered ? "skip-forward"
        : root.play-hovered ? "play"
        : root.mode-hovered ? "eclipse-mode"
        : root.ruler-hovered ? "ruler"
        : root.speed-hovered ? "rate"
        : root.drive-time-hovered ? "drive-time"
        : root.drive-date-hovered ? "drive-date"
        : root.state-hovered ? (root.view.excursion ? "preview" : root.view.live ? "live" : "now")
        : root.time-hovered ? "pick-time"
        : root.zone-hovered ? "zone"
        : root.date-hovered ? "pick-date"
        : root.day-hovered ? (root.view.eclipse-follow ? "day-track-eclipse" : root.view.sun-fixed ? "day-track-sun-fixed" : "day-track")
        : root.year-hovered ? "year-track"
        : "";
    out property <length> hovered-x: hovered-hint == "pin" ? root.width - 17px
        : hovered-hint == "drive-time" || hovered-hint == "drive-date" ? root.left-column + 24px
        : hovered-hint == "rate" ? speed-readout.x + speed-readout.width / 2
        : hovered-hint == "eclipse-mode" ? root.middle-column + root.middle-width - 14px
        : hovered-hint == "pick-time" || hovered-hint == "zone" || hovered-hint == "pick-date" || hovered-hint == "preview" || hovered-hint == "live" || hovered-hint == "now" ? root.right-column + 70px
        : root.middle-column + root.middle-width / 2;
    out property <bool> hovered: background-touch.has-hover || root.rates-hovered || self.hovered-hint != "" || root.mark-hovered >= 0 || root.panel-hovered;
    out property <bool> open: root.pinned || root.hover-open || root.track-held || root.rates-open || root.picker-open;
    // Where each picker stood when it last opened, in the bar's coordinates.
    out property <length> date-picker-x: root.picker-x(root.date-picker-size.width);
    out property <length> date-picker-y: root.picker-y(root.date-picker-size.height);
    out property <length> time-picker-x: root.picker-x(root.time-picker-size.width);
    out property <length> time-picker-y: root.picker-y(root.time-picker-size.height);

    callback toggle-play();
    callback rate-picked(int);
    callback skip(bool, bool);
    callback kind-picked(bool);
    callback now();
    callback end-excursion();
    callback zone();
    callback track(bool, float);
    callback exact-date(int, int, int);
    callback exact-time(int, int);
    callback tick();
    pure callback date-at(float) -> string;
    // Eclipse mode's button, and a click on an eclipse's mark on the date
    // track by its index.
    callback eclipse-toggled();
    callback eclipse-picked(int);

    // What the open bar's parts report, written by them while it is open.
    property <bool> skip-back-hovered;
    property <bool> skip-forward-hovered;
    property <bool> play-hovered;
    property <bool> ruler-hovered;
    property <bool> speed-hovered;
    property <bool> drive-time-hovered;
    property <bool> drive-date-hovered;
    property <bool> state-hovered;
    property <bool> time-hovered;
    property <bool> zone-hovered;
    property <bool> date-hovered;
    property <bool> day-hovered;
    property <bool> year-hovered;
    property <bool> track-held;
    property <bool> rates-hovered;
    property <bool> mode-hovered;
    property <int> mark-hovered: -1;

    property <bool> hover-open;
    property <duration> left-at;
    property <bool> rates-open;
    property <bool> picker-open: date-picker.is-open || time-picker.is-open;
    property <{ width: length, height: length }> date-picker-size;
    property <{ width: length, height: length }> time-picker-size;
    property <length> left-column: 12px;
    property <length> middle-column: 70px;
    property <length> beside-tracks: root.middle-column + 10px + 142px + 12px + 26px;
    property <length> middle-width: root.width - root.beside-tracks;
    property <length> right-column: root.middle-column + root.middle-width + 10px;
    // The speed readout starts at the left column, and eclipse mode's button
    // ends the transport's row at the tracks' right edge, `mode-room` with
    // its gap. The transport stays centered over the tracks while its right
    // end clears that gap, and otherwise centers in the room left of it.
    // Where the transport at full size would run into the widest readout of
    // the ladder's speeds or past that room, the readout folds to its arrow
    // and the rulers' dots pack closer, down to `min-pitch`. The open bar is
    // never narrower than the row of the longest ladder needs at that pitch,
    // whichever kind is shown, and a preview narrower than that cuts its
    // edges off.
    property <length> transport-fixed: 2 * 28px + 44px + 4 * 6px;
    property <length> mode-room: 28px + 6px;
    property <length> row-room: root.middle-width - root.mode-room;
    property <length> narrowest: root.beside-tracks + root.mode-room + root.transport-fixed + 2 * (6px + root.longest-ladder * root.min-pitch);
    property <length> full-row: root.transport-fixed + 2 * (6px + root.ladder.length * 11px);
    property <length> readout-width: widest-readout.preferred-width + 16px;
    property <length> readout-height: readout-lines.preferred-height + 8px;
    property <bool> compact: root.full-row > root.row-room
        || root.left-column + root.readout-width + 6px > root.middle-column + root.row-x(root.full-row);
    property <length> min-pitch: 7px;
    property <length> pitch: !root.compact ? 11px
        : max(root.min-pitch, min(11px, ((root.row-room - root.transport-fixed) / 2 - 6px) / max(1, root.ladder.length)));

    // Where in the tracks' column a transport row `row` wide starts.
    pure function row-x(row: length) -> length {
        return (root.middle-width + row) / 2 <= root.row-room ? (root.middle-width - row) / 2 : (root.row-room - row) / 2;
    }
    property <color> state-color: root.view.excursion ? OverlayStyle.accent
        : root.view.live ? OverlayStyle.fg
        : OverlayStyle.sun;

    changed hovered => {
        if self.hovered {
            root.hover-open = true;
        } else {
            root.left-at = animation-tick();
        }
    }

    Timer {
        interval: 100ms;
        running: root.hover-open && !root.hovered;
        triggered => {
            if animation-tick() - root.left-at >= 700ms {
                root.hover-open = false;
                root.rates-open = false;
            }
        }
    }

    Timer {
        interval: 1s;
        running: root.view.live;
        triggered => { root.tick(); }
    }

    width: root.open ? max(root.narrowest, min(800px, root.room)) : pill-row.preferred-width;
    height: root.open ? 124px : 30px;
    border-radius: root.open ? 14px : 15px;
    border-width: 1px;
    border-color: OverlayStyle.border;
    background: OverlayStyle.panel;
    drop-shadow-blur: 22px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: #00000073;
    opacity: root.pinned || root.pointer-in ? 1 : 0.42;
    animate opacity { duration: OverlayStyle.idle-fade; }

    background-touch := TouchArea { }

    Rectangle {
        visible: !root.open;

        pill-row := HorizontalLayout {
            padding-left: 10px;
            padding-right: 12px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 5px;

                if root.view.eclipse-follow : VerticalLayout {
                    alignment: center;

                    EclipseGlyph {
                        kind: root.view.eclipse-kind;
                    }
                }

                Rectangle {
                    width: root.view.live ? 8px : 0px;

                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        visible: root.view.live;
                        background: OverlayStyle.live;
                        drop-shadow-blur: 8px;
                        drop-shadow-color: OverlayStyle.live;
                    }
                }

                Text {
                    text: root.view.state-text;
                    color: root.state-color;
                    font-size: 11px;
                    font-weight: 600;
                    letter-spacing: 0.4px;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.view.pill-text;
                color: OverlayStyle.fg;
                font-size: 13px;
                vertical-alignment: center;
            }

            if root.view.pill-zone != "" : Text {
                text: root.view.pill-zone;
                color: OverlayStyle.dim;
                font-size: 13px;
                vertical-alignment: center;
            }
        }
    }

    // The readout's size at the widest of the ladder's speeds, measured out
    // of sight.
    Rectangle {
        visible: false;
        width: 0px;
        height: 0px;

        widest-readout := VerticalLayout {
            padding-left: 8px;

            for choice in root.rates : HorizontalLayout {
                spacing: 4px;

                Rectangle {
                    width: 9px;
                }

                Text {
                    text: choice.rate > 0 ? choice.label : "";
                    font-size: 15px;
                    font-weight: 600;
                }
            }

            for choice in root.rates : Text {
                text: choice.note;
                font-size: 11px;
            }

            Text {
                text: root.view.date-kind ? root.view.speed-note : "";
                font-size: 11px;
            }
        }

        readout-lines := VerticalLayout {
            padding-top: 4px;

            Text {
                text: "0";
                font-size: 15px;
                font-weight: 600;
            }

            Text {
                text: "0";
                font-size: 11px;
            }
        }
    }

    // The speed and what it means, or in a narrow bar its arrow alone; a
    // click lists every speed.
    speed-readout := Rectangle {
        x: root.compact ? root.left-column + 10px : root.left-column;
        y: 8px + (44px - self.height) / 2;
        width: root.compact ? 28px : root.readout-width;
        height: root.compact ? 28px : root.readout-height;
        border-radius: 8px;
        visible: root.open;
        background: speed-touch.has-hover ? OverlayStyle.faint : transparent;

        if !root.compact : VerticalLayout {
            padding-left: 8px;
            padding-top: 4px;

            HorizontalLayout {
                spacing: 4px;

                VerticalLayout {
                    alignment: center;

                    Glyph {
                        width: 9px;
                        height: 9px;
                        viewbox-width: 10;
                        viewbox-height: 10;
                        commands: root.view.rate < 0 ? "M8 1V9L2 5Z" : "M2 1V9L8 5Z";
                        tint: root.view.running ? OverlayStyle.fg : OverlayStyle.dim;
                    }
                }

                Text {
                    text: root.view.speed-text;
                    color: root.view.running ? OverlayStyle.fg : OverlayStyle.dim;
                    font-size: 15px;
                    font-weight: 600;
                }
            }

            Text {
                text: root.view.speed-note;
                color: OverlayStyle.dim;
                font-size: 11px;
            }
        }

        if root.compact : Glyph {
            width: 9px;
            height: 9px;
            viewbox-width: 10;
            viewbox-height: 10;
            commands: root.view.rate < 0 ? "M8 1V9L2 5Z" : "M2 1V9L8 5Z";
            tint: root.view.running ? OverlayStyle.fg : OverlayStyle.dim;
        }

        speed-touch := TouchArea {
            enabled: root.open;
            mouse-cursor: pointer;
            accessible-role: button;
            accessible-label: "Speed";
            clicked => { root.rates-open = !root.rates-open; }
            changed has-hover => { root.speed-hovered = self.has-hover; }
        }
    }

    if root.open : Rectangle {
        // Skip, the rulers and play, centered over the tracks.
        HorizontalLayout {
            x: root.middle-column + root.row-x(self.preferred-width);
            width: self.preferred-width;
            y: 8px;
            height: 44px;
            spacing: 6px;
            alignment: center;

            VerticalLayout {
                alignment: center;

                skip-back := TimeButton {
                    clicked => { root.skip(false, self.shift-held); }
                    changed hovered => { root.skip-back-hovered = self.hovered; }

                    Glyph {
                        width: 14px;
                        height: 12px;
                        viewbox-width: 14;
                        viewbox-height: 12;
                        commands: "M1 1H2.6V11H1ZM12 1L3.5 6L12 11Z";
                        tint: OverlayStyle.fg;
                    }
                }
            }

            VerticalLayout {
                alignment: center;

                backward := SpeedRuler {
                    side: -1;
                    ladder: root.ladder;
                    rate: root.view.rate;
                    running: root.view.running;
                    pitch: root.pitch;
                    picked(rate) => { root.rate-picked(rate); }
                    changed hovered => { root.ruler-hovered = self.hovered || forward.hovered; }
                }
            }

            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: root.view.running ? OverlayStyle.accent : play-touch.has-hover ? #ffffff38 : #ffffff24;

                if root.view.running : Glyph {
                    width: 12px;
                    height: 12px;
                    viewbox-width: 12;
                    viewbox-height: 12;
                    commands: "M2 1.5H5V10.5H2ZM7 1.5H10V10.5H7Z";
                    tint: #04121b;
                }

                if !root.view.running : Glyph {
                    width: 12px;
                    height: 12px;
                    viewbox-width: 12;
                    viewbox-height: 12;
                    commands: root.view.rate < 0 ? "M9 1.5V10.5L1.5 6Z" : "M3 1.5V10.5L10.5 6Z";
                    tint: OverlayStyle.fg;
                }

                play-touch := TouchArea {
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: root.view.running ? "Pause" : "Play";
                    clicked => { root.toggle-play(); }
                    changed has-hover => { root.play-hovered = self.has-hover; }
                }
            }

            VerticalLayout {
                alignment: center;

                forward := SpeedRuler {
                    side: 1;
                    ladder: root.ladder;
                    rate: root.view.rate;
                    running: root.view.running;
                    pitch: root.pitch;
                    picked(rate) => { root.rate-picked(rate); }
                    changed hovered => { root.ruler-hovered = self.hovered || backward.hovered; }
                }
            }

            VerticalLayout {
                alignment: center;

                skip-forward := TimeButton {
                    clicked => { root.skip(true, self.shift-held); }
                    changed hovered => { root.skip-forward-hovered = self.hovered; }

                    Glyph {
                        width: 14px;
                        height: 12px;
                        viewbox-width: 14;
                        viewbox-height: 12;
                        commands: "M11.4 1H13V11H11.4ZM2 1L10.5 6L2 11Z";
                        tint: OverlayStyle.fg;
                    }
                }
            }
        }

        mode-button := TimeButton {
            x: root.middle-column + root.middle-width - self.width;
            y: 8px + (44px - self.height) / 2;
            lit: root.view.eclipse-follow;
            label: "Eclipse mode";
            clicked => { root.eclipse-toggled(); }
            changed hovered => { root.mode-hovered = self.hovered; }

            EclipseGlyph {
                kind: 2;
                width: 14px;
                height: 14px;
                bright: root.view.eclipse-follow ? #04121b : OverlayStyle.dim;
                dark: root.view.eclipse-follow ? OverlayStyle.accent : OverlayStyle.solid;
            }
        }

        DriveLabel {
            x: root.left-column;
            y: 60px;
            text: "TIME";
            on: !root.view.date-kind;
            running: root.view.running;
            clicked => { root.kind-picked(false); }
            changed hovered => { root.drive-time-hovered = self.hovered; }
        }

        DriveLabel {
            x: root.left-column;
            y: 91px;
            text: "DATE";
            on: root.view.date-kind;
            running: root.view.running;
            clicked => { root.kind-picked(true); }
            changed hovered => { root.drive-date-hovered = self.hovered; }
        }

        day-track := Track {
            x: root.middle-column;
            y: 60px;
            width: root.middle-width;
            fraction: root.view.day-fraction;
            handle-color: OverlayStyle.sun;
            handle-dot: #fff6d8;
            background: #112233;
            label-at(x) => {
                let minutes = min(1439, round(x * 1440));
                let hours = floor(minutes / 60);
                let rest = mod(minutes, 60);
                return (hours < 10 ? "0" : "") + hours + ":" + (rest < 10 ? "0" : "") + rest;
            }
            moved(x) => { root.track(false, x); }
            changed hovered => { root.day-hovered = self.hovered; }
            changed held => { root.track-held = self.held || year-track.held; }

            if !root.view.sun-fixed && !root.view.eclipse-follow : altitude-shading := Image {
                width: parent.width;
                height: parent.height;
                source: root.shading;
                image-fit: fill;
            }

            for band in root.eclipse-bands : Rectangle {
                x: band.start * parent.width;
                width: (band.end - band.start) * parent.width;
                height: parent.height;
                background: OverlayStyle.sun.with-alpha(band.umbra ? 0.5 : 0.2);

                if band.cut-start : Path {
                    x: 1px;
                    width: 5px;
                    height: parent.height;
                    viewbox-width: 5;
                    viewbox-height: 22;
                    commands: "M5 7L0 11L5 15Z";
                    fill: OverlayStyle.sun;
                }

                if band.cut-end : Path {
                    x: parent.width - self.width - 1px;
                    width: 5px;
                    height: parent.height;
                    viewbox-width: 5;
                    viewbox-height: 22;
                    commands: "M0 7L5 11L0 15Z";
                    fill: OverlayStyle.sun;
                }
            }

            if root.view.eclipse-follow && root.view.eclipse-peak >= 0 : Rectangle {
                x: root.view.eclipse-peak * parent.width;
                width: 1px;
                height: parent.height;
                background: OverlayStyle.sun;
            }

            for hour in 8 : Rectangle {
                x: hour * parent.width / 8;
                width: 1px;
                height: parent.height;
                background: #ffffff2e;
            }

            for hour in 4 : Text {
                x: hour * parent.width / 4 + 3px;
                y: 3px;
                text: (hour < 2 ? "0" : "") + hour * 6;
                color: #ffffffbf;
                font-size: 10px;
            }
        }

        year-track := Track {
            x: root.middle-column;
            y: 91px;
            width: root.middle-width;
            fraction: root.view.year-fraction;
            handle-color: #7cc4ff;
            handle-dot: #1e4a7a;
            background: @linear-gradient(90deg, #78aaff29 0%, #8cdc8c29 30%, #ffd2782e 55%, #ffa05a29 75%, #78aaff29 100%);
            label-at(x) => { return root.date-at(x); }
            moved(x) => { root.track(true, x); }
            changed hovered => { root.year-hovered = self.hovered; }
            changed held => { root.track-held = self.held || day-track.held; }

            for tick in root.month-ticks : Rectangle {
                x: tick * parent.width;
                width: 1px;
                height: parent.height;
                background: #ffffff2e;
            }

            for tick[month] in root.month-ticks : Text {
                x: tick * parent.width + 3px;
                y: 3px;
                text: ["J", "F", "M", "A", "M", "J", "J", "A", "S", "O", "N", "D"][month];
                color: #ffffffbf;
                font-size: 10px;
            }

            for season in root.seasons : Glyph {
                x: season.fraction * parent.width - 4.5px;
                y: (parent.height - 9px) / 2;
                width: 9px;
                height: 9px;
                viewbox-width: 9;
                viewbox-height: 9;
                commands: "M4.5 0L9 4.5L4.5 9L0 4.5Z";
                tint: #ffffffd9;
                stroke: #00000066;
                stroke-width: 1px;
            }
        }

        // The eclipses of the displayed year over the date track, drawn over
        // a season's diamond they meet. Each takes its own presses, so a
        // press on one jumps to it rather than starting a drag, and shows its
        // own label where the track's would be.
        for mark[index] in root.eclipses : Rectangle {
            x: root.middle-column + mark.fraction * root.middle-width - self.width / 2;
            y: 91px + (22px - self.height) / 2;
            width: 13px;
            height: 13px;

            EclipseGlyph {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                kind: mark.kind;
            }

            mark-touch := TouchArea {
                mouse-cursor: pointer;
                accessible-role: button;
                accessible-label: mark.label;
                clicked => { root.eclipse-picked(index); }
                changed has-hover => {
                    if self.has-hover {
                        root.mark-hovered = index;
                    } else if root.mark-hovered == index {
                        root.mark-hovered = -1;
                    }
                }
            }

            if mark-touch.has-hover : Rectangle {
                x: (parent.width - self.width) / 2;
                y: -self.height - 4px - (22px - parent.height) / 2;
                width: mark-text.preferred-width + 12px;
                height: 20px;
                border-radius: 5px;
                border-width: 1px;
                border-color: OverlayStyle.tip-border;
                background: OverlayStyle.tip-background;

                mark-text := Text {
                    text: mark.label;
                    color: OverlayStyle.fg;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // The clock block: the state with the offset, the time with its zone,
        // and the date.
        Rectangle {
            x: root.right-column;
            y: 8px;
            width: 1px;
            height: 106px;
            background: OverlayStyle.border;
        }

        VerticalLayout {
            x: root.right-column + 12px;
            y: 8px;
            width: 130px;
            height: 106px;
            spacing: 7px;
            alignment: center;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Rectangle {
                    width: state-row.preferred-width;
                    height: 24px;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: root.view.live ? OverlayStyle.border : #4cc2ff73;
                    background: state-touch.has-hover && !root.view.live ? OverlayStyle.accent : #ffffff0f;

                    state-row := HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;

                        VerticalLayout {
                            alignment: center;

                            Rectangle {
                                width: 7px;
                                height: 7px;
                                border-radius: 3.5px;
                                background: root.view.live ? OverlayStyle.live : OverlayStyle.accent;
                            }
                        }

                        Text {
                            text: root.view.excursion ? "Preview" : root.view.live ? "Live" : "Now";
                            color: root.view.live ? OverlayStyle.dim : state-touch.has-hover ? #04121b : OverlayStyle.fg;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    state-touch := TouchArea {
                        mouse-cursor: root.view.live ? default : pointer;
                        accessible-role: button;
                        accessible-label: root.view.excursion ? "Preview" : root.view.live ? "Live" : "Now";
                        clicked => {
                            if root.view.excursion {
                                root.end-excursion();
                            } else if !root.view.live {
                                root.now();
                            }
                        }
                        changed has-hover => { root.state-hovered = self.has-hover; }
                    }
                }

                Text {
                    text: root.view.offset-text;
                    color: OverlayStyle.sun;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Rectangle {
                    width: time-row.preferred-width;
                    height: time-row.preferred-height;

                    time-row := HorizontalLayout {
                        big-time := Text {
                            text: root.view.time-text;
                            color: time-touch.has-hover ? OverlayStyle.accent : OverlayStyle.fg;
                            font-size: 26px;
                            font-weight: 600;
                        }

                        Text {
                            text: root.view.seconds-text;
                            color: OverlayStyle.dim;
                            font-size: 12px;
                            vertical-alignment: bottom;
                        }
                    }

                    time-touch := TouchArea {
                        mouse-cursor: pointer;
                        accessible-role: button;
                        accessible-label: "Time";
                        clicked => {
                            time-picker.show();
                        }
                        changed has-hover => { root.time-hovered = self.has-hover; }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    Rectangle {
                        width: zone-row.preferred-width;
                        height: 20px;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: OverlayStyle.border;
                        background: zone-touch.has-hover ? OverlayStyle.faint : transparent;

                        zone-row := HorizontalLayout {
                            padding-left: 7px;
                            padding-right: 7px;
                            spacing: 5px;

                            Text {
                                text: root.view.zone-text;
                                color: zone-touch.has-hover ? OverlayStyle.fg : OverlayStyle.dim;
                                font-size: 11px;
                                vertical-alignment: center;
                            }

                            VerticalLayout {
                                alignment: center;

                                Path {
                                    width: 10px;
                                    height: 10px;
                                    viewbox-width: 10;
                                    viewbox-height: 10;
                                    commands: "M1 3H8M6 1L8 3L6 5M9 7H2M4 5L2 7L4 9";
                                    stroke: zone-touch.has-hover ? OverlayStyle.fg : OverlayStyle.dim;
                                    stroke-width: 1.1px;
                                }
                            }
                        }

                        zone-touch := TouchArea {
                            mouse-cursor: pointer;
                            accessible-role: button;
                            accessible-label: "Time zone";
                            clicked => { root.zone(); }
                            changed has-hover => { root.zone-hovered = self.has-hover; }
                        }
                    }
                }
            }

            HorizontalLayout {
                alignment: start;

                Rectangle {
                    width: date-row.preferred-width;
                    height: date-row.preferred-height;

                    date-row := HorizontalLayout {
                        spacing: 6px;

                        VerticalLayout {
                            alignment: center;

                            Path {
                                width: 12px;
                                height: 12px;
                                viewbox-width: 12;
                                viewbox-height: 12;
                                commands: "M2.5 2H9.5A1.5 1.5 0 0 1 11 3.5V9.5A1.5 1.5 0 0 1 9.5 11H2.5A1.5 1.5 0 0 1 1 9.5V3.5A1.5 1.5 0 0 1 2.5 2ZM1 5H11M4 1V3.5M8 1V3.5";
                                stroke: date-touch.has-hover ? OverlayStyle.accent : OverlayStyle.dim;
                                stroke-width: 1.1px;
                            }
                        }

                        Text {
                            text: root.view.date-text;
                            color: date-touch.has-hover ? OverlayStyle.accent : OverlayStyle.dim;
                            font-size: 12px;
                        }
                    }

                    date-touch := TouchArea {
                        mouse-cursor: pointer;
                        accessible-role: button;
                        accessible-label: "Date";
                        clicked => {
                            date-picker.show();
                        }
                        changed has-hover => { root.date-hovered = self.has-hover; }
                    }
                }
            }
        }
    }

    Rectangle {
        x: root.width - self.width - 5px;
        y: 5px;
        width: 24px;
        height: 24px;
        border-radius: 7px;
        visible: root.open;
        background: pin-touch.has-hover ? OverlayStyle.faint : transparent;

        Path {
            width: 14px;
            height: 14px;
            viewbox-width: 14;
            viewbox-height: 14;
            commands: "M5 1.5H9L8.4 5.5L10.5 7.5H3.5L5.6 5.5ZM7 7.5V13";
            fill: root.pinned ? OverlayStyle.accent : transparent;
            stroke: root.pinned ? OverlayStyle.accent : pin-touch.has-hover ? OverlayStyle.fg : OverlayStyle.dim;
            stroke-width: 1.2px;
        }

        pin-touch := TouchArea {
            enabled: root.open;
            mouse-cursor: pointer;
            accessible-role: button;
            accessible-label: "Keep open";
            accessible-checked: root.pinned;
            clicked => { root.pinned = !root.pinned; }
        }
    }

    // Every speed in both directions, above the speed readout. On each side
    // the speeds stand flush right in a column as wide as the widest of
    // them and their meanings flush left after it, which hidden layouts
    // measure, and the side's heading is centered over it.
    if root.rates-open && root.open : rates-list := Rectangle {
        property <length> label-width: label-sizer.preferred-width;
        property <length> note-width: note-sizer.preferred-width;
        property <length> side: 8px + self.label-width + (self.note-width > 0 ? 8px + self.note-width : 0px) + 8px;

        x: speed-readout.x;
        y: -self.height - 8px;
        width: 6px + 2 * self.side + 4px + 6px;
        height: 12px + 18px + ceil(root.rates.length / 2) * 22px;
        border-radius: 10px;
        border-width: 1px;
        border-color: OverlayStyle.border;
        background: OverlayStyle.solid;
        drop-shadow-blur: 18px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: #00000080;

        TouchArea {
            changed has-hover => { root.rates-hovered = self.has-hover; }
        }

        Rectangle {
            visible: false;
            width: 0px;
            height: 0px;

            label-sizer := VerticalLayout {
                width: self.preferred-width;
                height: self.preferred-height;

                for choice in root.rates : Text {
                    text: choice.label;
                    font-size: 12px;
                }
            }

            note-sizer := VerticalLayout {
                width: self.preferred-width;
                height: self.preferred-height;

                for choice in root.rates : Text {
                    text: choice.note;
                    font-size: 11px;
                }
            }
        }

        for heading[side] in ["BACKWARD", "FORWARD"] : rates-heading := Text {
            x: 6px + side * (rates-list.side + 4px) + (rates-list.side - self.width) / 2;
            y: 6px;
            width: self.preferred-width;
            height: 18px;
            text: heading;
            color: OverlayStyle.dim;
            font-size: 10px;
            letter-spacing: 0.6px;
            vertical-alignment: center;
        }

        for choice[index] in root.rates : choice-row := Rectangle {
            property <bool> on: root.view.running && choice.rate == root.view.rate;
            x: 6px + mod(index, 2) * (rates-list.side + 4px);
            y: 6px + 18px + floor(index / 2) * 22px;
            width: rates-list.side;
            height: 22px;
            border-radius: 6px;
            background: self.on ? OverlayStyle.accent : choice-touch.has-hover ? OverlayStyle.faint : transparent;

            rate-label := Text {
                x: 8px + rates-list.label-width - self.width;
                width: self.preferred-width;
                text: choice.label;
                color: choice-row.on ? #04121b : OverlayStyle.fg;
                font-size: 12px;
                vertical-alignment: center;
            }

            rate-note := Text {
                x: 8px + rates-list.label-width + 8px;
                width: self.preferred-width;
                text: choice.note;
                color: choice-row.on ? #04121b : OverlayStyle.dim;
                font-size: 11px;
                vertical-alignment: center;
            }

            choice-touch := TouchArea {
                mouse-cursor: pointer;
                accessible-role: button;
                accessible-label: choice.label;
                clicked => {
                    root.rates-open = false;
                    root.rates-hovered = false;
                    root.rate-picked(choice.rate);
                }
                changed has-hover => { root.rates-hovered = self.has-hover; }
            }
        }
    }

    // A picker centered over the bar and kept 6 px inside the preview. One
    // wider than the preview stands against its right edge, which is the
    // window's, so it covers as little of the side bar as it can.
    pure function picker-x(width: length) -> length {
        let free = root.preview-width - width;
        if free >= 12px {
            return clamp((root.width - width) / 2, root.preview-left + 6px, root.preview-left + free - 6px);
        }
        if free >= 0 {
            return root.preview-left + free / 2;
        }
        root.preview-left + free
    }

    pure function picker-y(height: length) -> length {
        max(-height - 8px, root.preview-top + 6px)
    }

    // A click outside a picker closes it as Cancel does, since nothing
    // applies before OK.
    date-picker := DatePickerPopup {
        x: root.picker-x(self.width);
        y: root.picker-y(self.height);
        close-policy: PopupClosePolicy.close-on-click-outside;
        init => { root.date-picker-size = { width: self.width, height: self.height }; }
        title: "Date of the time setting";
        date: { year: root.view.year, month: root.view.month, day: root.view.day };
        accepted(date) => {
            root.exact-date(date.year, date.month, date.day);
        }
    }

    time-picker := TimePickerPopup {
        x: root.picker-x(self.width);
        y: root.picker-y(self.height);
        close-policy: PopupClosePolicy.close-on-click-outside;
        init => { root.time-picker-size = { width: self.width, height: self.height }; }
        title: "Time of the time setting";
        use-24-hour-format: true;
        time: { hour: root.view.hour, minute: root.view.minute, second: 0 };
        accepted(time) => {
            root.exact-time(time.hour, time.minute);
        }
    }
}
