import { Links } from "links.slint";

// System tray entry. A SystemTrayIcon is a top-level component with no window
// of its own, so it is instantiated alongside MainWindow rather than inside it.
// The `icon` is fed from Rust because it is generated procedurally rather than
// shipped as an asset.
export component TrayIcon inherits SystemTrayIcon {
    tooltip: "Sunlit Earth";
    // macOS draws the title as a label beside the icon in the menu bar; Linux
    // only hands it to accessibility tools and overflow lists.
    title: Platform.os == OperatingSystemType.macos ? "" : "Sunlit Earth";
    // Only properties declared here are exposed to Rust, so the inherited
    // `icon` is fed through one of our own.
    icon: root.tray-image;

    in property <image> tray-image;
    in-out property <bool> auto-refresh-enabled: false;
    // Start on login, as the last read of the platform's entry found it.
    in-out property <bool> autostart-on: false;
    in property <bool> autostart-available: true;
    // Whether the main window is on screen, which `window_state` reports.
    in property <bool> window-shown: false;

    // None of Slint 1.18's tray backends draws `checked`, so the state is in
    // the title. Slint rebuilds the menu when a property read while building
    // it changes, so the titles follow the state on every platform.
    out property <string> auto-refresh-title: (root.auto-refresh-enabled ? "✓ " : "") + "Auto-refresh";
    out property <string> autostart-title: (root.autostart-on ? "✓ " : "") + "Start on login";
    out property <string> window-title: root.window-shown ? "Hide" : "Show";

    callback toggle-window();
    callback refresh-now();
    callback auto-refresh-toggled(bool);
    callback autostart-toggled(bool);
    callback open-url(url: string);
    callback show-about();
    callback quit();

    // Left-click on the icon toggles the main window (Windows and Linux; on
    // macOS the attached menu takes precedence, which is why Show / Hide is
    // also a menu entry).
    clicked => { root.toggle-window(); }

    Menu {
        MenuItem {
            title: root.window-title;
            activated => { root.toggle-window(); }
        }
        MenuSeparator {}
        MenuItem {
            title: "Refresh Now";
            activated => { root.refresh-now(); }
        }
        MenuItem {
            title: root.auto-refresh-title;
            checkable: true;
            checked <=> root.auto-refresh-enabled;
            // `checked` is toggled by Slint before this fires, so it already
            // holds the new state.
            activated => { root.auto-refresh-toggled(root.auto-refresh-enabled); }
        }
        MenuItem {
            title: root.autostart-title;
            enabled: root.autostart-available;
            checkable: true;
            checked <=> root.autostart-on;
            activated => { root.autostart-toggled(root.autostart-on); }
        }
        MenuSeparator {}
        MenuItem {
            title: "Website";
            activated => { root.open-url(Links.website); }
        }
        MenuItem {
            title: "About";
            activated => { root.show-about(); }
        }
        MenuItem {
            title: "Quit";
            activated => { root.quit(); }
        }
    }
}
