import { Slider, ComboBox, CheckBox, Button, Palette } from "std-widgets.slint";

component Splitter inherits Rectangle {
    callback moved(length);

    width: 4px;
    background: touch.has-hover || touch.pressed ? Palette.accent-background : transparent;

    touch := TouchArea {
        width: 10px;
        x: -3px;
        mouse-cursor: ew-resize;

        moved => {
            root.moved(self.mouse-x - self.pressed-x);
        }
    }
}

export component MainWindow inherits Window {
    title: "Sunlit Earth — MVP";
    preferred-width: 1000px;
    preferred-height: 600px;

    in property <image> rendered-image;
    in property <string> renderer-info: "Initializing...";
    in property <[string]> aa-options: ["None", "MSAA 4\u{d7}"];
    in-out property <int> aa-index: 1;
    in property <[string]> texture-options: ["Grid", "Day", "Night", "Day/Night Blend"];
    in-out property <int> texture-index: 3;
    in property <string> loading-text;

    out property <float> camera-longitude: longitude-slider.value;
    out property <float> camera-latitude: latitude-slider.value;
    out property <float> camera-zoom: zoom-slider.value;
    out property <length> viewport-width: image-container.width;
    out property <length> viewport-height: image-container.height;
    out property <float> terminator-width: terminator-slider.value;
    out property <bool> diffuse-shading: diffuse-check.checked;
    out property <float> diffuse-floor: diffuse-floor-slider.value;
    out property <float> diffuse-ramp: diffuse-ramp-slider.value;

    in-out property <string> wallpaper-status;

    callback sliders-changed();
    callback msaa-changed();
    callback texture-changed();
    callback set-wallpaper();

    // Controls panel on the left
    Rectangle {
        x: 0;
        y: 0;
        width: splitter.x;
        height: root.height;
        background: Palette.background.darker(0.2);

            VerticalLayout {
                padding: 8px;
                spacing: 4px;
                alignment: start;

                HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: "Texture";
                        vertical-alignment: center;
                        min-width: 70px;
                    }
                    texture-combo := ComboBox {
                        model: texture-options;
                        current-index <=> root.texture-index;
                        max-height: 24px;
                        selected => { root.texture-changed(); }
                    }
                }

                HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: "Anti-Aliasing";
                        vertical-alignment: center;
                        min-width: 70px;
                    }
                    aa-combo := ComboBox {
                        model: aa-options;
                        current-index <=> root.aa-index;
                        max-height: 24px;
                        selected => { root.msaa-changed(); }
                    }
                }

                HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: "Longitude";
                        vertical-alignment: center;
                        min-width: 70px;
                    }
                    longitude-slider := Slider {
                        minimum: -180;
                        maximum: 180;
                        value: 0;
                        changed => { root.sliders-changed(); }
                    }
                    Text {
                        text: round(longitude-slider.value) + "\u{b0}";
                        vertical-alignment: center;
                        min-width: 35px;
                    }
                }

                HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: "Latitude";
                        vertical-alignment: center;
                        min-width: 70px;
                    }
                    latitude-slider := Slider {
                        minimum: -89;
                        maximum: 89;
                        value: 30;
                        changed => { root.sliders-changed(); }
                    }
                    Text {
                        text: round(latitude-slider.value) + "\u{b0}";
                        vertical-alignment: center;
                        min-width: 35px;
                    }
                }

                HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: "Zoom";
                        vertical-alignment: center;
                        min-width: 70px;
                    }
                    zoom-slider := Slider {
                        minimum: 2.0;
                        maximum: 50.0;
                        value: 8.0;
                        changed => { root.sliders-changed(); }
                    }
                    Text {
                        text: round(zoom-slider.value * 10) / 10;
                        vertical-alignment: center;
                        min-width: 35px;
                    }
                }

                HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: "Terminator";
                        vertical-alignment: center;
                        min-width: 70px;
                    }
                    terminator-slider := Slider {
                        minimum: 0.01;
                        maximum: 0.3;
                        value: 0.1;
                        changed => { root.sliders-changed(); }
                    }
                    Text {
                        text: round(terminator-slider.value * 1000) / 1000;
                        vertical-alignment: center;
                        min-width: 35px;
                    }
                }

                HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: "Diffuse";
                        vertical-alignment: center;
                        min-width: 70px;
                    }
                    diffuse-check := CheckBox {
                        text: "Dayside shading";
                        checked: true;
                        toggled => { root.sliders-changed(); }
                    }
                }

                HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: "  Floor";
                        vertical-alignment: center;
                        min-width: 70px;
                    }
                    diffuse-floor-slider := Slider {
                        minimum: 0.0;
                        maximum: 1.0;
                        value: 0.50;
                        changed => { root.sliders-changed(); }
                    }
                    Text {
                        text: round(diffuse-floor-slider.value * 100) / 100;
                        vertical-alignment: center;
                        min-width: 35px;
                    }
                }

                HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: "  Ramp";
                        vertical-alignment: center;
                        min-width: 70px;
                    }
                    diffuse-ramp-slider := Slider {
                        minimum: 0.1;
                        maximum: 1.0;
                        value: 0.25;
                        changed => { root.sliders-changed(); }
                    }
                    Text {
                        text: round(diffuse-ramp-slider.value * 100) / 100;
                        vertical-alignment: center;
                        min-width: 35px;
                    }
                }

                Rectangle { height: 8px; }

                Button {
                    text: "Set as Wallpaper";
                    clicked => { root.set-wallpaper(); }
                }

                Text {
                    text: wallpaper-status;
                    color: #888888;
                    font-size: 11px;
                    wrap: word-wrap;
                }

            }

        // Renderer info pinned to bottom
        Text {
            x: 8px;
            y: parent.height - self.height - 8px;
            text: renderer-info;
            color: #888888;
            font-size: 11px;
        }
    }

    splitter := Splitter {
        x: 300px;
        height: 100%;

        moved(delta) => {
            self.x = clamp(self.x + delta, 160px, root.width - 200px);
        }
    }

    // Image fills the area right of the splitter
    image-container := Rectangle {
        x: splitter.x + splitter.width;
        y: 0;
        width: root.width - self.x;
        height: root.height;
        background: black;

        Image {
            source: rendered-image;
            width: parent.width;
            height: parent.height;
            image-fit: contain;
        }

        if loading-text != "" : Rectangle {
            x: parent.width - loading-label.width - 16px;
            y: parent.height - loading-label.height - 12px;
            width: loading-label.width + 16px;
            height: loading-label.height + 8px;
            border-radius: 4px;
            background: #000000aa;

            loading-label := Text {
                x: 8px;
                y: 4px;
                text: loading-text;
                color: #cccccc;
                font-size: 12px;
            }
        }
    }
}
