import { Slider } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "Sunlit Earth — MVP";
    preferred-width: 800px;
    preferred-height: 650px;

    in property <image> rendered-image;
    in property <string> renderer-info: "Initializing...";

    out property <float> camera-longitude: longitude-slider.value;
    out property <float> camera-latitude: latitude-slider.value;
    out property <float> camera-zoom: zoom-slider.value;

    callback sliders-changed();

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        Rectangle {
            background: black;
            vertical-stretch: 1;

            Image {
                source: rendered-image;
                width: parent.width;
                height: parent.height;
                image-fit: contain;
            }
        }

        GridLayout {
            spacing: 6px;
            padding-top: 4px;
            padding-bottom: 4px;

            Row {
                Text {
                    text: "Longitude";
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    min-width: 80px;
                }
                longitude-slider := Slider {
                    minimum: -180;
                    maximum: 180;
                    value: 0;
                    changed => { root.sliders-changed(); }
                }
                Text {
                    text: round(longitude-slider.value) + "°";
                    vertical-alignment: center;
                    min-width: 50px;
                }
            }

            Row {
                Text {
                    text: "Latitude";
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    min-width: 80px;
                }
                latitude-slider := Slider {
                    minimum: -90;
                    maximum: 90;
                    value: 30;
                    changed => { root.sliders-changed(); }
                }
                Text {
                    text: round(latitude-slider.value) + "°";
                    vertical-alignment: center;
                    min-width: 50px;
                }
            }

            Row {
                Text {
                    text: "Zoom";
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    min-width: 80px;
                }
                zoom-slider := Slider {
                    minimum: 2.5;
                    maximum: 10.0;
                    value: 3.5;
                    changed => { root.sliders-changed(); }
                }
                Text {
                    text: round(zoom-slider.value * 10) / 10;
                    vertical-alignment: center;
                    min-width: 50px;
                }
            }
        }

        Text {
            text: renderer-info;
            color: #888888;
            font-size: 11px;
            horizontal-alignment: center;
        }
    }
}
