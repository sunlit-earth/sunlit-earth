import { Slider, ComboBox, CheckBox, Button, GroupBox, Palette, ScrollView } from "std-widgets.slint";

component Splitter inherits Rectangle {
    callback moved(length);

    width: 4px;
    background: touch.has-hover || touch.pressed ? Palette.accent-background : transparent;

    touch := TouchArea {
        width: 10px;
        x: -3px;
        mouse-cursor: ew-resize;

        moved => {
            root.moved(self.mouse-x - self.pressed-x);
        }
    }
}

export component MainWindow inherits Window {
    title: "Sunlit Earth — MVP";
    preferred-width: 1000px;
    preferred-height: 600px;

    in property <image> rendered-image;
    in property <string> renderer-info: "Initializing...";
    in property <[string]> aa-options: ["None", "MSAA 4\u{d7}"];
    in-out property <int> aa-index: 1;
    in property <[string]> texture-options: ["Grid", "Day", "Night", "Day/Night Blend"];
    in-out property <int> texture-index: 3;
    in property <string> loading-text;

    in-out property <float> camera-longitude: 0;
    in-out property <float> camera-latitude: 30;
    in-out property <float> camera-zoom: 0.421;
    in-out property <float> camera-offset-x: 0;
    in-out property <float> camera-offset-y: 0;
    in-out property <float> camera-tilt: 0;
    in-out property <float> camera-yaw: 0;
    in-out property <float> camera-pitch: 0;
    out property <length> viewport-width: image-container.width;
    out property <length> viewport-height: image-container.height;
    in-out property <float> terminator-width: 0.1;
    in-out property <bool> diffuse-shading: true;
    in-out property <float> diffuse-floor: 0.70;
    in-out property <float> diffuse-ramp: 0.20;
    in-out property <float> spec-shininess: 100;
    in-out property <float> spec-intensity: 0.17;
    in-out property <float> fresnel-mix: 0.75;
    in-out property <float> fresnel-exp: 4.0;
    in-out property <float> cloud-opacity: 0.85;
    in-out property <float> cloud-floor: 0.25;
    in-out property <float> cloud-gamma: 0.65;

    in property <float> zoom-display-distance: 8.0;
    in-out property <string> wallpaper-status;

    callback sliders-changed();
    callback msaa-changed();
    callback texture-changed();
    callback set-wallpaper();
    in-out property <bool> use-custom-datetime: false;
    in-out property <float> custom-hour: 12.0;
    in-out property <float> custom-day-of-year: 1.0;
    in-out property <int> custom-year-index: 10;
    in property <[string]> year-options;
    in property <string> hour-label: "12:00";
    in property <string> day-label: "Jan 1";
    in property <int> max-day-of-year: 365;

    callback mouse-drag(float, float);
    callback mouse-scroll(float);
    callback reset-all();

    // Controls panel on the left
    Rectangle {
        x: 0;
        y: 0;
        width: splitter.x;
        height: root.height;
        background: Palette.background.darker(0.2);

        ScrollView {
            horizontal-scrollbar-policy: always-off;
            width: parent.width;
            height: parent.height;

            VerticalLayout {
                width: parent.visible-width;
                padding: 8px;
                spacing: 4px;
                alignment: start;

                GroupBox {
                    title: "Rendering";
                    VerticalLayout {
                        spacing: 4px;

                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: "Texture";
                                vertical-alignment: center;
                                min-width: 70px;
                            }
                            texture-combo := ComboBox {
                                model: texture-options;
                                current-index <=> root.texture-index;
                                max-height: 24px;
                                selected => { root.texture-changed(); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: "Anti-Aliasing";
                                vertical-alignment: center;
                                min-width: 70px;
                            }
                            aa-combo := ComboBox {
                                model: aa-options;
                                current-index <=> root.aa-index;
                                max-height: 24px;
                                selected => { root.msaa-changed(); }
                            }
                        }
                    }
                }

                GroupBox {
                    title: "Camera Position";
                    VerticalLayout {
                        spacing: 4px;

                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: "Longitude";
                                vertical-alignment: center;
                                min-width: 70px;
                            }
                            longitude-slider := Slider {
                                minimum: -180;
                                maximum: 180;
                                value <=> root.camera-longitude;
                                changed => { root.sliders-changed(); }
                            }
                            Text {
                                text: round(root.camera-longitude) + "\u{b0}";
                                vertical-alignment: center;
                                min-width: 35px;
                            }
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: "Latitude";
                                vertical-alignment: center;
                                min-width: 70px;
                            }
                            latitude-slider := Slider {
                                minimum: -89;
                                maximum: 89;
                                value <=> root.camera-latitude;
                                changed => { root.sliders-changed(); }
                            }
                            Text {
                                text: round(root.camera-latitude) + "\u{b0}";
                                vertical-alignment: center;
                                min-width: 35px;
                            }
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: "Zoom";
                                vertical-alignment: center;
                                min-width: 70px;
                            }
                            zoom-slider := Slider {
                                minimum: 0.0;
                                maximum: 1.0;
                                value <=> root.camera-zoom;
                                changed => { root.sliders-changed(); }
                            }
                            Text {
                                text: round(root.zoom-display-distance * 10) / 10;
                                vertical-alignment: center;
                                min-width: 35px;
                            }
                        }
                    }
                }

                GroupBox {
                    title: "Camera Orientation";
                    VerticalLayout {
                        spacing: 4px;

                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: "Tilt";
                                vertical-alignment: center;
                                min-width: 70px;
                            }
                            tilt-slider := Slider {
                                minimum: -180;
                                maximum: 180;
                                value <=> root.camera-tilt;
                                changed => {
                                    if root.camera-tilt > -5 && root.camera-tilt < 5 {
                                        root.camera-tilt = 0;
                                    }
                                    root.sliders-changed();
                                }
                            }
                            Text {
                                text: round(root.camera-tilt) + "\u{b0}";
                                vertical-alignment: center;
                                min-width: 35px;
                            }
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: "Yaw";
                                vertical-alignment: center;
                                min-width: 70px;
                            }
                            yaw-slider := Slider {
                                minimum: -90;
                                maximum: 90;
                                value <=> root.camera-yaw;
                                changed => {
                                    if root.camera-yaw > -3 && root.camera-yaw < 3 {
                                        root.camera-yaw = 0;
                                    }
                                    root.sliders-changed();
                                }
                            }
                            Text {
                                text: round(root.camera-yaw) + "\u{b0}";
                                vertical-alignment: center;
                                min-width: 35px;
                            }
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: "Pitch";
                                vertical-alignment: center;
                                min-width: 70px;
                            }
                            pitch-slider := Slider {
                                minimum: -90;
                                maximum: 90;
                                value <=> root.camera-pitch;
                                changed => {
                                    if root.camera-pitch > -3 && root.camera-pitch < 3 {
                                        root.camera-pitch = 0;
                                    }
                                    root.sliders-changed();
                                }
                            }
                            Text {
                                text: round(root.camera-pitch) + "\u{b0}";
                                vertical-alignment: center;
                                min-width: 35px;
                            }
                        }
                    }
                }

                GroupBox {
                    title: "Framing";
                    VerticalLayout {
                        spacing: 4px;

                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: "Offset X";
                                vertical-alignment: center;
                                min-width: 70px;
                            }
                            offset-x-slider := Slider {
                                minimum: -1.0;
                                maximum: 1.0;
                                value <=> root.camera-offset-x;
                                changed => {
                                    if root.camera-offset-x > -0.05 && root.camera-offset-x < 0.05 {
                                        root.camera-offset-x = 0;
                                    }
                                    root.sliders-changed();
                                }
                            }
                            Text {
                                text: round(root.camera-offset-x * 100) / 100;
                                vertical-alignment: center;
                                min-width: 35px;
                            }
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: "Offset Y";
                                vertical-alignment: center;
                                min-width: 70px;
                            }
                            offset-y-slider := Slider {
                                minimum: -1.0;
                                maximum: 1.0;
                                value <=> root.camera-offset-y;
                                changed => {
                                    if root.camera-offset-y > -0.05 && root.camera-offset-y < 0.05 {
                                        root.camera-offset-y = 0;
                                    }
                                    root.sliders-changed();
                                }
                            }
                            Text {
                                text: round(root.camera-offset-y * 100) / 100;
                                vertical-alignment: center;
                                min-width: 35px;
                            }
                        }
                    }
                }

                GroupBox {
                    title: "Lighting";
                    VerticalLayout {
                        spacing: 4px;

                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: "Terminator";
                                vertical-alignment: center;
                                min-width: 70px;
                            }
                            terminator-slider := Slider {
                                minimum: 0.01;
                                maximum: 0.3;
                                value <=> root.terminator-width;
                                changed => { root.sliders-changed(); }
                            }
                            Text {
                                text: round(terminator-slider.value * 1000) / 1000;
                                vertical-alignment: center;
                                min-width: 35px;
                            }
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: "Diffuse";
                                vertical-alignment: center;
                                min-width: 70px;
                            }
                            diffuse-check := CheckBox {
                                text: "Dayside shading";
                                checked <=> root.diffuse-shading;
                                toggled => { root.sliders-changed(); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: "  Floor";
                                vertical-alignment: center;
                                min-width: 70px;
                            }
                            diffuse-floor-slider := Slider {
                                minimum: 0.0;
                                maximum: 1.0;
                                value <=> root.diffuse-floor;
                                changed => { root.sliders-changed(); }
                            }
                            Text {
                                text: round(diffuse-floor-slider.value * 100) / 100;
                                vertical-alignment: center;
                                min-width: 35px;
                            }
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: "  Ramp";
                                vertical-alignment: center;
                                min-width: 70px;
                            }
                            diffuse-ramp-slider := Slider {
                                minimum: 0.1;
                                maximum: 1.0;
                                value <=> root.diffuse-ramp;
                                changed => { root.sliders-changed(); }
                            }
                            Text {
                                text: round(diffuse-ramp-slider.value * 100) / 100;
                                vertical-alignment: center;
                                min-width: 35px;
                            }
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: "Shininess";
                                vertical-alignment: center;
                                min-width: 70px;
                            }
                            spec-shininess-slider := Slider {
                                minimum: 10;
                                maximum: 500;
                                value <=> root.spec-shininess;
                                changed => { root.sliders-changed(); }
                            }
                            Text {
                                text: round(spec-shininess-slider.value);
                                vertical-alignment: center;
                                min-width: 35px;
                            }
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: "Glint";
                                vertical-alignment: center;
                                min-width: 70px;
                            }
                            spec-intensity-slider := Slider {
                                minimum: 0.0;
                                maximum: 1.0;
                                value <=> root.spec-intensity;
                                changed => { root.sliders-changed(); }
                            }
                            Text {
                                text: round(spec-intensity-slider.value * 100) / 100;
                                vertical-alignment: center;
                                min-width: 35px;
                            }
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: "Fresnel Mix";
                                vertical-alignment: center;
                                min-width: 70px;
                            }
                            fresnel-mix-slider := Slider {
                                minimum: 0.0;
                                maximum: 1.0;
                                value <=> root.fresnel-mix;
                                changed => { root.sliders-changed(); }
                            }
                            Text {
                                text: round(fresnel-mix-slider.value * 100) / 100;
                                vertical-alignment: center;
                                min-width: 35px;
                            }
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: "Fresnel Extent";
                                vertical-alignment: center;
                                min-width: 70px;
                            }
                            fresnel-exp-slider := Slider {
                                minimum: 1.0;
                                maximum: 8.0;
                                value <=> root.fresnel-exp;
                                changed => { root.sliders-changed(); }
                            }
                            Text {
                                text: round(fresnel-exp-slider.value * 10) / 10;
                                vertical-alignment: center;
                                min-width: 35px;
                            }
                        }
                    }
                }

                GroupBox {
                    title: "Clouds";
                    VerticalLayout {
                        spacing: 4px;

                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: "Opacity";
                                vertical-alignment: center;
                                min-width: 70px;
                            }
                            cloud-opacity-slider := Slider {
                                minimum: 0.0;
                                maximum: 1.0;
                                value <=> root.cloud-opacity;
                                changed => { root.sliders-changed(); }
                            }
                            Text {
                                text: round(root.cloud-opacity * 100) + "%";
                                vertical-alignment: center;
                                min-width: 35px;
                            }
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: "Floor";
                                vertical-alignment: center;
                                min-width: 70px;
                            }
                            cloud-floor-slider := Slider {
                                minimum: 0.0;
                                maximum: 0.5;
                                value <=> root.cloud-floor;
                                changed => { root.sliders-changed(); }
                            }
                            Text {
                                text: round(root.cloud-floor * 100) + "%";
                                vertical-alignment: center;
                                min-width: 35px;
                            }
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: "Gamma";
                                vertical-alignment: center;
                                min-width: 70px;
                            }
                            cloud-gamma-slider := Slider {
                                minimum: 0.1;
                                maximum: 2.0;
                                value <=> root.cloud-gamma;
                                changed => { root.sliders-changed(); }
                            }
                            Text {
                                text: round(cloud-gamma-slider.value * 100) / 100;
                                vertical-alignment: center;
                                min-width: 35px;
                            }
                        }
                    }
                }

                GroupBox {
                    title: "Date / Time";
                    VerticalLayout {
                        spacing: 4px;

                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: "Custom";
                                vertical-alignment: center;
                                min-width: 70px;
                            }
                            CheckBox {
                                text: "Override date/time";
                                checked <=> root.use-custom-datetime;
                                toggled => {
                                    root.sliders-changed();
                                }
                            }
                        }

                        if root.use-custom-datetime :
                        VerticalLayout {
                            spacing: 4px;

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Hour";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                Slider {
                                    minimum: 0.0;
                                    maximum: 23.99;
                                    value <=> root.custom-hour;
                                    changed => { root.sliders-changed(); }
                                }
                                Text {
                                    text: root.hour-label;
                                    vertical-alignment: center;
                                    min-width: 45px;
                                }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Day";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                Slider {
                                    minimum: 1.0;
                                    maximum: root.max-day-of-year;
                                    value <=> root.custom-day-of-year;
                                    changed => { root.sliders-changed(); }
                                }
                                Text {
                                    text: root.day-label;
                                    vertical-alignment: center;
                                    min-width: 45px;
                                }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Year";
                                    vertical-alignment: center;
                                    min-width: 70px;
                                }
                                ComboBox {
                                    model: root.year-options;
                                    current-index <=> root.custom-year-index;
                                    max-height: 24px;
                                    selected => { root.sliders-changed(); }
                                }
                            }
                        }
                    }
                }

                Rectangle { height: 8px; }

                Button {
                    text: "Reset All";
                    clicked => { root.reset-all(); }
                }

                Button {
                    text: "Set as Wallpaper";
                    clicked => { root.set-wallpaper(); }
                }

                Text {
                    text: wallpaper-status;
                    color: #888888;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                Rectangle { height: 16px; }

                Text {
                    text: renderer-info;
                    color: #888888;
                    font-size: 11px;
                }
            }
        }
    }

    splitter := Splitter {
        x: 300px;
        height: 100%;

        moved(delta) => {
            self.x = clamp(self.x + delta, 160px, root.width - 200px);
        }
    }

    // Image fills the area right of the splitter
    image-container := Rectangle {
        x: splitter.x + splitter.width;
        y: 0;
        width: root.width - self.x;
        height: root.height;
        background: black;

        Image {
            source: rendered-image;
            width: parent.width;
            height: parent.height;
            image-fit: contain;
        }

        property <length> last-mouse-x;
        property <length> last-mouse-y;

        viewport-touch := TouchArea {
            width: parent.width;
            height: parent.height;

            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    image-container.last-mouse-x = self.mouse-x;
                    image-container.last-mouse-y = self.mouse-y;
                }
            }

            moved => {
                root.mouse-drag(
                    (self.mouse-x - image-container.last-mouse-x) / 1px,
                    (self.mouse-y - image-container.last-mouse-y) / 1px
                );
                image-container.last-mouse-x = self.mouse-x;
                image-container.last-mouse-y = self.mouse-y;
            }

            scroll-event(event) => {
                root.mouse-scroll(event.delta-y / 1px);
                return accept;
            }
        }

        if loading-text != "" : Rectangle {
            x: parent.width - loading-label.width - 16px;
            y: parent.height - loading-label.height - 12px;
            width: loading-label.width + 16px;
            height: loading-label.height + 8px;
            border-radius: 4px;
            background: #000000aa;

            loading-label := Text {
                x: 8px;
                y: 4px;
                text: loading-text;
                color: #cccccc;
                font-size: 12px;
            }
        }
    }
}
